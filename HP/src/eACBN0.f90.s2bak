!
!-----------------------------------------------------------------------
!
! (extended) ACBN0 evaluation of Hubbard parameters inside hp.x.
!
! hp.x normally obtains U (and V) by DENSITY-FUNCTIONAL PERTURBATION THEORY
! (the chi0 -> chi route of Cococcioni & de Gironcoli).  The routines in this
! file add a SECOND, INDEPENDENT estimator to the same driver: the
! pseudo-hybrid ACBN0 ratio of Agapito, Curtarolo & Buongiorno Nardelli
! [PRX 5, 011006 (2015)], as implemented in this fork's PW/src/new_ns_v.f90.
!
! Both estimators then read the *same* ground state produced by one pw.x run,
! with the same ortho-atomic projectors, which is the whole point: it makes
! U_ACBN0 and U_DFPT directly comparable without a second SCF.
!
! Controlled by the input variable  acbn0  in &INPUTHP:
!     acbn0 = 0   (default)  stock hp.x, DFPT only.  Nothing here runs.
!     acbn0 = 1              on-site U      -> ACBN0     (acbn0_type = 1)
!     acbn0 = 2              on-site U + V  -> eACBN0    (acbn0_type = 2)
!
! When acbn0 > 0 hp.x computes the Hubbard parameters, writes eACBN0_hub.dat,
! and stops before the perturbed-atom / DFPT loop (see HP/src/hp_main.f90).
!
! STAGING (see the session log): this file is being built in stages.
!   S1  driver only; the physics kernels are still the ones inside libpw.a
!       (PW/src/new_ns_v.f90), reached by a plain CALL.  This gives a
!       reference number that later stages must reproduce.
!   S2  the kernels get transplanted into THIS file and the CALL is switched.
!   S3  the transplanted kernels are converted from MODULE ldaV bookkeeping
!       to MODULE ldaU bookkeeping, so hp.x no longer needs an aCBN0 pw.x run.
!
!-----------------------------------------------------------------------
SUBROUTINE hp_acbn0()
  !---------------------------------------------------------------------
  !
  ! Driver.  Called from hp_main.f90 right after hp_summary(), i.e. after
  ! hp_readin() -> read_file() has restored the pw.x ground state and BEFORE
  ! the perturbed-atom loop rebuilds the k-point list with k+q.
  !
  ! State available at this point (all set up by read_file):
  !   evc / iunwfc  KS orbitals               (read_file_new.f90:43-54)
  !   wg            weights x occupations,
  !                 already poolscattered     (read_file_new.f90:123)
  !   nks,xk,ngk,igk_k,isk   pool-local       (divide_et_impera)
  !   vkb, tab_atwfc, rho    initialised      (post_xml_init)
  !   MODULE ldaV   fully initialised, and wfcv allocated, PROVIDED the XML
  !                 carries an <ehub> block  (qexsd_copy.f90:570,
  !                 read_file_new.f90:325, allocate_wfc.f90:41)
  !
  ! What is NOT set up, and is done here:
  !   d1,d2,d3      read_file only calls d_matrix under okpaw
  !                 (read_file_new.f90:348-351).  With norm-conserving
  !                 pseudos okpaw is .false., so the Wigner d-matrices used
  !                 by symmetrize_n4 would otherwise be garbage.
  !   iunhubv       the projector buffer; opened by openfil.f90:62 in pw.x,
  !                 which hp.x never calls.
  !   wfcv          allocated but empty; filled here by orthowfcv().
  !
  USE kinds,            ONLY : DP
  USE io_global,        ONLY : stdout
  USE io_files,         ONLY : iunhubv, nwordwfcv, iunwfc, nwordwfc
  USE buffers,          ONLY : open_buffer, close_buffer
  USE ions_base,        ONLY : nat
  USE lsda_mod,         ONLY : nspin
  USE wvfct,            ONLY : npwx, nbnd
  USE control_flags,    ONLY : io_level
  USE noncollin_module, ONLY : noncolin, npol
  USE symm_base,        ONLY : d1, d2, d3
  USE ldaV,             ONLY : lda_plus_v, lacbn0, acbn0_type, ehub_lm_max, &
                               ehub_u, ehub_mixing, nwfcv,               &
                               remove_ehub_u, remove_ehub_v
  USE ldaU_hp,          ONLY : acbn0
  !
  IMPLICIT NONE
  !
  REAL(DP), ALLOCATABLE :: ns(:,:,:,:)   ! occupation matrix, = rho%na0 in pw.x
  LOGICAL               :: exst
  !
  CALL start_clock('hp_acbn0')
  !
  WRITE( stdout, '(/5x,70("="))')
  WRITE( stdout, '(/5x,"ACBN0 calculation of Hubbard parameters")')
  IF ( acbn0 == 1 ) THEN
     WRITE( stdout, '(5x,"acbn0 = 1 : on-site U only")')
  ELSE
     WRITE( stdout, '(5x,"acbn0 = 2 : on-site U + intersite V")')
  ENDIF
  WRITE( stdout, '(5x,"Reference : Agapito, Curtarolo & Buongiorno Nardelli,")')
  WRITE( stdout, '(5x,"            Phys. Rev. X 5, 011006 (2015)")')
  WRITE( stdout, '(5x,70("="),/)')
  !
  CALL hp_acbn0_check()
  !
  ! One-shot post-processing: there is no SCF history to mix against, so the
  ! ACBN0 kernels must return the raw functional of the wavefunctions we just
  ! read.  ehub_mixing defaults to 0.7 in the fork; leaving it there would
  ! silently return  0.3*U_from_XML + 0.7*U_computed.
  !
  ehub_mixing = 1.0_DP
  !
  ! remove_ehub_u / remove_ehub_v have NO initialiser in MODULE ldaV
  ! (ldaV.f90:46-47) and are assigned ONLY in PW/src/input.f90:2083-2086
  ! (dftU_iosys_v1) - which is pw.x's INPUT path.  hp.x never executes it, and
  ! qexsd_copy does not round-trip them through the XML.  So in hp.x they are
  ! undefined, and new_ns_a0 multiplies the final U by remove_ehub_u TWICE:
  !     ehub_u_(na,m1,m2) = (A0/HF - J-term) * remove_ehub_u(nt,l(m1))
  !                                          * remove_ehub_u(nt,l(m2))
  ! Left undefined that silently scales, or zeroes, every Hubbard parameter.
  ! 1 is the pw.x default (read_namelists.f90:248-249) = "keep this channel".
  !
  remove_ehub_u(:,:) = 1
  remove_ehub_v(:,:) = 1
  !
  ! ehub_u may already be allocated: qexsd_copy.f90:586 allocates it while
  ! reading the XML, using the ehub_lm_max STORED there.  init_lda_plus_v then
  ! RECOMPUTES ehub_lm_max from the pseudopotentials.  If the two ever
  ! disagree (different PP, edited ehub_l_choice) new_ns_a0 writes out of
  ! bounds, silently.  Re-shape rather than trust it.
  !
  IF ( ALLOCATED(ehub_u) ) THEN
     IF ( SIZE(ehub_u,1) /= nat          .OR. &
          SIZE(ehub_u,2) /= ehub_lm_max  .OR. &
          SIZE(ehub_u,3) /= ehub_lm_max ) DEALLOCATE( ehub_u )
  ENDIF
  IF ( .NOT.ALLOCATED(ehub_u) ) ALLOCATE( ehub_u(nat,ehub_lm_max,ehub_lm_max) )
  ehub_u(:,:,:) = 0.0_DP
  !
  ! Wigner d-matrices for the symmetrisation of the occupation matrix.
  ! See the note in the header: read_file does not do this for us.
  !
  CALL d_matrix( d1, d2, d3 )
  !
  ! Re-open the KS orbital buffer.
  !
  ! read_file() reads the collected wavefunctions, save_buffer's them to
  ! iunwfc, and then CLOSES that unit again (read_file_new.f90:62,
  ! close_buffer(iunwfc,'KEEP')).  'KEEP' preserves the FILES but
  ! close_buffer also calls buiol_close_unit, which DEREGISTERS the unit from
  ! the buffer list.  get_buffer then finds no buffer entry, falls through to
  ! its ELSE branch, and calls davcio on a closed unit:
  !     Error in routine davcio (10): unit is not opened
  ! Stock hp.x never trips this because it reads wavefunctions through iuwfc
  ! (units_lr), opened much later in hp_openfil_q.  new_ns_a0 reads iunwfc.
  !
  ! Same three lines read_file uses, so the record length matches byte for byte.
  !
  nwordwfc = nbnd * npwx * npol
  CALL open_buffer( iunwfc, 'wfc', nwordwfc, io_level, exst )
  IF ( io_level /= 0 .AND. .NOT.exst ) CALL errore( 'hp_acbn0', &
     'the KS wavefunction files (prefix.wfc*) are missing from outdir - &
     &rerun pw.x, or set disk_io to at least "low"', 1 )
  !
  ! Projector buffer.  Record length and unit exactly as pw.x sets them in
  ! PW/src/openfil.f90:54,62 - keep these two lines in sync with that file.
  !
  nwordwfcv = npwx * nwfcv * npol
  CALL open_buffer( iunhubv, 'hubv', nwordwfcv, io_level, exst )
  !
  ! Fill wfcv = O^{-1/2} S phi  on the Hubbard manifold, for every k point,
  ! and buffer it.  PW/src/orthoatwfc_v.f90; forces Hubbard_projectors to
  ! 'ortho-atomic' internally.
  !
  CALL orthowfcv()
  !
  ALLOCATE( ns(ehub_lm_max,ehub_lm_max,nspin,nat) )
  ns(:,:,:,:) = 0.0_DP
  !
  IF ( acbn0 == 1 ) THEN
     !
     ! S2: local copy of the on-site ACBN0 kernel (below).  S1 called
     !     libpw.a's new_ns_a0 here and gave 9.2501 / 9.2509 / 4.2471 eV.
     !
     CALL hp_acbn0_ns_a0( ns )
     !
  ELSE
     !
     CALL errore( 'hp_acbn0', 'acbn0 = 2 (U+V) is not implemented yet - &
                  &that is stage S4.  Use acbn0 = 1.', 1 )
     !
  ENDIF
  !
  CALL hp_acbn0_write( ns )
  !
  DEALLOCATE( ns )
  CALL close_buffer( iunhubv, 'delete' )   ! ours, scratch
  CALL close_buffer( iunwfc,  'KEEP'   )   ! the user's wavefunctions - NEVER delete
  !
  CALL stop_clock('hp_acbn0')
  !
  RETURN
  !
END SUBROUTINE hp_acbn0
!
!-----------------------------------------------------------------------
SUBROUTINE hp_acbn0_check()
  !---------------------------------------------------------------------
  !
  ! Everything the ACBN0 kernels silently assume.  Each of these fails as a
  ! wrong number rather than a crash if it is not caught here.
  !
  USE io_global,        ONLY : stdout
  USE lsda_mod,         ONLY : nspin
  USE control_flags,    ONLY : gamma_only
  USE ldaU,             ONLY : Hubbard_projectors
  USE ldaV,             ONLY : lda_plus_v, lacbn0, acbn0_type, ehub_lm_max
  USE ldaU_hp,          ONLY : acbn0
  !
  IMPLICIT NONE
  !
  IF ( .NOT.lda_plus_v ) CALL errore( 'hp_acbn0_check', &
     'acbn0 > 0 needs a pw.x run made with lacbn0 = .true. (stages S1/S2): &
     &no <ehub> block was found in the XML, so MODULE ldaV is uninitialised.', 1 )
  !
  IF ( .NOT.lacbn0 ) CALL errore( 'hp_acbn0_check', &
     'the pw.x run set lda_plus_v but not lacbn0; the ACBN0 bookkeeping &
     &(ehub_l, ehub_lm, ofstv) is present but was never used. Rerun pw.x &
     &with lacbn0 = .true.', 1 )
  !
  IF ( ehub_lm_max <= 0 ) CALL errore( 'hp_acbn0_check', &
     'ehub_lm_max <= 0 : no Hubbard manifold was selected. Check &
     &ehub_l_choice in the pw.x input.', 1 )
  !
  ! nspin: init_lda_plus_v already rejects nspin = 1, but new_ns_a0 also
  ! hard-codes spin indices 1 and 2 in its A0/HF accumulators, so state it.
  !
  IF ( nspin /= 2 ) CALL errore( 'hp_acbn0_check', &
     'ACBN0 in hp.x is implemented for collinear spin-polarised only &
     &(nspin = 2).', 1 )
  !
  IF ( gamma_only ) CALL errore( 'hp_acbn0_check', &
     'gamma_only is not supported by the ACBN0 kernels', 1 )
  !
  ! acbn0 (this run) vs acbn0_type (what pw.x was run with).  They need not
  ! agree - we recompute from scratch - but a mismatch is worth flagging,
  ! because the U/V read from the XML were produced with the other one.
  !
  IF ( acbn0 /= acbn0_type ) &
     WRITE( stdout, '(5x,"WARNING: acbn0 = ",i1," but the pw.x run used &
            &acbn0_type = ",i1,".")') acbn0, acbn0_type
  !
  ! orthowfcv() will force this, but say so before it happens silently.
  !
  IF ( TRIM(Hubbard_projectors) /= 'ortho-atomic' ) &
     WRITE( stdout, '(5x,"WARNING: Hubbard_projectors = ",a,"; the ACBN0 &
            &kernels use ortho-atomic projectors and will override it.")') &
            TRIM(Hubbard_projectors)
  !
  RETURN
  !
END SUBROUTINE hp_acbn0_check
!
!-----------------------------------------------------------------------
SUBROUTINE hp_acbn0_write( ns )
  !---------------------------------------------------------------------
  !
  ! Write the ACBN0 Hubbard parameters to eACBN0_hub.dat (and to stdout).
  !
  ! Note on the "scalar U" column: ehub_u(na,m1,m2) is an (m1,m2) matrix, but
  ! new_ns_v.f90 builds it as
  !     ehub_u_(na,m1,m2) = A0%U(l(m1),l(m2),na)/HF%U(l(m1),l(m2),na) - J-term
  ! i.e. it depends on m1,m2 ONLY through their l channel.  For an atom with a
  ! single Hubbard channel (the usual case: Ni-3d, O-2p) every element is
  ! therefore the same number, and that number is the scalar U to compare
  ! against the DFPT value in prefix.Hubbard_parameters.dat.  The full matrix
  ! is printed too, because it stops being constant as soon as a type carries
  ! more than one channel via ehub_l_choice.
  !
  USE kinds,      ONLY : DP
  USE constants,  ONLY : rytoev
  USE io_global,  ONLY : stdout, ionode
  USE io_files,   ONLY : prefix
  USE ions_base,  ONLY : nat, ityp, atm, ntyp => nsp
  USE lsda_mod,   ONLY : nspin
  USE ldaV,       ONLY : ehub_lm, ehub_lm_max, ehub_l, ehub_u, acbn0_type
  !
  IMPLICIT NONE
  !
  REAL(DP), INTENT(IN) :: ns(ehub_lm_max,ehub_lm_max,nspin,nat)
  !
  INTEGER              :: na, nt, m1, m2, is, iunit
  REAL(DP)             :: utr, occ
  LOGICAL              :: uniform
  CHARACTER(LEN=1)     :: spdf(4) = ['s','p','d','f']
  CHARACTER(LEN=256)   :: filename
  !
  INTEGER, EXTERNAL    :: find_free_unit
  !
  IF ( .NOT.ionode ) RETURN
  !
  filename = 'eACBN0_hub.dat'
  iunit = find_free_unit()
  OPEN( iunit, file = TRIM(filename), form = 'formatted', status = 'unknown' )
  !
  WRITE( iunit, '(/2x,79("="))')
  WRITE( iunit, '(/25x,"Hubbard parameters from ACBN0")')
  WRITE( iunit, '(/22x,"computed by hp.x  (acbn0 = ",i1,")")') acbn0_type
  WRITE( iunit, '(/2x,79("="),/)')
  WRITE( iunit, '(2x,"prefix     : ",a)') TRIM(prefix)
  WRITE( iunit, '(2x,"projectors : ortho-atomic")')
  WRITE( iunit, '(2x,"mixing     : 1.000  (one-shot; no SCF history)")')
  WRITE( iunit, '(2x,"estimator  : pseudo-hybrid ACBN0 ratio, NOT linear response")')
  WRITE( iunit, '(/2x,79("-"))')
  WRITE( iunit, '(2x,"Summary")')
  WRITE( iunit, '(2x,79("-"))')
  WRITE( iunit, '(/4x,"site n.  type  label   manifold   occupation   U_ACBN0 (eV)")')
  !
  DO na = 1, nat
     nt = ityp(na)
     IF ( ehub_lm(nt) == 0 ) CYCLE
     !
     ! trace of the occupation matrix, summed over spin
     occ = 0.0_DP
     DO is = 1, nspin
        DO m1 = 1, ehub_lm(nt)
           occ = occ + ns(m1,m1,is,na)
        ENDDO
     ENDDO
     !
     ! is the U matrix constant?  (see the header note)
     uniform = .TRUE.
     DO m1 = 1, ehub_lm(nt)
        DO m2 = 1, ehub_lm(nt)
           IF ( ABS(ehub_u(na,m1,m2) - ehub_u(na,1,1)) > 1.0D-8 ) uniform = .FALSE.
        ENDDO
     ENDDO
     !
     utr = ehub_u(na,1,1) * rytoev
     !
     IF ( uniform ) THEN
        WRITE( iunit, '(6x,i3,4x,i3,3x,a6,5x,a1,7x,f9.4,4x,f10.4)') &
              na, nt, TRIM(atm(nt)), spdf(ehub_l(1,nt)), occ, utr
     ELSE
        WRITE( iunit, '(6x,i3,4x,i3,3x,a6,5x,a1,7x,f9.4,4x,f10.4,3x,a)') &
              na, nt, TRIM(atm(nt)), spdf(ehub_l(1,nt)), occ, utr, &
              '<- matrix NOT uniform, see below'
     ENDIF
     !
  ENDDO
  !
  WRITE( iunit, '(/2x,79("-"))')
  WRITE( iunit, '(2x,"Full U matrix  U[na, m1, m2]  (eV)")')
  WRITE( iunit, '(2x,79("-"))')
  !
  DO na = 1, nat
     nt = ityp(na)
     IF ( ehub_lm(nt) == 0 ) CYCLE
     WRITE( iunit, '(/4x,"atom ",i3,"  type ",a,"   (",i2," x",i2,")")') &
           na, TRIM(atm(nt)), ehub_lm(nt), ehub_lm(nt)
     DO m1 = 1, ehub_lm(nt)
        WRITE( iunit, '(6x,16f10.4)') (ehub_u(na,m1,m2)*rytoev, m2 = 1, ehub_lm(nt))
     ENDDO
  ENDDO
  !
  WRITE( iunit, '(/2x,79("-"))')
  WRITE( iunit, '(2x,"Occupation matrix  ns[na, m1, m2, spin]")')
  WRITE( iunit, '(2x,79("-"))')
  !
  DO na = 1, nat
     nt = ityp(na)
     IF ( ehub_lm(nt) == 0 ) CYCLE
     DO is = 1, nspin
        WRITE( iunit, '(/4x,"atom ",i3,"  type ",a,"  spin ",i1)') na, TRIM(atm(nt)), is
        DO m1 = 1, ehub_lm(nt)
           WRITE( iunit, '(6x,16f10.4)') (ns(m1,m2,is,na), m2 = 1, ehub_lm(nt))
        ENDDO
     ENDDO
  ENDDO
  !
  WRITE( iunit, '(/2x,79("="),/)')
  CLOSE( iunit )
  !
  WRITE( stdout, '(/5x,"ACBN0 Hubbard parameters written to ",a,/)') TRIM(filename)
  !
  ! Echo the summary to stdout as well, so it is greppable from the job output.
  !
  WRITE( stdout, '(5x,"site n.  type  label   manifold   U_ACBN0 (eV)")')
  DO na = 1, nat
     nt = ityp(na)
     IF ( ehub_lm(nt) == 0 ) CYCLE
     WRITE( stdout, '(7x,i3,4x,i3,3x,a6,5x,a1,8x,f10.4)') &
           na, nt, TRIM(atm(nt)), spdf(ehub_l(1,nt)), ehub_u(na,1,1)*rytoev
  ENDDO
  WRITE( stdout, * )
  !
  RETURN
  !
END SUBROUTINE hp_acbn0_write
!
!-----------------------------------------------------------------------
!  S2 - transplanted ACBN0 kernels
!-----------------------------------------------------------------------
! Provenance - verbatim from PW/src/new_ns_v.f90 unless noted:
!     hp_acbn0_ns_a0    <- new_ns_a0      lines  233- 633
!     hp_acbn0_symm_n4  <- symmetrize_n4  lines 2964-3165  (+1 bugfix, marked)
!     hp_acbn0_orberi   <- orberi         lines 3780-3818
!
! Still USE ldaV: that is deliberate.  S2 proves the transplant is faithful;
! S3 converts the bookkeeping to ldaU.  Doing both at once would make any
! discrepancy unattributable.
!
! These stay BARE EXTERNAL SUBROUTINES, never module procedures.  new_ns_a0
! and symmetrize_n4 each declare their own local TYPE occmat_4 and pass it
! across - legal only because an external subroutine has no explicit
! interface.  Wrapping them in a MODULE turns that into a hard type error.
!
! CALL write_ehub_uv is retained: it prints the same stdout table pw.x does,
! which is what makes S0/S1/S2 comparable by grep.  It goes away in S3.
!-----------------------------------------------------------------------
!
SUBROUTINE hp_acbn0_ns_a0(ns)

  USE kinds,                ONLY : DP
  USE constants,            ONLY : rytoev
  USE ions_base,            ONLY : nat, ityp, ntyp => nsp, tau
  USE cell_base,            ONLY : at, alat
  USE klist,                ONLY : nks, ngk, xk
  USE ldaV,                 ONLY : ehub_lm_max, ehub_lm, ehub_l, &
                                   ehub_mixing, ehub_u, wfcv,    &
                                   nwfcv, ofstv, remove_ehub_u,  &
                                   write_ehub_uv
  USE lsda_mod,             ONLY : lsda, current_spin, nspin, isk
  USE wvfct,                ONLY : nbnd, wg
  USE io_global,            ONLY : stdout
  USE control_flags,        ONLY : gamma_only
  USE wavefunctions,        ONLY : evc
  USE io_files,             ONLY : nwordwfc, iunwfc, nwordwfcv, iunhubv
  USE buffers,              ONLY : get_buffer
  USE mp_pools,             ONLY : inter_pool_comm
  USE mp,                   ONLY : mp_sum
  USE becmod,               ONLY : bec_type, calbec,  &
                                   allocate_bec_type, &
                                   deallocate_bec_type
  USE uspp_param,           ONLY : upf

  IMPLICIT NONE

  REAL(DP),    INTENT(OUT) :: ns(ehub_lm_max,ehub_lm_max,nspin,nat)

  TYPE hubbard_ene_3
     REAL(DP), ALLOCATABLE :: U(:,:,:)
     REAL(DP), ALLOCATABLE :: J(:,:,:)
  END TYPE hubbard_ene_3

  TYPE occmat_4
     REAL(DP), ALLOCATABLE :: O(:,:,:,:)
     REAL(DP), ALLOCATABLE :: T(:,:,:,:)
  END TYPE occmat_4

  TYPE(bec_type)           :: proj

  TYPE(hubbard_ene_3)      :: A0, HF

  TYPE(occmat_4)           :: num(nbnd), n, p

  REAL(DP),    ALLOCATABLE :: ehub_u_(:,:,:)

  REAL(DP), EXTERNAL       :: compute_eri
  REAL(DP)                 :: c1(6), c2(6), c3(6), c4(6)

  INTEGER                  :: i, ik, ibnd, is, npw
  INTEGER                  :: na, nt, l, m
  INTEGER                  :: na1, na2
  INTEGER                  :: nt1, nt2
  INTEGER                  :: m1, m2, m3, m4
  INTEGER                  :: l1, l2, l3, l4

  CALL start_clock('acbn0_ns_a0')
  !
  CALL allocate_bec_type(nwfcv, nbnd, proj)
  !
  ALLOCATE ( n%O(ehub_lm_max,ehub_lm_max,nspin,nat) ) ; n%O = 0.0_DP
  ALLOCATE ( p%O(ehub_lm_max,ehub_lm_max,nspin,nat) ) ; p%O = 0.0_DP
  ALLOCATE ( A0%U(4,4,nat), A0%J(4,4,nat) )
  ALLOCATE ( HF%U(4,4,nat), HF%J(4,4,nat) )
  !
  DO ik = 1, nks
     !
     IF ( lsda ) current_spin = isk(ik)
     npw = ngk(ik)
     !
     ! projection < wfcv | evc >
     !
     IF ( nks > 1 ) CALL get_buffer(evc, nwordwfc, iunwfc, ik)
     IF ( nks > 1 ) CALL get_buffer(wfcv, nwordwfcv, iunhubv, ik)
     CALL calbec(npw, wfcv, evc, proj)
     !
     ! calculate the occupation matrices n
     !
     DO na = 1, nat
        nt = ityp(na)
        !
        IF ( ehub_lm(nt) == 0 ) CYCLE
        !
        DO m1 = 1, ehub_lm(nt)
        DO m2 = 1, ehub_lm(nt)
           !
           IF ( gamma_only ) THEN
              DO ibnd = 1, nbnd
                 n%O(m1,m2,current_spin,na) = &
                 n%O(m1,m2,current_spin,na) + &
                                wg(ibnd,ik) * &
                  proj%r(ofstv(na)+m2,ibnd) * &
                  proj%r(ofstv(na)+m1,ibnd)
              ENDDO ! ibnd
           ELSE
              DO ibnd = 1, nbnd
                 n%O(m1,m2,current_spin,na) = &
                 n%O(m1,m2,current_spin,na) + &
                                wg(ibnd,ik) * &
             DBLE(proj%k(ofstv(na)+m2,ibnd) * &
            CONJG(proj%k(ofstv(na)+m1,ibnd)))
              ENDDO ! ibnd
           ENDIF
           !
        ENDDO ! m2
        ENDDO ! m1
        !
     ENDDO ! na
     !
     ! calculate the renormalized occupations N(ACBN0)
     !
     DO i = 1, nbnd
        ALLOCATE ( num(i)%O(4,4,nspin,ntyp) ) ; num(i)%O = 0.0_DP
        ALLOCATE ( num(i)%T(4,4,nspin,ntyp) ) ; num(i)%T = 0.0_DP
     ENDDO
     !
     DO na = 1, nat
        nt = ityp(na)
        !
        IF ( ehub_lm(nt) == 0 ) CYCLE
        !
        DO m = 1, ehub_lm(nt)
           !
           l = ehub_l(m,nt)
           !
           IF ( gamma_only ) THEN
              DO ibnd = 1, nbnd
                 num(ibnd)%O(l,l,current_spin,nt) = &
                 num(ibnd)%O(l,l,current_spin,nt) + &
                         proj%r(ofstv(na)+m,ibnd) * &
                         proj%r(ofstv(na)+m,ibnd)
              ENDDO ! ibnd
           ELSE
              DO ibnd = 1, nbnd
                 num(ibnd)%O(l,l,current_spin,nt) = &
                 num(ibnd)%O(l,l,current_spin,nt) + &
                    DBLE(proj%k(ofstv(na)+m,ibnd) * &
                   CONJG(proj%k(ofstv(na)+m,ibnd)))
              ENDDO ! ibnd
           ENDIF
           !
        ENDDO ! m
        !
     ENDDO ! na
     !
     DO i = 1, nbnd
        !
        DO nt1 = 1, ntyp
        DO nt2 = 1, ntyp
           !
           IF ( upf(nt1)%psd /= upf(nt2)%psd ) CYCLE
           !
           num(i)%T(:,:,:,nt1) = num(i)%T(:,:,:,nt1) &
                               + num(i)%O(:,:,:,nt2)
           !
        ENDDO ! na2
        ENDDO ! na1
        !
     ENDDO ! i
     !
     DO i = 1, nbnd
        num(i)%O = num(i)%T
        DEALLOCATE ( num(i)%T )
     ENDDO
     !
     ! calculate the renormalized occupation matrices P(ACBN0)
     !
     DO na = 1, nat
        nt = ityp(na)
        !
        IF ( ehub_lm(nt) == 0 ) CYCLE
        !
        DO m1 = 1, ehub_lm(nt)
           !
           l1 = ehub_l(m1,nt)
           !
        DO m2 = 1, ehub_lm(nt)
           !
           l2 = ehub_l(m2,nt)
           !
           IF ( gamma_only ) THEN
              DO ibnd = 1, nbnd
                 p%O(m1,m2,current_spin,na) = &
                 p%O(m1,m2,current_spin,na) + &
                         num(ibnd)%O(l1,l2,   &
                           current_spin,nt) * &
                                wg(ibnd,ik) * &
                  proj%r(ofstv(na)+m2,ibnd) * &
                  proj%r(ofstv(na)+m1,ibnd)
              ENDDO ! ibnd
           ELSE
              DO ibnd = 1, nbnd
                 p%O(m1,m2,current_spin,na) = &
                 p%O(m1,m2,current_spin,na) + &
                         num(ibnd)%O(l1,l2,   &
                           current_spin,nt) * &
                                wg(ibnd,ik) * &
             DBLE(proj%k(ofstv(na)+m2,ibnd) * &
            CONJG(proj%k(ofstv(na)+m1,ibnd)))
              ENDDO ! ibnd
           ENDIF
           !
        ENDDO ! m2
        ENDDO ! m1
        !
     ENDDO ! na
     !
     DO i = 1, nbnd
        DEALLOCATE ( num(i)%O )
     ENDDO

  ENDDO ! ik

  CALL deallocate_bec_type(proj)

  CALL mp_sum(n%O, inter_pool_comm)
  CALL mp_sum(p%O, inter_pool_comm)

  IF ( nspin == 1 ) n%O = 0.5_DP * n%O
  !
  CALL hp_acbn0_symm_n4(n)
  !
  ns = 0.0_DP
  !
  ns = n%O
  !
  DEALLOCATE (n%O)
  !
  IF ( nspin == 1 ) p%O = 0.5_DP * p%O
  !
  CALL hp_acbn0_symm_n4(p)
  !
  ! calculate ACBN0 U & J
  !
  A0%U = 0.0_DP ; A0%J = 0.0_DP
  !
  DO na = 1, nat
     nt = ityp(na)
     !
     IF ( ehub_lm(nt) == 0 ) CYCLE
     !
     l1 = 0
     DO m1 = 1, ehub_lm(nt)
        CALL hp_acbn0_orberi(ehub_l(m1,nt), l1)
        CALL pao_3g(upf(nt)%psd, ehub_l(m1,nt), c1)
        !
     l2 = 0
     DO m2 = 1, ehub_lm(nt)
        CALL hp_acbn0_orberi(ehub_l(m2,nt), l2)
        CALL pao_3g(upf(nt)%psd, ehub_l(m2,nt), c2)
        !
     l3 = 0
     DO m3 = 1, ehub_lm(nt)
        IF ( ehub_l(m3,nt) /= ehub_l(m1,nt) ) CYCLE
        CALL hp_acbn0_orberi(ehub_l(m3,nt), l3)
        CALL pao_3g(upf(nt)%psd, ehub_l(m3,nt), c3)
        !
     l4 = 0
     DO m4 = 1, ehub_lm(nt)
        IF ( ehub_l(m4,nt) /= ehub_l(m2,nt) ) CYCLE
        CALL hp_acbn0_orberi(ehub_l(m4,nt), l4)
        CALL pao_3g(upf(nt)%psd, ehub_l(m4,nt), c4)
        !
        IF ( ehub_l(m1,nt) == 1 .AND. ehub_l(m2,nt) == 1 ) THEN
              A0%U(ehub_l(m1,nt),ehub_l(m2,nt),na)  = &
              A0%U(ehub_l(m1,nt),ehub_l(m2,nt),na)  + &
                  (p%O(m3,m1,1,na)*p%O(m4,m2,2,na)  + &
                   p%O(m3,m1,2,na)*p%O(m4,m2,1,na)) * &
                          compute_eri(l3,l1,l4,l2,    &
                    tau(:,na)*alat,tau(:,na)*alat,    &
                    tau(:,na)*alat,tau(:,na)*alat,    &
                                      c3,c1,c4,c2)
        ELSE
              A0%U(ehub_l(m1,nt),ehub_l(m2,nt),na)  = &
              A0%U(ehub_l(m1,nt),ehub_l(m2,nt),na)  + &
                  (p%O(m3,m1,1,na)*p%O(m4,m2,1,na)  + &
                   p%O(m3,m1,2,na)*p%O(m4,m2,2,na)  + &
                   p%O(m3,m1,1,na)*p%O(m4,m2,2,na)  + &
                   p%O(m3,m1,2,na)*p%O(m4,m2,1,na)) * &
                          compute_eri(l3,l1,l4,l2,    &
                    tau(:,na)*alat,tau(:,na)*alat,    &
                    tau(:,na)*alat,tau(:,na)*alat,    &
                                      c3,c1,c4,c2)
              A0%J(ehub_l(m1,nt),ehub_l(m2,nt),na)  = &
              A0%J(ehub_l(m1,nt),ehub_l(m2,nt),na)  + &
                  (p%O(m3,m1,1,na)*p%O(m4,m2,1,na)  + &
                   p%O(m3,m1,2,na)*p%O(m4,m2,2,na)) * &
                          compute_eri(l3,l2,l4,l1,    &
                    tau(:,na)*alat,tau(:,na)*alat,    &
                    tau(:,na)*alat,tau(:,na)*alat,    &
                                      c3,c2,c4,c1)
        ENDIF
        !
     ENDDO ! m4
     ENDDO ! m3
     ENDDO ! m2
     ENDDO ! m1
     !
  ENDDO ! na
  !
  DEALLOCATE (p%O)
  !
  HF%U = 0.0_DP ; HF%J = 0.0_DP
  !
  DO na = 1, nat
     nt = ityp(na)
     !
     IF ( ehub_lm(nt) == 0 ) CYCLE
     !
     DO m1 = 1, ehub_lm(nt)
     DO m2 = 1, ehub_lm(nt)
        !
        IF ( m1 == m2 ) THEN
             HF%U(ehub_l(m1,nt),ehub_l(m2,nt),na) = &
             HF%U(ehub_l(m1,nt),ehub_l(m2,nt),na) + &
                    ns(m1,m1,1,na)*ns(m2,m2,2,na) + &
                    ns(m1,m1,2,na)*ns(m2,m2,1,na)
        ELSE
             HF%U(ehub_l(m1,nt),ehub_l(m2,nt),na) = &
             HF%U(ehub_l(m1,nt),ehub_l(m2,nt),na) + &
                    ns(m1,m1,1,na)*ns(m2,m2,1,na) + &
                    ns(m1,m1,2,na)*ns(m2,m2,2,na) + &
                    ns(m1,m1,1,na)*ns(m2,m2,2,na) + &
                    ns(m1,m1,2,na)*ns(m2,m2,1,na)
 
             HF%J(ehub_l(m1,nt),ehub_l(m2,nt),na) = &
             HF%J(ehub_l(m1,nt),ehub_l(m2,nt),na) + &
                    ns(m1,m1,1,na)*ns(m2,m2,1,na) + &
                    ns(m1,m1,2,na)*ns(m2,m2,2,na)
        ENDIF
        !
     ENDDO ! m2
     ENDDO ! m1
     !
  ENDDO ! na
  !
  ALLOCATE (ehub_u_(nat,ehub_lm_max,ehub_lm_max)) ; ehub_u_ = 0.0_DP
  !
  DO na = 1, nat
     nt = ityp(na)
     !
     IF ( ehub_lm(nt) == 0 ) CYCLE
     !
     DO m1 = 1, ehub_lm(nt)
     DO m2 = 1, ehub_lm(nt)
        !
        IF ( ehub_l(m1,nt) == 1 .AND. ehub_l(m2,nt) == 1 ) THEN
           ehub_u_(na,m1,m2) =                          &
                 A0%U(ehub_l(m1,nt),ehub_l(m2,nt),na) / &
                 HF%U(ehub_l(m1,nt),ehub_l(m2,nt),na) * &
                      remove_ehub_u(nt,ehub_l(m1,nt)) * &
                      remove_ehub_u(nt,ehub_l(m2,nt))
        ELSE
           ehub_u_(na,m1,m2) =                          &
                (A0%U(ehub_l(m1,nt),ehub_l(m2,nt),na) / &
                 HF%U(ehub_l(m1,nt),ehub_l(m2,nt),na) - &
                 A0%J(ehub_l(m1,nt),ehub_l(m2,nt),na) / &
                 HF%J(ehub_l(m1,nt),ehub_l(m2,nt),na))* &
                      remove_ehub_u(nt,ehub_l(m1,nt)) * &
                      remove_ehub_u(nt,ehub_l(m2,nt))
        ENDIF
        !
        ehub_u(na,m1,m2) =                               &
              (1.0_DP - ehub_mixing)*ehub_u (na,m1,m2) + &
              (         ehub_mixing)*ehub_u_(na,m1,m2)
        !
     ENDDO ! m2
     ENDDO ! m1
     !
  ENDDO ! na
  !
  DO na1 = 1, nat
     nt1 = ityp(na1)
     !
     IF ( ehub_lm(nt1) == 0 ) CYCLE
     !
     DO m1 = 1, ehub_lm(nt1)
     DO m2 = m1, ehub_lm(nt1)
        !
        ehub_u(na1,m1,m2) = 0.5D0 * (ehub_u(na1,m1,m2) + &
                                     ehub_u(na1,m2,m1))
        !
        ehub_u(na1,m2,m1) = ehub_u(na1,m1,m2)
        !
     ENDDO
     ENDDO
     !
  ENDDO
  !
  DEALLOCATE ( ehub_u_ )
  DEALLOCATE ( A0%U, A0%J )
  DEALLOCATE ( HF%U, HF%J )

  CALL write_ehub_uv

  CALL stop_clock('acbn0_ns_a0')

  RETURN

END SUBROUTINE hp_acbn0_ns_a0
!
SUBROUTINE hp_acbn0_symm_n4( n )

  USE kinds,                ONLY : DP
  USE ions_base,            ONLY : nat, ityp, ntyp => nsp
  USE ldaV,                 ONLY : ehub_lm, ehub_l, ehub_lm_max, &
                                   ehub_nn_vect, ehub_nn_dim,    &
                                   ehub_csize, ehub_nnnc
  USE lsda_mod,             ONLY : nspin
  USE symm_base,            ONLY : d1, d2, d3, nsym, irt

  IMPLICIT NONE

  TYPE occmat_4
     REAL(DP), ALLOCATABLE :: O(:,:,:,:)
     REAL(DP), ALLOCATABLE :: T(:,:,:,:)
  END TYPE occmat_4

  TYPE(occmat_4), INTENT(INOUT) :: n

  INTEGER                       :: is, isym, l, m, nt
  INTEGER                       :: na1, na2
  INTEGER                       :: nt1, nt2
  INTEGER                       :: m1, m2, m3, m4
  INTEGER                       :: m1_, m2_, m3_, m4_
  INTEGER                       :: temp, l_separation(5,ntyp)

  ALLOCATE (n%T(ehub_lm_max,ehub_lm_max,nspin,nat)) ; n%T = 0.0_DP

  DO nt = 1, ntyp
     !
     ! BUGFIX vs PW/src/new_ns_v.f90:2993 (Finding #1 of logs/new_ns_v_review.md).
     ! Without this guard a type carrying no Hubbard manifold has ehub_l(1,nt)=0,
     ! and the next line writes l_separation(0,nt) - one element BEFORE the array.
     ! Dormant for NiO (all three types are Hubbard-active); fires the moment a
     ! spectator species is added.
     !
     IF ( ehub_lm(nt) == 0 ) CYCLE
     !
     temp = ehub_l(1,nt)
     l_separation(ehub_l(1,nt),nt) = 1
     !
     DO m = 2, ehub_lm(nt)
        !
        IF ( ehub_l(m,nt) /= temp ) THEN
           temp = ehub_l(m,nt)
           l_separation(ehub_l(m,nt),nt) = m
        ENDIF
        !
     ENDDO
     !
  ENDDO
  !
  DO is = 1, nspin
     !
     DO na1 = 1, nat
        nt1 = ityp(na1)
        !
        IF ( ehub_lm(nt1) == 0 ) CYCLE
        !
        DO m1 = 1, ehub_lm(nt1)
           m1_ = m1 - l_separation(ehub_l(m1,nt1),nt1) + 1
           !
        DO m2 = 1, ehub_lm(nt1)
           m2_ = m2 - l_separation(ehub_l(m2,nt1),nt1) + 1
           !
           DO isym = 1, nsym
              !
              na2 = irt(isym, na1)
              !
              DO m3 = 1, ehub_lm(nt1)
                 IF ( ehub_l(m1,nt1) /= ehub_l(m3,nt1) ) CYCLE
                 m3_ = m3 - l_separation(ehub_l(m3,nt1),nt1) + 1
                 !
              DO m4 = 1, ehub_lm(nt1)
                 IF ( ehub_l(m2,nt1) /= ehub_l(m4,nt1) ) CYCLE
                 m4_ = m4 - l_separation(ehub_l(m4,nt1),nt1) + 1
                 !
                 IF ( ehub_l(m1,nt1) == 1 .AND. ehub_l(m2,nt1) == 1 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                        n%O(m3,m4,is,na2) / &
                                                   (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 1 .AND. ehub_l(m2,nt1) == 2 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                        n%O(m3,m4,is,na2) * &
                                         d1(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 1 .AND. ehub_l(m2,nt1) == 3 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                        n%O(m3,m4,is,na2) * &
                                         d2(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 1 .AND. ehub_l(m2,nt1) == 4 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                        n%O(m3,m4,is,na2) * &
                                         d3(m4_,m2_,isym) / &
                                                   (nsym)
  
                 ELSE IF ( ehub_l(m1,nt1) == 2 .AND. ehub_l(m2,nt1) == 1 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d1(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) / &
                                                   (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 2 .AND. ehub_l(m2,nt1) == 2 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d1(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d1(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 2 .AND. ehub_l(m2,nt1) == 3 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d1(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d2(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 2 .AND. ehub_l(m2,nt1) == 4 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d1(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d3(m4_,m2_,isym) / &
                                                   (nsym)

                 ELSE IF ( ehub_l(m1,nt1) == 3 .AND. ehub_l(m2,nt1) == 1 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d2(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) / &
                                                   (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 3 .AND. ehub_l(m2,nt1) == 2 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d2(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d1(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 3 .AND. ehub_l(m2,nt1) == 3 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d2(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d2(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 3 .AND. ehub_l(m2,nt1) == 4 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d2(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d3(m4_,m2_,isym) / &
                                                   (nsym)

                 ELSE IF ( ehub_l(m1,nt1) == 4 .AND. ehub_l(m2,nt1) == 1 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d3(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) / &
                                                   (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 4 .AND. ehub_l(m2,nt1) == 2 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d3(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d1(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 4 .AND. ehub_l(m2,nt1) == 3 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d3(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d2(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 4 .AND. ehub_l(m2,nt1) == 4 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d3(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d3(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE
                    CALL errore('new_ns_v','angular momentum not implemented',1)
                 ENDIF
                 !
              ENDDO ! m4
              ENDDO ! m3
              !
           ENDDO ! isym
           !
        ENDDO ! m2
        ENDDO ! m1
        ! 
     ENDDO ! na1
     !
  ENDDO ! is
  !
  DO na1 = 1, nat
     nt1 = ityp(na1)
     !
     IF ( ehub_lm(nt1) == 0 ) CYCLE
     !
     DO is = 1, nspin
        !
        DO m1 = 1, ehub_lm(nt1)
        DO m2 = m1, ehub_lm(nt1)
           !
           n%T(m1,m2,is,na1) = 0.5D0 * (n%T(m1,m2,is,na1) + &
                                        n%T(m2,m1,is,na1))
           !
           n%T(m2,m1,is,na1) = n%T(m1,m2,is,na1)
           !
        ENDDO
        ENDDO
        !
     ENDDO
     !
  ENDDO
  !
  n%O = n%T
  DEALLOCATE (n%T)

END SUBROUTINE hp_acbn0_symm_n4
!
SUBROUTINE hp_acbn0_orberi(ehub_l, eri_l)

  ! ehub_l = 1: s orbital [eri_l = 1(s)]
  ! ehub_l = 2: p orbital [eri_l = 2(pz), 3(px), 4(py)]
  ! ehub_l = 3: d orbital [eri_l = 5(dz^2-r^2), 6(dxz), 7(dyz), 8(dx^2-y^2),
  ! 9(dxy)]

  IMPLICIT NONE

  INTEGER, INTENT(IN)    :: ehub_l
  INTEGER, INTENT(INOUT) :: eri_l

  IF (ehub_l == 1) THEN
     eri_l = 1
  ELSEIF (ehub_l == 2) THEN
     IF (eri_l == 2) THEN
        eri_l = 3
     ELSEIF (eri_l == 3) THEN
        eri_l = 4
     ELSE
        eri_l = 2
     ENDIF
  ELSEIF (ehub_l == 3) THEN
     IF (eri_l == 5) THEN
        eri_l = 6
     ELSEIF (eri_l == 6) THEN
        eri_l = 7
     ELSEIF (eri_l == 7) THEN
        eri_l = 8
     ELSEIF (eri_l == 8) THEN
        eri_l = 9
     ELSE
        eri_l = 5
     ENDIF
  ENDIF

  RETURN

END SUBROUTINE hp_acbn0_orberi
