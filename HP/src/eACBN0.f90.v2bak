!
!-----------------------------------------------------------------------
!  eACBN0.f90  --  ACBN0 / eACBN0 Hubbard parameters inside hp.x
!-----------------------------------------------------------------------
!
!  Driven by the input tag  acbn0  of &INPUTHP:
!
!     acbn0 = 0 (default)    DFPT linear response  -> stock hp.x, untouched
!     acbn0 = 1              on-site U             -> ACBN0
!     acbn0 = 2              on-site U + V         -> eACBN0        (stage S4)
!
!  When acbn0 > 0 hp.x computes the ACBN0 parameters from the ground state in
!  outdir and stops; it never enters the DFPT q-loop.  The point is that both
!  estimators - ACBN0 and linear response - can then be produced from ONE
!  ground state by one binary, which is what makes them comparable.
!
!-----------------------------------------------------------------------
!  STAGE S3 - ldaU bookkeeping
!-----------------------------------------------------------------------
!
!  S1/S2 read the Hubbard manifold out of MODULE ldaV, which only exists if
!  pw.x was run with the fork's lacbn0 = .true. and wrote an <ehub> block to
!  the XML.  That made the S0/S1/S2 comparison exact, but it also meant hp.x
!  could only do ACBN0 on a ground state produced by the patched pw.x.
!
!  S3 moves the bookkeeping to MODULE ldaU - stock QE's own - so ACBN0 runs on
!  ANY ortho-atomic DFT+U ground state, including the very one the DFPT branch
!  of hp.x uses.  Nothing about the physics changes; only where the indices
!  come from.
!
!  The translation is exact for one Hubbard channel per type:
!
!      ldaV                        ldaU                        this file
!      ------------------------    ------------------------    -----------
!      wfcv                        wfcU                        wfcU
!      nwfcv                       nwfcU                       nwfcU
!      ofstv(na)                   offsetU(na)                 offsetU(na)
!      iunhubv / nwordwfcv         iunhub / nwordwfcU          idem
!      ehub_lm(nt)                 2*Hubbard_l(nt)+1           lm(nt)
!      ehub_lm_max                 2*Hubbard_lmax+1            lm_max
!      ehub_l(m,nt)                Hubbard_l(nt)+1             lch(nt)
!      orthowfcv()                 orthoUwfc(.FALSE.)          idem
!      copy_v_wfc                  copy_U_wfc                  (inside those)
!      ehub_u(na,m1,m2)            -                           hub_u argument
!
!  ehub_l(m,nt) is filled by init_lda_plus_v as l+1 for EVERY m of the
!  manifold (ldaV.f90, the "... ehub_l" loop), so it is m-independent whenever
!  a type carries a single channel - which is the only case ldaU's scalar
!  Hubbard_l(nt) can express.  Multi-channel types are rejected in
!  hp_acbn0_check rather than silently mistranslated; ldaU spells those with
!  Hubbard_l2/Hubbard_l3 in SEPARATE offsetU_back blocks, not by concatenation
!  into one manifold the way ldaV does, so they are not a rename away.
!
!  Three things S2 needed and S3 does not, all of them ldaV artefacts:
!
!    - remove_ehub_u / remove_ehub_v.  Uninitialised in hp.x (set only in
!      pw.x's dftU_iosys_v1, and not round-tripped through the XML), and
!      new_ns_a0 multiplies the final U by them twice.  That was Bug 2 of the
!      S1 run: a silently scaled or zeroed U.  ldaU has no such mask, so the
!      bug class is gone rather than worked around.
!    - ehub_mixing.  A self-consistency knob for pw.x's ACBN0 loop; hp.x is
!      one-shot, so it was forced to 1.0.  Now simply absent.
!    - the ehub_u shape guard.  ehub_u was a module array whose XML-stored
!      dimension could disagree with the recomputed one.  hub_u is now a local
!      allocated here, so it cannot disagree with anything.
!
!  What stays, because both are properties of hp.x's read path and not of the
!  bookkeeping:
!
!    - CALL d_matrix.  read_file only builds d1/d2/d3 under okpaw
!      (read_file_new.f90:348-351) and hp_acbn0_symm_n4 needs them.
!    - reopening iunwfc.  read_file closes it at read_file_new.f90:62 with
!      close_buffer(...,'KEEP'); 'KEEP' preserves the FILES but the call also
!      deregisters the unit, so get_buffer falls through to davcio on a closed
!      unit (Bug 1 of the S1 run).  Stock hp.x never trips this because it
!      reads wavefunctions through iuwfc (units_lr), opened in hp_openfil_q.
!
!  Unit note: hp.x also uses iunhub, in hp_openfil_q.f90:76 and
!  hp_close_q.f90:39.  There is no collision because acbn0 > 0 returns from
!  hp_main before the q-loop opens it, but this file must therefore close it
!  itself.
!
!-----------------------------------------------------------------------
SUBROUTINE hp_acbn0_u()
  !---------------------------------------------------------------------
  !
  ! Driver.  Everything hp.x needs that read_file did not already do.
  !
  USE kinds,            ONLY : DP
  USE io_global,        ONLY : stdout
  USE io_files,         ONLY : iunhub, nwordwfcU, iunwfc, nwordwfc
  USE buffers,          ONLY : open_buffer, close_buffer
  USE ions_base,        ONLY : nat
  USE lsda_mod,         ONLY : nspin
  USE wvfct,            ONLY : npwx, nbnd
  USE control_flags,    ONLY : io_level
  USE noncollin_module, ONLY : npol
  USE symm_base,        ONLY : d1, d2, d3
  USE ldaU,             ONLY : Hubbard_lmax, nwfcU
  USE ldaU_hp,          ONLY : acbn0
  !
  IMPLICIT NONE
  !
  REAL(DP), ALLOCATABLE :: ns(:,:,:,:)      ! occupation matrix
  REAL(DP), ALLOCATABLE :: hub_u(:,:,:)     ! hub_u(na,m1,m2), in Ry
  !
  INTEGER               :: lm_max
  LOGICAL               :: exst
  !
  CALL start_clock('hp_acbn0')
  !
  WRITE( stdout, '(/5x,70("="))')
  WRITE( stdout, '(5x,"ACBN0 Hubbard parameters (acbn0 = ",i1,")")') acbn0
  WRITE( stdout, '(5x,"pseudo-hybrid estimator - NOT linear response")')
  WRITE( stdout, '(5x,70("="),/)')
  !
  CALL hp_acbn0_check()
  !
  lm_max = 2*Hubbard_lmax + 1
  !
  ! d1/d2/d3 are the Wigner rotation matrices used by hp_acbn0_symm_n4.
  ! read_file builds them only under okpaw, and our pseudos are norm-conserving.
  !
  CALL d_matrix( d1, d2, d3 )
  !
  ! Reopen iunwfc - see the Bug 1 note in the file header.  These are
  ! read_file's own two lines (read_file_new.f90:59-62).
  !
  nwordwfc = nbnd * npwx * npol
  CALL open_buffer( iunwfc, 'wfc', nwordwfc, io_level, exst )
  IF ( io_level /= 0 .AND. .NOT.exst ) CALL errore( 'hp_acbn0_u', &
     'the KS wavefunction files (prefix.wfc*) are missing from outdir - &
     &rerun pw.x, or set disk_io to at least "low"', 1 )
  !
  ! Projector buffer.  In pw.x this is opened by openfil.f90; hp.x's own
  ! open of iunhub lives in hp_openfil_q, which acbn0 > 0 never reaches.
  !
  nwordwfcU = npwx * nwfcU * npol
  CALL open_buffer( iunhub, 'hub', nwordwfcU, io_level, exst )
  !
  ! Fill wfcU = O^{-1/2} S phi on the Hubbard manifold, for every k point.
  !
  CALL orthoUwfc( .FALSE. )
  !
  ALLOCATE( ns(lm_max,lm_max,nspin,nat) )   ; ns(:,:,:,:)    = 0.0_DP
  ALLOCATE( hub_u(nat,lm_max,lm_max) )      ; hub_u(:,:,:)   = 0.0_DP
  !
  CALL hp_acbn0_ns_a0( ns, hub_u )
  !
  CALL hp_acbn0_write( ns, hub_u )
  !
  DEALLOCATE( ns, hub_u )
  !
  CALL close_buffer( iunhub, 'delete' )   ! ours, scratch
  CALL close_buffer( iunwfc, 'KEEP'   )   ! the user's wavefunctions - NEVER delete
  !
  CALL stop_clock('hp_acbn0')
  !
  RETURN
  !
END SUBROUTINE hp_acbn0_u

!-----------------------------------------------------------------------
SUBROUTINE hp_acbn0_check()
  !---------------------------------------------------------------------
  !
  ! Everything the ACBN0 kernels silently assume.  Each of these fails as a
  ! wrong number rather than as a crash if it is not caught here.
  !
  USE io_global,        ONLY : stdout
  USE ions_base,        ONLY : ntyp => nsp, atm
  USE lsda_mod,         ONLY : nspin
  USE control_flags,    ONLY : gamma_only
  USE ldaU,             ONLY : lda_plus_u, Hubbard_projectors, Hubbard_lmax, &
                               Hubbard_l, is_hubbard, is_hubbard_back, nwfcU
  !
  IMPLICIT NONE
  !
  INTEGER :: nt, nath
  !
  IF ( .NOT.lda_plus_u ) CALL errore( 'hp_acbn0_check', &
     'acbn0 > 0 needs a ground state with a Hubbard manifold: the pw.x run &
     &had lda_plus_u = .false., so MODULE ldaU carries no manifold to &
     &project onto.  Add a HUBBARD card to the pw.x input.', 1 )
  !
  ! ortho-atomic is a requirement, not a preference: ACBN0's occupation
  ! ratio is derived for an orthonormal projector basis.  Note the change
  ! from S1/S2, where orthowfcv silently FORCED Hubbard_projectors to
  ! ortho-atomic whatever the input said; orthoUwfc honours the input, so
  ! the contract has to be enforced here instead.
  !
  IF ( TRIM(Hubbard_projectors) /= 'ortho-atomic' ) CALL errore( 'hp_acbn0_check', &
     'ACBN0 requires ortho-atomic Hubbard projectors; rerun pw.x with &
     &HUBBARD (ortho-atomic).', 1 )
  !
  IF ( Hubbard_lmax < 0 .OR. nwfcU <= 0 ) CALL errore( 'hp_acbn0_check', &
     'no Hubbard manifold was found (Hubbard_lmax < 0 or nwfcU = 0).', 1 )
  !
  ! Multi-channel types.  ldaV concatenates every chosen channel of a type
  ! into one manifold indexed by ehub_l(m,nt); ldaU puts the second and third
  ! channels in separate offsetU_back blocks with their own Hubbard_l2 and
  ! Hubbard_l3.  The kernels here assume ONE channel per type, so say so
  ! rather than quietly project onto the first one.
  !
  DO nt = 1, ntyp
     IF ( is_hubbard_back(nt) ) CALL errore( 'hp_acbn0_check', &
        'background Hubbard channels (Hubbard_l2/Hubbard_l3) are not &
        &supported by the ACBN0 kernels: one channel per atomic type only.', nt )
  ENDDO
  !
  ! f manifolds: pao_3g carries 3-Gaussian PAO fits for s, p and d only, and
  ! returns c = 0 without complaining for anything else - which would make
  ! every eri vanish and U come out as 0/0.
  !
  DO nt = 1, ntyp
     IF ( is_hubbard(nt) .AND. Hubbard_l(nt) > 2 ) CALL errore( 'hp_acbn0_check', &
        'ACBN0 is implemented for s, p and d manifolds only: pao_3g has no &
        &f-shell Gaussian fit and returns zero coefficients silently.', nt )
  ENDDO
  !
  ! nspin: the kernels hard-code spin indices 1 and 2 in the A0/HF accumulators.
  !
  IF ( nspin /= 2 ) CALL errore( 'hp_acbn0_check', &
     'ACBN0 in hp.x is implemented for collinear spin-polarised only &
     &(nspin = 2).', 1 )
  !
  IF ( gamma_only ) CALL errore( 'hp_acbn0_check', &
     'gamma_only is not supported by the ACBN0 kernels', 1 )
  !
  ! Report the manifold that was actually picked up, so the run is auditable
  ! from stdout alone.
  !
  nath = 0
  WRITE( stdout, '(5x,"Hubbard manifold taken from MODULE ldaU:")')
  DO nt = 1, ntyp
     IF ( .NOT.is_hubbard(nt) ) CYCLE
     nath = nath + 1
     WRITE( stdout, '(7x,"type ",i2,"  ",a6,"  l = ",i1,"   (",i2," states)")') &
           nt, TRIM(atm(nt)), Hubbard_l(nt), 2*Hubbard_l(nt)+1
  ENDDO
  WRITE( stdout, '(7x,"nwfcU = ",i5,/)') nwfcU
  !
  IF ( nath == 0 ) CALL errore( 'hp_acbn0_check', &
     'lda_plus_u is set but no atomic type is Hubbard-active.', 1 )
  !
  RETURN
  !
END SUBROUTINE hp_acbn0_check

!-----------------------------------------------------------------------
SUBROUTINE hp_acbn0_write( ns, hub_u )
  !---------------------------------------------------------------------
  !
  ! Write the ACBN0 Hubbard parameters to eACBN0_hub.dat (and to stdout).
  !
  ! Note on the "scalar U" column: hub_u(na,m1,m2) is an (m1,m2) matrix, but
  ! the kernel builds it as
  !     hub_u(na,m1,m2) = A0%U(l,l,na)/HF%U(l,l,na) - J-term
  ! i.e. it depends on m1,m2 ONLY through their l channel.  With one channel
  ! per type - which hp_acbn0_check now enforces - every element is therefore
  ! the same number, and that number is the scalar U to compare against the
  ! DFPT value in prefix.Hubbard_parameters.dat.  The full matrix is printed
  ! anyway, so that the claim is checkable rather than asserted.
  !
  USE kinds,      ONLY : DP
  USE constants,  ONLY : rytoev
  USE io_global,  ONLY : stdout, ionode
  USE io_files,   ONLY : prefix
  USE ions_base,  ONLY : nat, ityp, atm, ntyp => nsp
  USE lsda_mod,   ONLY : nspin
  USE ldaU,       ONLY : Hubbard_l, Hubbard_lmax, is_hubbard
  USE ldaU_hp,    ONLY : acbn0
  !
  IMPLICIT NONE
  !
  REAL(DP), INTENT(IN) :: ns   (2*Hubbard_lmax+1,2*Hubbard_lmax+1,nspin,nat)
  REAL(DP), INTENT(IN) :: hub_u(nat,2*Hubbard_lmax+1,2*Hubbard_lmax+1)
  !
  INTEGER              :: na, nt, m1, m2, is, iunit
  INTEGER              :: lm(ntyp), lch(ntyp)
  REAL(DP)             :: utr, occ
  LOGICAL              :: uniform
  CHARACTER(LEN=1)     :: spdf(4) = ['s','p','d','f']
  CHARACTER(LEN=256)   :: filename
  !
  INTEGER, EXTERNAL    :: find_free_unit
  !
  IF ( .NOT.ionode ) RETURN
  !
  DO nt = 1, ntyp
     IF ( is_hubbard(nt) ) THEN
        lm(nt)  = 2*Hubbard_l(nt) + 1
        lch(nt) =   Hubbard_l(nt) + 1
     ELSE
        lm(nt)  = 0
        lch(nt) = 0
     ENDIF
  ENDDO
  !
  filename = 'eACBN0_hub.dat'
  iunit = find_free_unit()
  OPEN( iunit, file = TRIM(filename), form = 'formatted', status = 'unknown' )
  !
  WRITE( iunit, '(/2x,79("="))')
  WRITE( iunit, '(/25x,"Hubbard parameters from ACBN0")')
  WRITE( iunit, '(/22x,"computed by hp.x  (acbn0 = ",i1,")")') acbn0
  WRITE( iunit, '(/2x,79("="),/)')
  WRITE( iunit, '(2x,"prefix     : ",a)') TRIM(prefix)
  WRITE( iunit, '(2x,"projectors : ortho-atomic")')
  WRITE( iunit, '(2x,"bookkeeping: MODULE ldaU (stock QE)")')
  WRITE( iunit, '(2x,"mixing     : 1.000  (one-shot; no SCF history)")')
  WRITE( iunit, '(2x,"estimator  : pseudo-hybrid ACBN0 ratio, NOT linear response")')
  !
  WRITE( iunit, '(/2x,79("-"))')
  WRITE( iunit, '(2x,"Summary")')
  WRITE( iunit, '(2x,79("-"))')
  WRITE( iunit, '(/4x,"site n.  type  label   manifold   occupation   U_ACBN0 (eV)")')
  !
  DO na = 1, nat
     nt = ityp(na)
     IF ( lm(nt) == 0 ) CYCLE
     !
     ! trace of the occupation matrix, summed over spin
     !
     occ = 0.0_DP
     DO is = 1, nspin
        DO m1 = 1, lm(nt)
           occ = occ + ns(m1,m1,is,na)
        ENDDO
     ENDDO
     !
     ! is the U matrix constant?  (see the header note)
     !
     uniform = .TRUE.
     DO m1 = 1, lm(nt)
        DO m2 = 1, lm(nt)
           IF ( ABS(hub_u(na,m1,m2) - hub_u(na,1,1)) > 1.0D-8 ) uniform = .FALSE.
        ENDDO
     ENDDO
     !
     utr = hub_u(na,1,1) * rytoev
     !
     IF ( uniform ) THEN
        WRITE( iunit, '(6x,i3,4x,i3,3x,a6,5x,a1,7x,f9.4,4x,f10.4)') &
              na, nt, TRIM(atm(nt)), spdf(lch(nt)), occ, utr
     ELSE
        WRITE( iunit, '(6x,i3,4x,i3,3x,a6,5x,a1,7x,f9.4,4x,f10.4,3x,a)') &
              na, nt, TRIM(atm(nt)), spdf(lch(nt)), occ, utr, &
              '<- matrix NOT uniform, see below'
     ENDIF
  ENDDO
  !
  WRITE( iunit, '(/2x,79("-"))')
  WRITE( iunit, '(2x,"Full U matrix  U[na, m1, m2]  (eV)")')
  WRITE( iunit, '(2x,79("-"))')
  !
  DO na = 1, nat
     nt = ityp(na)
     IF ( lm(nt) == 0 ) CYCLE
     WRITE( iunit, '(/4x,"atom ",i3,"  type ",a,"   (",i2," x",i2,")")') &
           na, TRIM(atm(nt)), lm(nt), lm(nt)
     DO m1 = 1, lm(nt)
        WRITE( iunit, '(6x,16f10.4)') (hub_u(na,m1,m2)*rytoev, m2 = 1, lm(nt))
     ENDDO
  ENDDO
  !
  WRITE( iunit, '(/2x,79("-"))')
  WRITE( iunit, '(2x,"Occupation matrix  ns[na, m1, m2, spin]")')
  WRITE( iunit, '(2x,79("-"))')
  !
  DO na = 1, nat
     nt = ityp(na)
     IF ( lm(nt) == 0 ) CYCLE
     DO is = 1, nspin
        WRITE( iunit, '(/4x,"atom ",i3,"  type ",a,"  spin ",i1)') na, TRIM(atm(nt)), is
        DO m1 = 1, lm(nt)
           WRITE( iunit, '(6x,16f10.4)') (ns(m1,m2,is,na), m2 = 1, lm(nt))
        ENDDO
     ENDDO
  ENDDO
  !
  WRITE( iunit, '(/2x,79("="),/)')
  CLOSE( iunit )
  !
  WRITE( stdout, '(/5x,"ACBN0 Hubbard parameters written to ",a,/)') TRIM(filename)
  !
  ! Echo the summary to stdout as well, so it is greppable from the job output.
  !
  WRITE( stdout, '(5x,"site n.  type  label   manifold   U_ACBN0 (eV)")')
  DO na = 1, nat
     nt = ityp(na)
     IF ( lm(nt) == 0 ) CYCLE
     WRITE( stdout, '(7x,i3,4x,i3,3x,a6,5x,a1,8x,f10.4)') &
           na, nt, TRIM(atm(nt)), spdf(lch(nt)), hub_u(na,1,1)*rytoev
  ENDDO
  WRITE( stdout, * )
  !
  RETURN
  !
END SUBROUTINE hp_acbn0_write
SUBROUTINE hp_acbn0_ns_a0(ns, hub_u)

  USE kinds,                ONLY : DP
  USE constants,            ONLY : rytoev
  USE ions_base,            ONLY : nat, ityp, ntyp => nsp, tau
  USE cell_base,            ONLY : at, alat
  USE klist,                ONLY : nks, ngk, xk
  USE ldaU,                 ONLY : Hubbard_l, Hubbard_lmax, is_hubbard, &
                                   wfcU, nwfcU, offsetU
  USE lsda_mod,             ONLY : lsda, current_spin, nspin, isk
  USE wvfct,                ONLY : nbnd, wg
  USE io_global,            ONLY : stdout
  USE control_flags,        ONLY : gamma_only
  USE wavefunctions,        ONLY : evc
  USE io_files,             ONLY : nwordwfc, iunwfc, nwordwfcU, iunhub
  USE buffers,              ONLY : get_buffer
  USE mp_pools,             ONLY : inter_pool_comm
  USE mp,                   ONLY : mp_sum
  USE becmod,               ONLY : bec_type, calbec,  &
                                   allocate_bec_type, &
                                   deallocate_bec_type
  USE uspp_param,           ONLY : upf

  IMPLICIT NONE

  REAL(DP),    INTENT(OUT) :: ns   (2*Hubbard_lmax+1,2*Hubbard_lmax+1,nspin,nat)
  REAL(DP),    INTENT(OUT) :: hub_u(nat,2*Hubbard_lmax+1,2*Hubbard_lmax+1)

  TYPE hubbard_ene_3
     REAL(DP), ALLOCATABLE :: U(:,:,:)
     REAL(DP), ALLOCATABLE :: J(:,:,:)
  END TYPE hubbard_ene_3

  TYPE occmat_4
     REAL(DP), ALLOCATABLE :: O(:,:,:,:)
     REAL(DP), ALLOCATABLE :: T(:,:,:,:)
  END TYPE occmat_4

  TYPE(bec_type)           :: proj

  TYPE(hubbard_ene_3)      :: A0, HF

  TYPE(occmat_4)           :: num(nbnd), n, p

  REAL(DP),    ALLOCATABLE :: hub_u_(:,:,:)

  REAL(DP), EXTERNAL       :: compute_eri
  REAL(DP)                 :: c1(6), c2(6), c3(6), c4(6)

  INTEGER                  :: i, ik, ibnd, is, npw
  INTEGER                  :: na, nt, l, m
  INTEGER                  :: na1, na2
  INTEGER                  :: nt1, nt2
  INTEGER                  :: m1, m2, m3, m4
  INTEGER                  :: l1, l2, l3, l4
  !
  ! The ldaV -> ldaU shape translation, m-independent by construction.
  !
  INTEGER                  :: lm_max, lm(ntyp), lch(ntyp)

  CALL start_clock('acbn0_ns_a0')
  !
  lm_max = 2*Hubbard_lmax + 1
  !
  DO nt = 1, ntyp
     IF ( is_hubbard(nt) ) THEN
        lm(nt)  = 2*Hubbard_l(nt) + 1
        lch(nt) =   Hubbard_l(nt) + 1
     ELSE
        lm(nt)  = 0     ! load-bearing: every "IF (lm(nt) == 0) CYCLE" below
        lch(nt) = 0     ! relies on it - Hubbard_l is NEGATIVE for inactive
     ENDIF              ! types, so 2*Hubbard_l+1 would be -1, not 0.
  ENDDO
  !
  CALL allocate_bec_type(nwfcU, nbnd, proj)
  !
  ALLOCATE ( n%O(lm_max,lm_max,nspin,nat) ) ; n%O = 0.0_DP
  ALLOCATE ( p%O(lm_max,lm_max,nspin,nat) ) ; p%O = 0.0_DP
  ALLOCATE ( A0%U(4,4,nat), A0%J(4,4,nat) )
  ALLOCATE ( HF%U(4,4,nat), HF%J(4,4,nat) )
  !
  DO ik = 1, nks
     !
     IF ( lsda ) current_spin = isk(ik)
     npw = ngk(ik)
     !
     ! projection < wfcU | evc >
     !
     IF ( nks > 1 ) CALL get_buffer(evc, nwordwfc, iunwfc, ik)
     IF ( nks > 1 ) CALL get_buffer(wfcU, nwordwfcU, iunhub, ik)
     CALL calbec(npw, wfcU, evc, proj)
     !
     ! calculate the occupation matrices n
     !
     DO na = 1, nat
        nt = ityp(na)
        !
        IF ( lm(nt) == 0 ) CYCLE
        !
        DO m1 = 1, lm(nt)
        DO m2 = 1, lm(nt)
           !
           IF ( gamma_only ) THEN
              DO ibnd = 1, nbnd
                 n%O(m1,m2,current_spin,na) = &
                 n%O(m1,m2,current_spin,na) + &
                                wg(ibnd,ik) * &
                  proj%r(offsetU(na)+m2,ibnd) * &
                  proj%r(offsetU(na)+m1,ibnd)
              ENDDO ! ibnd
           ELSE
              DO ibnd = 1, nbnd
                 n%O(m1,m2,current_spin,na) = &
                 n%O(m1,m2,current_spin,na) + &
                                wg(ibnd,ik) * &
             DBLE(proj%k(offsetU(na)+m2,ibnd) * &
            CONJG(proj%k(offsetU(na)+m1,ibnd)))
              ENDDO ! ibnd
           ENDIF
           !
        ENDDO ! m2
        ENDDO ! m1
        !
     ENDDO ! na
     !
     ! calculate the renormalized occupations N(ACBN0)
     !
     DO i = 1, nbnd
        ALLOCATE ( num(i)%O(4,4,nspin,ntyp) ) ; num(i)%O = 0.0_DP
        ALLOCATE ( num(i)%T(4,4,nspin,ntyp) ) ; num(i)%T = 0.0_DP
     ENDDO
     !
     DO na = 1, nat
        nt = ityp(na)
        !
        IF ( lm(nt) == 0 ) CYCLE
        !
        DO m = 1, lm(nt)
           !
           l = lch(nt)
           !
           IF ( gamma_only ) THEN
              DO ibnd = 1, nbnd
                 num(ibnd)%O(l,l,current_spin,nt) = &
                 num(ibnd)%O(l,l,current_spin,nt) + &
                         proj%r(offsetU(na)+m,ibnd) * &
                         proj%r(offsetU(na)+m,ibnd)
              ENDDO ! ibnd
           ELSE
              DO ibnd = 1, nbnd
                 num(ibnd)%O(l,l,current_spin,nt) = &
                 num(ibnd)%O(l,l,current_spin,nt) + &
                    DBLE(proj%k(offsetU(na)+m,ibnd) * &
                   CONJG(proj%k(offsetU(na)+m,ibnd)))
              ENDDO ! ibnd
           ENDIF
           !
        ENDDO ! m
        !
     ENDDO ! na
     !
     DO i = 1, nbnd
        !
        DO nt1 = 1, ntyp
        DO nt2 = 1, ntyp
           !
           IF ( upf(nt1)%psd /= upf(nt2)%psd ) CYCLE
           !
           num(i)%T(:,:,:,nt1) = num(i)%T(:,:,:,nt1) &
                               + num(i)%O(:,:,:,nt2)
           !
        ENDDO ! na2
        ENDDO ! na1
        !
     ENDDO ! i
     !
     DO i = 1, nbnd
        num(i)%O = num(i)%T
        DEALLOCATE ( num(i)%T )
     ENDDO
     !
     ! calculate the renormalized occupation matrices P(ACBN0)
     !
     DO na = 1, nat
        nt = ityp(na)
        !
        IF ( lm(nt) == 0 ) CYCLE
        !
        DO m1 = 1, lm(nt)
           !
           l1 = lch(nt)
           !
        DO m2 = 1, lm(nt)
           !
           l2 = lch(nt)
           !
           IF ( gamma_only ) THEN
              DO ibnd = 1, nbnd
                 p%O(m1,m2,current_spin,na) = &
                 p%O(m1,m2,current_spin,na) + &
                         num(ibnd)%O(l1,l2,   &
                           current_spin,nt) * &
                                wg(ibnd,ik) * &
                  proj%r(offsetU(na)+m2,ibnd) * &
                  proj%r(offsetU(na)+m1,ibnd)
              ENDDO ! ibnd
           ELSE
              DO ibnd = 1, nbnd
                 p%O(m1,m2,current_spin,na) = &
                 p%O(m1,m2,current_spin,na) + &
                         num(ibnd)%O(l1,l2,   &
                           current_spin,nt) * &
                                wg(ibnd,ik) * &
             DBLE(proj%k(offsetU(na)+m2,ibnd) * &
            CONJG(proj%k(offsetU(na)+m1,ibnd)))
              ENDDO ! ibnd
           ENDIF
           !
        ENDDO ! m2
        ENDDO ! m1
        !
     ENDDO ! na
     !
     DO i = 1, nbnd
        DEALLOCATE ( num(i)%O )
     ENDDO

  ENDDO ! ik

  CALL deallocate_bec_type(proj)

  CALL mp_sum(n%O, inter_pool_comm)
  CALL mp_sum(p%O, inter_pool_comm)

  IF ( nspin == 1 ) n%O = 0.5_DP * n%O
  !
  CALL hp_acbn0_symm_n4(n)
  !
  ns = 0.0_DP
  !
  ns = n%O
  !
  DEALLOCATE (n%O)
  !
  IF ( nspin == 1 ) p%O = 0.5_DP * p%O
  !
  CALL hp_acbn0_symm_n4(p)
  !
  ! calculate ACBN0 U & J
  !
  A0%U = 0.0_DP ; A0%J = 0.0_DP
  !
  DO na = 1, nat
     nt = ityp(na)
     !
     IF ( lm(nt) == 0 ) CYCLE
     !
     l1 = 0
     DO m1 = 1, lm(nt)
        CALL hp_acbn0_orberi(lch(nt), l1)
        CALL pao_3g(upf(nt)%psd, lch(nt), c1)
        !
     l2 = 0
     DO m2 = 1, lm(nt)
        CALL hp_acbn0_orberi(lch(nt), l2)
        CALL pao_3g(upf(nt)%psd, lch(nt), c2)
        !
     l3 = 0
     DO m3 = 1, lm(nt)
        IF ( lch(nt) /= lch(nt) ) CYCLE
        CALL hp_acbn0_orberi(lch(nt), l3)
        CALL pao_3g(upf(nt)%psd, lch(nt), c3)
        !
     l4 = 0
     DO m4 = 1, lm(nt)
        IF ( lch(nt) /= lch(nt) ) CYCLE
        CALL hp_acbn0_orberi(lch(nt), l4)
        CALL pao_3g(upf(nt)%psd, lch(nt), c4)
        !
        IF ( lch(nt) == 1 .AND. lch(nt) == 1 ) THEN
              A0%U(lch(nt),lch(nt),na)  = &
              A0%U(lch(nt),lch(nt),na)  + &
                  (p%O(m3,m1,1,na)*p%O(m4,m2,2,na)  + &
                   p%O(m3,m1,2,na)*p%O(m4,m2,1,na)) * &
                          compute_eri(l3,l1,l4,l2,    &
                    tau(:,na)*alat,tau(:,na)*alat,    &
                    tau(:,na)*alat,tau(:,na)*alat,    &
                                      c3,c1,c4,c2)
        ELSE
              A0%U(lch(nt),lch(nt),na)  = &
              A0%U(lch(nt),lch(nt),na)  + &
                  (p%O(m3,m1,1,na)*p%O(m4,m2,1,na)  + &
                   p%O(m3,m1,2,na)*p%O(m4,m2,2,na)  + &
                   p%O(m3,m1,1,na)*p%O(m4,m2,2,na)  + &
                   p%O(m3,m1,2,na)*p%O(m4,m2,1,na)) * &
                          compute_eri(l3,l1,l4,l2,    &
                    tau(:,na)*alat,tau(:,na)*alat,    &
                    tau(:,na)*alat,tau(:,na)*alat,    &
                                      c3,c1,c4,c2)
              A0%J(lch(nt),lch(nt),na)  = &
              A0%J(lch(nt),lch(nt),na)  + &
                  (p%O(m3,m1,1,na)*p%O(m4,m2,1,na)  + &
                   p%O(m3,m1,2,na)*p%O(m4,m2,2,na)) * &
                          compute_eri(l3,l2,l4,l1,    &
                    tau(:,na)*alat,tau(:,na)*alat,    &
                    tau(:,na)*alat,tau(:,na)*alat,    &
                                      c3,c2,c4,c1)
        ENDIF
        !
     ENDDO ! m4
     ENDDO ! m3
     ENDDO ! m2
     ENDDO ! m1
     !
  ENDDO ! na
  !
  DEALLOCATE (p%O)
  !
  HF%U = 0.0_DP ; HF%J = 0.0_DP
  !
  DO na = 1, nat
     nt = ityp(na)
     !
     IF ( lm(nt) == 0 ) CYCLE
     !
     DO m1 = 1, lm(nt)
     DO m2 = 1, lm(nt)
        !
        IF ( m1 == m2 ) THEN
             HF%U(lch(nt),lch(nt),na) = &
             HF%U(lch(nt),lch(nt),na) + &
                    ns(m1,m1,1,na)*ns(m2,m2,2,na) + &
                    ns(m1,m1,2,na)*ns(m2,m2,1,na)
        ELSE
             HF%U(lch(nt),lch(nt),na) = &
             HF%U(lch(nt),lch(nt),na) + &
                    ns(m1,m1,1,na)*ns(m2,m2,1,na) + &
                    ns(m1,m1,2,na)*ns(m2,m2,2,na) + &
                    ns(m1,m1,1,na)*ns(m2,m2,2,na) + &
                    ns(m1,m1,2,na)*ns(m2,m2,1,na)
 
             HF%J(lch(nt),lch(nt),na) = &
             HF%J(lch(nt),lch(nt),na) + &
                    ns(m1,m1,1,na)*ns(m2,m2,1,na) + &
                    ns(m1,m1,2,na)*ns(m2,m2,2,na)
        ENDIF
        !
     ENDDO ! m2
     ENDDO ! m1
     !
  ENDDO ! na
  !
  ALLOCATE (hub_u_(nat,lm_max,lm_max)) ; hub_u_ = 0.0_DP
  !
  DO na = 1, nat
     nt = ityp(na)
     !
     IF ( lm(nt) == 0 ) CYCLE
     !
     DO m1 = 1, lm(nt)
     DO m2 = 1, lm(nt)
        !
        IF ( lch(nt) == 1 ) THEN
           !
           ! s manifold: no exchange term, ACBN0 is the direct ratio alone.
           !
           hub_u_(na,m1,m2) = A0%U(lch(nt),lch(nt),na) /  &
                              HF%U(lch(nt),lch(nt),na)
        ELSE
           hub_u_(na,m1,m2) = A0%U(lch(nt),lch(nt),na) /  &
                              HF%U(lch(nt),lch(nt),na) -  &
                              A0%J(lch(nt),lch(nt),na) /  &
                              HF%J(lch(nt),lch(nt),na)
        ENDIF
        !
        ! One-shot, and no remove_ehub_u mask: both were ldaV input-file
        ! concepts with no ldaU counterpart.  See the file header.
        !
        hub_u(na,m1,m2) = hub_u_(na,m1,m2)
        !
     ENDDO ! m2
     ENDDO ! m1
     !
  ENDDO ! na
  !
  DO na1 = 1, nat
     nt1 = ityp(na1)
     !
     IF ( lm(nt1) == 0 ) CYCLE
     !
     DO m1 = 1, lm(nt1)
     DO m2 = m1, lm(nt1)
        !
        hub_u(na1,m1,m2) = 0.5D0 * (hub_u(na1,m1,m2) + &
                                     hub_u(na1,m2,m1))
        !
        hub_u(na1,m2,m1) = hub_u(na1,m1,m2)
        !
     ENDDO
     ENDDO
     !
  ENDDO
  !
  DEALLOCATE ( hub_u_ )
  DEALLOCATE ( A0%U, A0%J )
  DEALLOCATE ( HF%U, HF%J )

  CALL stop_clock('acbn0_ns_a0')

  RETURN

END SUBROUTINE hp_acbn0_ns_a0
!
SUBROUTINE hp_acbn0_symm_n4( n )

  USE kinds,                ONLY : DP
  USE ions_base,            ONLY : nat, ityp, ntyp => nsp
  USE ldaU,                 ONLY : Hubbard_l, Hubbard_lmax, is_hubbard
  USE lsda_mod,             ONLY : nspin
  USE symm_base,            ONLY : d1, d2, d3, nsym, irt

  IMPLICIT NONE

  TYPE occmat_4
     REAL(DP), ALLOCATABLE :: O(:,:,:,:)
     REAL(DP), ALLOCATABLE :: T(:,:,:,:)
  END TYPE occmat_4

  TYPE(occmat_4), INTENT(INOUT) :: n

  INTEGER                       :: is, isym, l, m, nt
  INTEGER                       :: na1, na2
  INTEGER                       :: nt1, nt2
  INTEGER                       :: m1, m2, m3, m4
  INTEGER                       :: m1_, m2_, m3_, m4_
  INTEGER                       :: temp, l_separation(5,ntyp)
  INTEGER                       :: lm_max, lm(ntyp), lch(ntyp)

  lm_max = 2*Hubbard_lmax + 1
  !
  DO nt = 1, ntyp
     IF ( is_hubbard(nt) ) THEN
        lm(nt)  = 2*Hubbard_l(nt) + 1
        lch(nt) =   Hubbard_l(nt) + 1
     ELSE
        lm(nt)  = 0     ! load-bearing: every "IF (lm(nt) == 0) CYCLE" below
        lch(nt) = 0     ! relies on it - Hubbard_l is NEGATIVE for inactive
     ENDIF              ! types, so 2*Hubbard_l+1 would be -1, not 0.
  ENDDO

  ALLOCATE (n%T(lm_max,lm_max,nspin,nat)) ; n%T = 0.0_DP

  DO nt = 1, ntyp
     !
     ! BUGFIX vs PW/src/new_ns_v.f90:2993 (Finding #1 of logs/new_ns_v_review.md).
     ! Without this guard a type carrying no Hubbard manifold has lch(nt)=0,
     ! and the next line writes l_separation(0,nt) - one element BEFORE the array.
     ! Dormant for NiO (all three types are Hubbard-active); fires the moment a
     ! spectator species is added.
     !
     IF ( lm(nt) == 0 ) CYCLE
     !
     temp = lch(nt)
     l_separation(lch(nt),nt) = 1
     !
     DO m = 2, lm(nt)
        !
        IF ( lch(nt) /= temp ) THEN
           temp = lch(nt)
           l_separation(lch(nt),nt) = m
        ENDIF
        !
     ENDDO
     !
  ENDDO
  !
  DO is = 1, nspin
     !
     DO na1 = 1, nat
        nt1 = ityp(na1)
        !
        IF ( lm(nt1) == 0 ) CYCLE
        !
        DO m1 = 1, lm(nt1)
           m1_ = m1 - l_separation(lch(nt1),nt1) + 1
           !
        DO m2 = 1, lm(nt1)
           m2_ = m2 - l_separation(lch(nt1),nt1) + 1
           !
           DO isym = 1, nsym
              !
              na2 = irt(isym, na1)
              !
              DO m3 = 1, lm(nt1)
                 IF ( lch(nt1) /= lch(nt1) ) CYCLE
                 m3_ = m3 - l_separation(lch(nt1),nt1) + 1
                 !
              DO m4 = 1, lm(nt1)
                 IF ( lch(nt1) /= lch(nt1) ) CYCLE
                 m4_ = m4 - l_separation(lch(nt1),nt1) + 1
                 !
                 IF ( lch(nt1) == 1 .AND. lch(nt1) == 1 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                        n%O(m3,m4,is,na2) / &
                                                   (nsym)
                 ELSE IF ( lch(nt1) == 1 .AND. lch(nt1) == 2 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                        n%O(m3,m4,is,na2) * &
                                         d1(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE IF ( lch(nt1) == 1 .AND. lch(nt1) == 3 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                        n%O(m3,m4,is,na2) * &
                                         d2(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE IF ( lch(nt1) == 1 .AND. lch(nt1) == 4 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                        n%O(m3,m4,is,na2) * &
                                         d3(m4_,m2_,isym) / &
                                                   (nsym)
  
                 ELSE IF ( lch(nt1) == 2 .AND. lch(nt1) == 1 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d1(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) / &
                                                   (nsym)
                 ELSE IF ( lch(nt1) == 2 .AND. lch(nt1) == 2 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d1(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d1(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE IF ( lch(nt1) == 2 .AND. lch(nt1) == 3 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d1(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d2(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE IF ( lch(nt1) == 2 .AND. lch(nt1) == 4 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d1(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d3(m4_,m2_,isym) / &
                                                   (nsym)

                 ELSE IF ( lch(nt1) == 3 .AND. lch(nt1) == 1 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d2(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) / &
                                                   (nsym)
                 ELSE IF ( lch(nt1) == 3 .AND. lch(nt1) == 2 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d2(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d1(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE IF ( lch(nt1) == 3 .AND. lch(nt1) == 3 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d2(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d2(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE IF ( lch(nt1) == 3 .AND. lch(nt1) == 4 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d2(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d3(m4_,m2_,isym) / &
                                                   (nsym)

                 ELSE IF ( lch(nt1) == 4 .AND. lch(nt1) == 1 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d3(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) / &
                                                   (nsym)
                 ELSE IF ( lch(nt1) == 4 .AND. lch(nt1) == 2 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d3(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d1(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE IF ( lch(nt1) == 4 .AND. lch(nt1) == 3 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d3(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d2(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE IF ( lch(nt1) == 4 .AND. lch(nt1) == 4 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d3(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d3(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE
                    CALL errore('new_ns_v','angular momentum not implemented',1)
                 ENDIF
                 !
              ENDDO ! m4
              ENDDO ! m3
              !
           ENDDO ! isym
           !
        ENDDO ! m2
        ENDDO ! m1
        ! 
     ENDDO ! na1
     !
  ENDDO ! is
  !
  DO na1 = 1, nat
     nt1 = ityp(na1)
     !
     IF ( lm(nt1) == 0 ) CYCLE
     !
     DO is = 1, nspin
        !
        DO m1 = 1, lm(nt1)
        DO m2 = m1, lm(nt1)
           !
           n%T(m1,m2,is,na1) = 0.5D0 * (n%T(m1,m2,is,na1) + &
                                        n%T(m2,m1,is,na1))
           !
           n%T(m2,m1,is,na1) = n%T(m1,m2,is,na1)
           !
        ENDDO
        ENDDO
        !
     ENDDO
     !
  ENDDO
  !
  n%O = n%T
  DEALLOCATE (n%T)

END SUBROUTINE hp_acbn0_symm_n4
!
SUBROUTINE hp_acbn0_orberi(lp1, eri_l)

  ! lp1 = 1: s orbital [eri_l = 1(s)]
  ! lp1 = 2: p orbital [eri_l = 2(pz), 3(px), 4(py)]
  ! lp1 = 3: d orbital [eri_l = 5(dz^2-r^2), 6(dxz), 7(dyz), 8(dx^2-y^2),
  ! 9(dxy)]

  IMPLICIT NONE

  INTEGER, INTENT(IN)    :: lp1
  INTEGER, INTENT(INOUT) :: eri_l

  IF (lp1 == 1) THEN
     eri_l = 1
  ELSEIF (lp1 == 2) THEN
     IF (eri_l == 2) THEN
        eri_l = 3
     ELSEIF (eri_l == 3) THEN
        eri_l = 4
     ELSE
        eri_l = 2
     ENDIF
  ELSEIF (lp1 == 3) THEN
     IF (eri_l == 5) THEN
        eri_l = 6
     ELSEIF (eri_l == 6) THEN
        eri_l = 7
     ELSEIF (eri_l == 7) THEN
        eri_l = 8
     ELSEIF (eri_l == 8) THEN
        eri_l = 9
     ELSE
        eri_l = 5
     ENDIF
  ENDIF

  RETURN

END SUBROUTINE hp_acbn0_orberi

!-----------------------------------------------------------------------
!  Dispatcher
!-----------------------------------------------------------------------
!
!  The two branches are at different stages of the same migration and must
!  not be merged yet:
!
!    acbn0 = 1   ldaU bookkeeping, own transplanted kernel.   Stage S3, done.
!                Runs on any ortho-atomic DFT+U ground state.
!    acbn0 = 2   ldaV bookkeeping, libpw.a's new_ns_e0_1.     Stage V1.
!                Needs a ground state made by the patched pw.x with
!                lacbn0 = .true., i.e. an <ehub> block in the XML.
!
!  V2 transplants the kernels, V3 converts them to ldaU, and at that point
!  hp_acbn0_v folds into hp_acbn0_u and this dispatcher goes away.
!
!-----------------------------------------------------------------------
SUBROUTINE hp_acbn0()
  !---------------------------------------------------------------------
  !
  USE ldaU_hp, ONLY : acbn0
  !
  IMPLICIT NONE
  !
  IF ( acbn0 == 1 ) THEN
     CALL hp_acbn0_u()
  ELSEIF ( acbn0 == 2 ) THEN
     CALL hp_acbn0_v()
  ELSE
     CALL errore( 'hp_acbn0', 'acbn0 must be 1 or 2 here', ABS(acbn0) )
  ENDIF
  !
  RETURN
  !
END SUBROUTINE hp_acbn0

!-----------------------------------------------------------------------
SUBROUTINE hp_acbn0_v()
  !---------------------------------------------------------------------
  !
  ! STAGE V1 - on-site U AND inter-site V, still on ldaV bookkeeping and
  ! still calling libpw.a's kernel.  This is the exact analogue of S1: it
  ! proves hp.x's read path can feed new_ns_e0_1 before anything is copied.
  !
  ! acbn0_type = 2 dispatches sum_band.f90:173 to new_ns_e0_1, which is a
  ! DIFFERENT kernel from new_ns_a0 rather than an extension of it: it builds
  ! the six-index inter-site occupation matrix
  !     ns(m1,m2,spin,na1,na2,nnc)
  ! where nnc indexes the neighbour cell, and returns both ehub_u and ehub_v.
  !
  ! Free ride, same as S1: init_lda_plus_v rebuilds the ENTIRE neighbour table
  ! from geometry - ehub_nn_vect, ehub_nn_leng, ehub_nn_leng_all, ehub_nnnc,
  ! ehub_u_diff, ehub_v_diff (ldaV.f90:415-460) - and read_file_new.f90:325
  ! already calls it.
  !
  USE kinds,            ONLY : DP
  USE io_global,        ONLY : stdout
  USE io_files,         ONLY : iunhubv, nwordwfcv, iunwfc, nwordwfc
  USE buffers,          ONLY : open_buffer, close_buffer
  USE ions_base,        ONLY : nat
  USE lsda_mod,         ONLY : nspin
  USE wvfct,            ONLY : npwx, nbnd
  USE control_flags,    ONLY : io_level
  USE noncollin_module, ONLY : npol
  USE symm_base,        ONLY : d1, d2, d3
  USE ldaV,             ONLY : ehub_lm_max, ehub_nnnc, ehub_u, ehub_v,   &
                               ehub_mixing, nwfcv, remove_ehub_u,        &
                               remove_ehub_v, stop_acbn0
  !
  IMPLICIT NONE
  !
  REAL(DP), ALLOCATABLE :: ns(:,:,:,:,:,:)   ! = rho%ne0 in pw.x
  LOGICAL               :: exst
  !
  CALL start_clock('hp_acbn0')
  !
  WRITE( stdout, '(/5x,70("="))')
  WRITE( stdout, '(5x,"eACBN0 Hubbard parameters (acbn0 = 2): on-site U + intersite V")')
  WRITE( stdout, '(5x,"pseudo-hybrid estimator - NOT linear response")')
  WRITE( stdout, '(5x,"stage V1: ldaV bookkeeping, libpw.a kernel new_ns_e0_1")')
  WRITE( stdout, '(5x,70("="),/)')
  !
  CALL hp_acbn0_check_v()
  !
  ! One-shot: there is no SCF history to mix against.  The fork's default is
  ! 0.7, which would silently return 0.3*U_from_XML + 0.7*U_computed.
  !
  ehub_mixing = 1.0_DP
  !
  ! Belt and braces.  stop_acbn0 does have an initialiser (.FALSE.,
  ! ldaV.f90:73), and it is the ONLY guard on ehub_conv_thr - which does NOT
  ! have one - at new_ns_v.f90:717.  Say it out loud rather than depend on it.
  !
  stop_acbn0 = .FALSE.
  !
  ! Bug 2, and its V-branch sibling.  Neither remove_ehub_u nor remove_ehub_v
  ! has an initialiser in MODULE ldaV (ldaV.f90:46-47); both are assigned only
  ! in PW/src/input.f90:2083-2086, which is pw.x's INPUT path, and neither is
  ! round-tripped through the XML.  new_ns_e0_1 multiplies its output by them,
  ! so leaving them undefined silently scales or zeroes every U and V.
  ! 1 is the pw.x default (read_namelists.f90:248-249) = "keep this channel".
  !
  remove_ehub_u(:,:) = 1
  remove_ehub_v(:,:) = 1
  !
  ! Same class again, and this one is specific to the V branch.  ehub_v is
  ! allocated in exactly two places:
  !     PW/src/input.f90:2188      dftU_iosys_v2  - pw.x's INPUT path
  !     Modules/qexsd_copy.f90:596                - only if the XML carries
  !                                                 an <ehub_v> block
  ! init_lda_plus_v WRITES into it (ldaV.f90:408,438,468) but never allocates
  ! it.  hp.x runs neither allocator unless the XML happens to have the block,
  ! so allocate it here, and re-shape if the stored ehub_lm_max disagrees with
  ! the one init_lda_plus_v recomputes from the pseudopotentials.  Note the
  ! fork's own two allocators already disagree: input.f90 uses a hard-coded
  ! (nat,nat,9,9,nnc), qexsd_copy uses (nat,nat,lm_max,lm_max,nnc).
  !
  IF ( ALLOCATED(ehub_u) ) THEN
     IF ( SIZE(ehub_u,1) /= nat          .OR. &
          SIZE(ehub_u,2) /= ehub_lm_max  .OR. &
          SIZE(ehub_u,3) /= ehub_lm_max ) DEALLOCATE( ehub_u )
  ENDIF
  IF ( .NOT.ALLOCATED(ehub_u) ) ALLOCATE( ehub_u(nat,ehub_lm_max,ehub_lm_max) )
  ehub_u(:,:,:) = 0.0_DP
  !
  IF ( ALLOCATED(ehub_v) ) THEN
     IF ( SIZE(ehub_v,1) /= nat          .OR. SIZE(ehub_v,2) /= nat         .OR. &
          SIZE(ehub_v,3) /= ehub_lm_max  .OR. SIZE(ehub_v,4) /= ehub_lm_max .OR. &
          SIZE(ehub_v,5) /= ehub_nnnc ) DEALLOCATE( ehub_v )
  ENDIF
  IF ( .NOT.ALLOCATED(ehub_v) ) &
     ALLOCATE( ehub_v(nat,nat,ehub_lm_max,ehub_lm_max,ehub_nnnc) )
  ehub_v(:,:,:,:,:) = 0.0_DP
  !
  ! Wigner d-matrices: read_file builds them only under okpaw
  ! (read_file_new.f90:348-351) and symmetrize_n4/n4m/n5 all need them.
  !
  CALL d_matrix( d1, d2, d3 )
  !
  ! Bug 1: read_file closes iunwfc at read_file_new.f90:62 with
  ! close_buffer(...,'KEEP').  'KEEP' preserves the FILES but the call also
  ! deregisters the unit, so get_buffer falls through to davcio on a closed
  ! unit.  Same two lines read_file itself uses, so the record length matches.
  !
  nwordwfc = nbnd * npwx * npol
  CALL open_buffer( iunwfc, 'wfc', nwordwfc, io_level, exst )
  IF ( io_level /= 0 .AND. .NOT.exst ) CALL errore( 'hp_acbn0_v', &
     'the KS wavefunction files (prefix.wfc*) are missing from outdir - &
     &rerun pw.x, or set disk_io to at least "low"', 1 )
  !
  ! Projector buffer, exactly as pw.x sets it in PW/src/openfil.f90:54,62.
  !
  nwordwfcv = npwx * nwfcv * npol
  CALL open_buffer( iunhubv, 'hubv', nwordwfcv, io_level, exst )
  !
  ! wfcv = O^{-1/2} S phi.  orthowfcv forces ortho-atomic internally.
  !
  CALL orthowfcv()
  !
  ALLOCATE( ns(ehub_lm_max,ehub_lm_max,nspin,nat,nat,ehub_nnnc) )
  ns(:,:,:,:,:,:) = 0.0_DP
  !
  ! V2: our own transplanted kernel (below).  V1 called libpw.a's
  ! new_ns_e0_1 here and reproduced V0's whole U+V table identically.
  ! It calls write_ehub_uv itself, which prints the tables in pw.x's own
  ! format - that is what keeps V0/V1/V2 comparable by grep.
  !
  CALL hp_acbn0_ns_e0_1( ns )
  !
  CALL hp_acbn0_write_v( ns )
  !
  DEALLOCATE( ns )
  !
  CALL close_buffer( iunhubv, 'delete' )   ! ours, scratch
  CALL close_buffer( iunwfc,  'KEEP'   )   ! the user's wavefunctions - NEVER delete
  !
  CALL stop_clock('hp_acbn0')
  !
  RETURN
  !
END SUBROUTINE hp_acbn0_v

!-----------------------------------------------------------------------
SUBROUTINE hp_acbn0_check_v()
  !---------------------------------------------------------------------
  !
  ! The ldaV-branch preconditions.  Each of these fails as a wrong number
  ! rather than as a crash if it is not caught here.
  !
  USE io_global,        ONLY : stdout
  USE lsda_mod,         ONLY : nspin
  USE control_flags,    ONLY : gamma_only
  USE ldaU,             ONLY : Hubbard_projectors
  USE ldaV,             ONLY : lda_plus_v, lacbn0, acbn0_type, ehub_lm_max, &
                               ehub_nnnc, ehub_nn_distance
  USE ldaU_hp,          ONLY : acbn0
  !
  IMPLICIT NONE
  !
  IF ( .NOT.lda_plus_v ) CALL errore( 'hp_acbn0_check_v', &
     'acbn0 = 2 needs a pw.x run made with lacbn0 = .true.: no <ehub> block &
     &was found in the XML, so MODULE ldaV is uninitialised.  This is stage &
     &V1 - unlike acbn0 = 1, it cannot yet run on a stock ground state.', 1 )
  !
  IF ( .NOT.lacbn0 ) CALL errore( 'hp_acbn0_check_v', &
     'the pw.x run set lda_plus_v but not lacbn0; the bookkeeping is present &
     &but was never used.  Rerun pw.x with lacbn0 = .true.', 1 )
  !
  IF ( ehub_lm_max <= 0 ) CALL errore( 'hp_acbn0_check_v', &
     'ehub_lm_max <= 0 : no Hubbard manifold was selected.  Check &
     &ehub_l_choice in the pw.x input.', 1 )
  !
  ! ehub_nnnc counts the neighbour cells.  init_lda_plus_v builds it in
  ! hubbard_nns() from ehub_nn_distance, but ONLY under
  !     IF ( .NOT. lacbn0 .OR. .NOT. acbn0_type == 1 )
  ! (ldaV.f90:411).  A pw.x run made with acbn0_type = 1 therefore leaves it
  ! at zero, and every V array here would be zero-sized.
  !
  IF ( ehub_nnnc <= 0 ) CALL errore( 'hp_acbn0_check_v', &
     'ehub_nnnc <= 0 : no neighbour cells.  The pw.x run was almost certainly &
     &made with acbn0_type = 1, which skips the neighbour table entirely &
     &(ldaV.f90:411).  Rerun pw.x with acbn0_type = 2.', 1 )
  !
  ! nspin: the A0/HF assembly in the kernels hard-codes spin slots 1 and 2,
  ! while the occupation arrays are dimensioned (...,nspin,...).  With
  ! nspin = 1 that reads past the end of the array, silently.
  ! init_lda_plus_v rejects nspin = 1 too (ldaV.f90:103); this is the same
  ! contract, stated where it bites.
  !
  IF ( nspin /= 2 ) CALL errore( 'hp_acbn0_check_v', &
     'eACBN0 in hp.x is implemented for collinear spin-polarised only &
     &(nspin = 2).  For a non-magnetic system use nspin = 2 with &
     &starting_magnetization = 0.0.', 1 )
  !
  IF ( gamma_only ) CALL errore( 'hp_acbn0_check_v', &
     'gamma_only is not supported by the eACBN0 kernels', 1 )
  !
  ! acbn0 (this run) vs acbn0_type (what pw.x was run with).  They need not
  ! agree - we recompute from scratch - but a mismatch means the U and V read
  ! from the XML were produced by the other kernel.
  !
  IF ( acbn0 /= acbn0_type ) &
     WRITE( stdout, '(5x,"WARNING: acbn0 = ",i1," but the pw.x run used &
            &acbn0_type = ",i1,".")') acbn0, acbn0_type
  !
  ! orthowfcv forces this internally; say so before it happens silently.
  !
  IF ( TRIM(Hubbard_projectors) /= 'ortho-atomic' ) &
     WRITE( stdout, '(5x,"WARNING: Hubbard_projectors = ",a,"; the eACBN0 &
            &kernels use ortho-atomic projectors and will override it.")') &
            TRIM(Hubbard_projectors)
  !
  WRITE( stdout, '(5x,"neighbour shell: ehub_nn_distance = ",f6.3," A", &
        &"   ehub_nnnc = ",i4,/)') ehub_nn_distance, ehub_nnnc
  !
  RETURN
  !
END SUBROUTINE hp_acbn0_check_v

!-----------------------------------------------------------------------
SUBROUTINE hp_acbn0_write_v( ns )
  !---------------------------------------------------------------------
  !
  ! Write the eACBN0 Hubbard parameters to eACBN0_hub.dat.
  !
  ! new_ns_e0_1 has already called write_ehub_uv, which prints the same U and
  ! V tables to stdout that pw.x prints - that is the V0/V1 checkpoint.  This
  ! routine is the readable deliverable, and it also states which (na1,na2)
  ! pairs actually carry a V, which the stdout table does not.
  !
  USE kinds,      ONLY : DP
  USE constants,  ONLY : rytoev
  USE io_global,  ONLY : stdout, ionode
  USE io_files,   ONLY : prefix
  USE ions_base,  ONLY : nat, ityp, atm, ntyp => nsp
  USE lsda_mod,   ONLY : nspin
  USE ldaV,       ONLY : ehub_lm, ehub_lm_max, ehub_l, ehub_u, ehub_v, &
                         ehub_nnnc, ehub_nn_distance, acbn0_type
  !
  IMPLICIT NONE
  !
  REAL(DP), INTENT(IN) :: ns(ehub_lm_max,ehub_lm_max,nspin,nat,nat,ehub_nnnc)
  !
  INTEGER              :: na, na1, na2, nt, nt1, nt2, m1, m2, is, nnc, iunit
  INTEGER              :: npair
  REAL(DP)             :: utr, vtr, occ
  CHARACTER(LEN=1)     :: spdf(4) = ['s','p','d','f']
  CHARACTER(LEN=256)   :: filename
  !
  REAL(DP), PARAMETER  :: veps = 1.0D-8   ! Ry; below this a pair carries no V
  !
  INTEGER, EXTERNAL    :: find_free_unit
  !
  IF ( .NOT.ionode ) RETURN
  !
  filename = 'eACBN0_hub.dat'
  iunit = find_free_unit()
  OPEN( iunit, file = TRIM(filename), form = 'formatted', status = 'unknown' )
  !
  WRITE( iunit, '(/2x,79("="))')
  WRITE( iunit, '(/24x,"Hubbard parameters from eACBN0")')
  WRITE( iunit, '(/22x,"computed by hp.x  (acbn0 = ",i1,")")') acbn0_type
  WRITE( iunit, '(/2x,79("="),/)')
  WRITE( iunit, '(2x,"prefix     : ",a)') TRIM(prefix)
  WRITE( iunit, '(2x,"projectors : ortho-atomic")')
  WRITE( iunit, '(2x,"bookkeeping: MODULE ldaV (stage V1)")')
  WRITE( iunit, '(2x,"mixing     : 1.000  (one-shot; no SCF history)")')
  WRITE( iunit, '(2x,"neighbours : ehub_nn_distance = ",f6.3," A,  ehub_nnnc = ",i4)') &
        ehub_nn_distance, ehub_nnnc
  WRITE( iunit, '(2x,"estimator  : pseudo-hybrid eACBN0 ratio, NOT linear response")')
  !
  ! ---- on-site U -------------------------------------------------------
  !
  WRITE( iunit, '(/2x,79("-"))')
  WRITE( iunit, '(2x,"On-site U")')
  WRITE( iunit, '(2x,79("-"))')
  WRITE( iunit, '(/4x,"site n.  type  label   manifold   occupation    U (eV)")')
  !
  DO na = 1, nat
     nt = ityp(na)
     IF ( ehub_lm(nt) == 0 ) CYCLE
     !
     ! trace of the on-site block (na,na) in the home cell, summed over spin
     !
     occ = 0.0_DP
     DO is = 1, nspin
        DO m1 = 1, ehub_lm(nt)
           occ = occ + ns(m1,m1,is,na,na,1)
        ENDDO
     ENDDO
     !
     ! The on-site U lives in ehub_v(na,na,:,:,1) - the A=B, cell [0 0 0]
     ! block - not in ehub_u, which new_ns_e0_1 never fills.  Howto2.pdf:
     ! "A = B and l = m = n = 0 >>> on-site U matrix".
     utr = ehub_v(na,na,1,1,1) * rytoev
     WRITE( iunit, '(6x,i3,4x,i3,3x,a6,5x,a1,7x,f9.4,4x,f10.4)') &
           na, nt, TRIM(atm(nt)), spdf(ehub_l(1,nt)), occ, utr
  ENDDO
  !
  ! ---- inter-site V ----------------------------------------------------
  !
  WRITE( iunit, '(/2x,79("-"))')
  WRITE( iunit, '(2x,"Inter-site V  (pairs carrying a non-zero V)")')
  WRITE( iunit, '(2x,79("-"))')
  WRITE( iunit, '(/4x,"na1  type1     na2  type2    cell     V (eV)")')
  !
  npair = 0
  DO nnc = 1, ehub_nnnc
     DO na1 = 1, nat
        nt1 = ityp(na1)
        IF ( ehub_lm(nt1) == 0 ) CYCLE
        DO na2 = 1, nat
           nt2 = ityp(na2)
           IF ( ehub_lm(nt2) == 0 ) CYCLE
           IF ( nnc == 1 .AND. na1 == na2 ) CYCLE   ! that is the U above
           !
           vtr = ehub_v(na1,na2,1,1,nnc)
           IF ( ABS(vtr) < veps ) CYCLE
           !
           npair = npair + 1
           WRITE( iunit, '(4x,i3,2x,a6,4x,i3,2x,a6,3x,i4,4x,f10.4)') &
                 na1, TRIM(atm(nt1)), na2, TRIM(atm(nt2)), nnc, vtr*rytoev
        ENDDO
     ENDDO
  ENDDO
  !
  IF ( npair == 0 ) WRITE( iunit, '(/4x,"(none - check ehub_nn_distance)")')
  WRITE( iunit, '(/4x,i5," pair(s) with |V| > ",es8.1," Ry")') npair, veps
  !
  ! ---- full on-site U matrices ----------------------------------------
  !
  WRITE( iunit, '(/2x,79("-"))')
  WRITE( iunit, '(2x,"Full on-site U matrix  = ehub_v[na, na, m1, m2, cell 0]  (eV)")')
  WRITE( iunit, '(2x,79("-"))')
  !
  DO na = 1, nat
     nt = ityp(na)
     IF ( ehub_lm(nt) == 0 ) CYCLE
     WRITE( iunit, '(/4x,"atom ",i3,"  type ",a,"   (",i2," x",i2,")")') &
           na, TRIM(atm(nt)), ehub_lm(nt), ehub_lm(nt)
     DO m1 = 1, ehub_lm(nt)
        WRITE( iunit, '(6x,16f10.4)') (ehub_v(na,na,m1,m2,1)*rytoev, m2 = 1, ehub_lm(nt))
     ENDDO
  ENDDO
  !
  ! ---- on-site occupation matrices ------------------------------------
  !
  WRITE( iunit, '(/2x,79("-"))')
  WRITE( iunit, '(2x,"On-site occupation matrix  ns[na, m1, m2, spin]")')
  WRITE( iunit, '(2x,79("-"))')
  !
  DO na = 1, nat
     nt = ityp(na)
     IF ( ehub_lm(nt) == 0 ) CYCLE
     DO is = 1, nspin
        WRITE( iunit, '(/4x,"atom ",i3,"  type ",a,"  spin ",i1)') na, TRIM(atm(nt)), is
        DO m1 = 1, ehub_lm(nt)
           WRITE( iunit, '(6x,16f10.4)') (ns(m1,m2,is,na,na,1), m2 = 1, ehub_lm(nt))
        ENDDO
     ENDDO
  ENDDO
  !
  WRITE( iunit, '(/2x,79("="),/)')
  CLOSE( iunit )
  !
  WRITE( stdout, '(/5x,"eACBN0 Hubbard parameters written to ",a,/)') TRIM(filename)
  !
  ! Echo to stdout so the job output is greppable.
  !
  WRITE( stdout, '(5x,"site n.  type  label   manifold      U (eV)")')
  DO na = 1, nat
     nt = ityp(na)
     IF ( ehub_lm(nt) == 0 ) CYCLE
     WRITE( stdout, '(7x,i3,4x,i3,3x,a6,5x,a1,8x,f10.4)') &
           na, nt, TRIM(atm(nt)), spdf(ehub_l(1,nt)), ehub_v(na,na,1,1,1)*rytoev
  ENDDO
  WRITE( stdout, '(/5x,i5," inter-site pair(s) with non-zero V; see ",a,/)') &
        npair, TRIM(filename)
  !
  RETURN
  !
END SUBROUTINE hp_acbn0_write_v
!
!-----------------------------------------------------------------------
!  V2 - transplanted eACBN0 (U+V) kernels
!-----------------------------------------------------------------------
!
!  Verbatim from PW/src/new_ns_v.f90 apart from the renames below and one
!  bugfix, applied at all three sites where it occurs:
!
!      hp_acbn0_ns_e0_1    <- new_ns_e0_1      636-1808
!      hp_acbn0_ns_v       <- new_ns_v          10- 232
!      hp_acbn0_symm_n4_v  <- symmetrize_n4   2964-3165   (+bugfix)
!      hp_acbn0_symm_n4m   <- symmetrize_n4m  3168-3399   (+bugfix)
!      hp_acbn0_symm_n5    <- symmetrize_n5   3400-3779   (+bugfix)
!
!  symm_n4_v is a SECOND copy of symmetrize_n4: the S3 one above was converted
!  to ldaU, and the V branch is still on ldaV.  They merge at V3.
!  hp_acbn0_orberi is shared - it is pure integer arithmetic with no USE.
!
!  hubbard_symmetry, hubbard_get_nnc, pao_3g and compute_eri stay in libpw.a
!  for now, exactly as S2 left pao_3g and compute_eri there.  They are ldaV
!  neighbour/geometry helpers and belong to V3.
!
SUBROUTINE hp_acbn0_ns_e0_1(ns)

  USE kinds,                ONLY : DP
  USE constants,            ONLY : tpi, rytoev
  USE ions_base,            ONLY : nat, ityp, ntyp => nsp, tau
  USE cell_base,            ONLY : at, alat
  USE klist,                ONLY : nks, ngk, xk
  USE ldaV,                 ONLY : ehub_lm_max, ehub_lm, ehub_l,                      &
                                   ehub_nn_vect, ehub_nn_leng, ehub_nn_dim,           &
                                   ehub_csize, ehub_nnnc, ehub_mixing, ehub_conv_thr, &
                                   ehub_v, ehub_v_diff, remove_ehub_u, write_ehub_uv, &
                                   wfcv, nwfcv, ofstv, stop_acbn0
  USE lsda_mod,             ONLY : lsda, current_spin, nspin, isk
  USE wvfct,                ONLY : nbnd, npwx, wg
  USE io_global,            ONLY : stdout
  USE control_flags,        ONLY : gamma_only
  USE wavefunctions,        ONLY : evc
  USE io_files,             ONLY : nwordwfc, iunwfc, nwordwfcv, iunhubv
  USE buffers,              ONLY : get_buffer
  USE mp_pools,             ONLY : inter_pool_comm
  USE mp,                   ONLY : mp_sum
  USE becmod,               ONLY : bec_type, calbec,  &
                                   allocate_bec_type, &
                                   deallocate_bec_type
  USE uspp_param,           ONLY : upf

  IMPLICIT NONE

  REAL(DP), INTENT(OUT)    :: ns(ehub_lm_max,ehub_lm_max,nspin,nat,nat,ehub_nnnc)

  TYPE hubbard_ene_4
     REAL(DP), ALLOCATABLE :: U(:,:,:,:)
     REAL(DP), ALLOCATABLE :: V(:,:,:,:)
     REAL(DP), ALLOCATABLE :: J(:,:,:,:)
  END TYPE hubbard_ene_4

  TYPE occmat_4
     REAL(DP), ALLOCATABLE :: O(:,:,:,:)
     REAL(DP), ALLOCATABLE :: T(:,:,:,:)
  END TYPE occmat_4

  TYPE occmat_5
     REAL(DP), ALLOCATABLE :: O(:,:,:,:,:)
     REAL(DP), ALLOCATABLE :: T(:,:,:,:,:)
  END TYPE occmat_5

  TYPE(bec_type)           :: proj

  TYPE(hubbard_ene_4)      :: E0(ehub_nnnc)
  TYPE(hubbard_ene_4)      :: HF(ehub_nnnc)

  TYPE(occmat_5)           :: n(ehub_nnnc)
  TYPE(occmat_5)           :: p(ehub_nnnc)
  TYPE(occmat_5)           :: num(nbnd)

  TYPE(occmat_4)           :: dm0
  TYPE(occmat_4)           :: dm1(ntyp,4)

  COMPLEX(DP)              :: kphase

  REAL(DP), ALLOCATABLE    :: ehub_v_(:,:,:,:)

  REAL(DP)                 :: arg
  REAL(DP)                 :: ntau(3,nat)
  REAL(DP)                 :: compute_eri
  REAL(DP)                 :: c1(6), c2(6), c3(6), c4(6)

  INTEGER                  :: npw, nw
  INTEGER                  :: i, ik, ibnd, is, ix
  INTEGER                  :: na, nt, m, l
  INTEGER                  :: na1, na2
  INTEGER                  :: nt1, nt2
  INTEGER                  :: m1, m2, m3, m4
  INTEGER                  :: l1, l2, l3, l4
  INTEGER                  :: n1, n2, n3
  INTEGER                  :: nnc, ics

  CALL start_clock('acbn0_ns_e0_1')

  IF ( stop_acbn0 ) THEN
     !
     IF ( MAXVAL(ehub_v_diff(:,:,:,:,:)) < SQRT(ehub_conv_thr) ) THEN
        CALL hp_acbn0_ns_v(ns)
        GOTO 1
     ENDIF
     !
     ehub_v_diff = 0.0_DP
     !
  ENDIF

  CALL allocate_bec_type(nwfcv, nbnd, proj)
  !
  ALLOCATE ( dm0%O(ehub_lm_max,ehub_lm_max,nspin,nat) ) ; dm0%O = 0.0_DP
  !
  DO nt = 1, ntyp
     DO l = 1, 4
        ALLOCATE ( dm1(nt,l)%O(ehub_lm_max,ehub_lm_max,nspin,nat) ) ; dm1(nt,l)%O = 0.0_DP
     ENDDO
  ENDDO
  !
  DO i = 1, ehub_nnnc
     ALLOCATE ( n(i)%O(ehub_lm_max,ehub_lm_max,nspin,nat,nat) ) ; n(i)%O = 0.0_DP
     ALLOCATE ( p(i)%O(ehub_lm_max,ehub_lm_max,nspin,nat,nat) ) ; p(i)%O = 0.0_DP
     ALLOCATE ( E0(i)%V(4,4,nat,nat), E0(i)%J(4,4,nat,nat) )
     ALLOCATE ( HF(i)%V(4,4,nat,nat), HF(i)%J(4,4,nat,nat) )
  ENDDO

  ics = ehub_csize + 1
  !
  DO ik = 1, nks
     !
     IF ( lsda ) current_spin = isk(ik)
     npw = ngk(ik)
     !
     ! projection < wfcv | evc >
     !
     IF ( nks > 1 ) CALL get_buffer(evc, nwordwfc, iunwfc, ik)
     IF ( nks > 1 ) CALL get_buffer(wfcv, nwordwfcv, iunhubv, ik)
     CALL calbec(npw, wfcv, evc, proj)
     !
     ! calculate the occupation matrices n
     !
     DO na1 = 1, nat
        nt1 = ityp(na1)
        !
        IF ( ehub_lm(nt1) == 0 ) CYCLE
        !
     DO na2 = na1, nat
        nt2 = ityp(na2)
        !
        IF ( ehub_lm(nt2) == 0 ) CYCLE
        !
        IF ( na1 /= na2 .AND. ehub_nn_vect(ics,ics,ics,na1,na2 ) == 0 ) CYCLE
        !
        DO m1 = 1, ehub_lm(nt1)
        DO m2 = 1, ehub_lm(nt2)
           !
           IF ( gamma_only ) THEN
              DO ibnd = 1, nbnd
                 n(1)%O(m1,m2,current_spin,na1,na2) = &
                 n(1)%O(m1,m2,current_spin,na1,na2) + &
                                        wg(ibnd,ik) * &
                         proj%r(ofstv(na2)+m2,ibnd) * &
                         proj%r(ofstv(na1)+m1,ibnd)
              ENDDO ! ibnd
           ELSE
              DO ibnd = 1, nbnd
                 n(1)%O(m1,m2,current_spin,na1,na2) = &
                 n(1)%O(m1,m2,current_spin,na1,na2) + &
                                        wg(ibnd,ik) * &
                    DBLE(proj%k(ofstv(na2)+m2,ibnd) * &
                   CONJG(proj%k(ofstv(na1)+m1,ibnd)))
              ENDDO ! ibnd
           ENDIF
           !
        ENDDO ! m2
        ENDDO ! m1
        !
     ENDDO ! na2
     ENDDO ! na1
     !
     DO na1 = 1, nat
        nt1 = ityp(na1)
        !
        IF ( ehub_lm(nt1) == 0 ) CYCLE
        !
     DO na2 = na1, nat
        nt2 = ityp(na2)
        !
        IF ( ehub_lm(nt2) == 0 ) CYCLE
        !
        IF ( ehub_nn_vect(ics,ics,ics,na1,na2) == 0 ) CYCLE
        !
        DO m1 = 1, ehub_lm(nt1)
        DO m2 = 1, ehub_lm(nt2)
           n(1)%O(m2,m1,current_spin,na2,na1) = n(1)%O(m1,m2,current_spin,na1,na2)
        ENDDO ! m2
        ENDDO ! m1
        !
     ENDDO ! na2
     ENDDO ! na1
     !
     nnc = 2
     !
     DO n1 = -1*ehub_nn_dim(1), ehub_nn_dim(1)
     DO n2 = -1*ehub_nn_dim(2), ehub_nn_dim(2)
     DO n3 = -1*ehub_nn_dim(3), ehub_nn_dim(3)
        !
        IF ( n1 == 0 .AND. n2 == 0 .AND. n3 == 0 ) CYCLE
        !
        arg = tpi * (                                              &
         xk(1,ik) * (n1 * at(1,1) + n2 * at(1,2) + n3 * at(1,3)) + &
         xk(2,ik) * (n1 * at(2,1) + n2 * at(2,2) + n3 * at(2,3)) + &
         xk(3,ik) * (n1 * at(3,1) + n2 * at(3,2) + n3 * at(3,3)))
        !
        kphase = CMPLX(COS(arg), SIN(arg), KIND=DP)
        !
        DO na1 = 1, nat
           nt1 = ityp(na1)
           !
           IF ( ehub_lm(nt1) == 0 ) CYCLE
           !
        DO na2 = 1, nat
           nt2 = ityp(na2)
           !
           IF ( ehub_lm(nt2) == 0 ) CYCLE
           !
           IF ( ehub_nn_vect(n1+ics,n2+ics,n3+ics,na1,na2) == 0 ) CYCLE
           !
           DO m1 = 1, ehub_lm(nt1)
           DO m2 = 1, ehub_lm(nt2)
              !
              IF ( gamma_only ) THEN
                 DO ibnd = 1, nbnd
                    n(nnc)%O(m1,m2,current_spin,na1,na2) = &
                    n(nnc)%O(m1,m2,current_spin,na1,na2) + &
                                             wg(ibnd,ik) * &
                              proj%r(ofstv(na2)+m2,ibnd) * &
                              proj%r(ofstv(na1)+m1,ibnd)
                 ENDDO ! ibnd
              ELSE
                 DO ibnd = 1, nbnd
                    n(nnc)%O(m1,m2,current_spin,na1,na2) = &
                    n(nnc)%O(m1,m2,current_spin,na1,na2) + &
                                             wg(ibnd,ik) * &
                                           DBLE((kphase) * &
                              proj%k(ofstv(na2)+m2,ibnd) * &
                        CONJG(proj%k(ofstv(na1)+m1,ibnd)))
                 ENDDO ! ibnd
              ENDIF
              !
           ENDDO ! m2
           ENDDO ! m1
           !
        ENDDO ! na2
        ENDDO ! na1
        !
        IF ( MAXVAL(ehub_nn_vect(n1+ics,n2+ics,n3+ics,:,:)) == 1 ) nnc = nnc + 1
        !
     ENDDO ! n3
     ENDDO ! n2
     ENDDO ! n1
     !
     ! calculate the renormalized occupations N(ACBN0)
     !
     DO i = 1, nbnd
        ALLOCATE ( num(i)%O(4,4,nspin,ntyp,ntyp) ) ; num(i)%O = 0.0_DP
        ALLOCATE ( num(i)%T(4,4,nspin,ntyp,ntyp) ) ; num(i)%T = 0.0_DP
     ENDDO
     !
     DO na = 1, nat
        nt = ityp(na)
        !
        IF ( ehub_lm(nt) == 0 ) CYCLE
        !
        DO m = 1, ehub_lm(nt)
           !
           l = ehub_l(m,nt)
           !
           IF ( gamma_only ) THEN
              DO ibnd = 1, nbnd
                 num(ibnd)%O(l,l,current_spin,nt,nt) = &
                 num(ibnd)%O(l,l,current_spin,nt,nt) + &
                            proj%r(ofstv(na)+m,ibnd) * &
                            proj%r(ofstv(na)+m,ibnd)
              ENDDO ! ibnd
           ELSE
              DO ibnd = 1, nbnd
                 num(ibnd)%O(l,l,current_spin,nt,nt) = &
                 num(ibnd)%O(l,l,current_spin,nt,nt) + &
                       DBLE(proj%k(ofstv(na)+m,ibnd) * &
                      CONJG(proj%k(ofstv(na)+m,ibnd)))
              ENDDO ! ibnd
           ENDIF
           !
        ENDDO ! m
        !
     ENDDO ! na
     !
     DO ibnd = 1, nbnd
        !
        DO nt1 = 1, ntyp
        DO nt2 = 1, ntyp
           !
           IF ( upf(nt1)%psd /= upf(nt2)%psd ) CYCLE
           !
           num(ibnd)%T(:,:,:,nt1,nt1) = num(ibnd)%T(:,:,:,nt1,nt1) + &
                                        num(ibnd)%O(:,:,:,nt2,nt2)
           !
        ENDDO ! nt2
        ENDDO ! nt1
        !
     ENDDO ! ibnd
     !
     DO ibnd = 1, nbnd
        !
        DO nt1 = 1, ntyp
        DO nt2 = 1, ntyp
           !
           DO l1 = 1, 4
           DO l2 = 1, 4
              !
              ! Our definition
              num(ibnd)%T(l1,l2,:,nt1,nt2) = num(ibnd)%T(l1,l1,:,nt1,nt1) + &
                                             num(ibnd)%T(l2,l2,:,nt2,nt2)
              !
              IF ( upf(nt1)%psd == upf(nt2)%psd )                           &
              num(ibnd)%T(l1,l2,:,nt1,nt2) = num(ibnd)%T(l1,l2,:,nt1,nt2) / &
                                             2.0_DP
              !
              ! The definition of Nicolas Tancogne-Dejean & Angel Rubio
!             num(ibnd)%T(l1,l2,:,nt1,nt2) = SQRT(num(ibnd)%T(l1,l1,:,nt1,nt1) * &
!                                                 num(ibnd)%T(l2,l2,:,nt2,nt2))
              !
           ENDDO ! l2
           ENDDO ! l1
           !
        ENDDO ! nt2
        ENDDO ! nt1
        !
     ENDDO ! ibnd
     !
     DO ibnd = 1, nbnd
        num(ibnd)%O = num(ibnd)%T
        DEALLOCATE ( num(ibnd)%T )
     ENDDO
     !
     ! calculate the renormalized occupation matrices P(ACBN0)
     !
     ! 1) P^II (dm0, dm1)
     !
     DO na = 1, nat
        nt = ityp(na)
        !
        IF ( ehub_lm(nt) == 0 ) CYCLE
        !
        DO m1 = 1, ehub_lm(nt)
           !
           l1 = ehub_l(m1,nt)
           !
        DO m2 = 1, ehub_lm(nt)
           !
           l2 = ehub_l(m2,nt)
           !
           IF ( gamma_only ) THEN
              DO ibnd = 1, nbnd
                 dm0%O(m1,m2,current_spin,na) = &
                 dm0%O(m1,m2,current_spin,na) + &
                           num(ibnd)%O(l1,l2,   &
                          current_spin,nt,nt) * &
                                  wg(ibnd,ik) * &
                    proj%r(ofstv(na)+m2,ibnd) * &
                    proj%r(ofstv(na)+m1,ibnd)
              ENDDO ! ibnd
           ELSE
              DO ibnd = 1, nbnd
                 dm0%O(m1,m2,current_spin,na) = &
                 dm0%O(m1,m2,current_spin,na) + &
                           num(ibnd)%O(l1,l2,   &
                          current_spin,nt,nt) * &
                                  wg(ibnd,ik) * &
               DBLE(proj%k(ofstv(na)+m2,ibnd) * &
              CONJG(proj%k(ofstv(na)+m1,ibnd)))
              ENDDO ! ibnd
           ENDIF
           !
        ENDDO ! m2
        ENDDO ! m1
        !
     ENDDO ! na

     DO nt = 1, ntyp
        !
        IF ( ehub_lm(nt) == 0 ) CYCLE
        !
        DO l = 1, 4
           !
           DO na1 = 1, nat
              nt1 = ityp(na1)
              !
              IF ( ehub_lm(nt1) == 0 ) CYCLE
              !
              DO m1 = 1, ehub_lm(nt1)
              DO m2 = 1, ehub_lm(nt1)
                 !
                 IF ( gamma_only ) THEN
                    DO ibnd = 1, nbnd
                       dm1(nt,l)%O(m1,m2,current_spin,na1) = &
                       dm1(nt,l)%O(m1,m2,current_spin,na1) + &
                             num(ibnd)%O(ehub_l(m1,nt1),l,   &
                                      current_spin,nt1,nt) * &
                                               wg(ibnd,ik) * &
                                proj%r(ofstv(na1)+m2,ibnd) * &
                                proj%r(ofstv(na1)+m1,ibnd)
                    ENDDO ! ibnd
                 ELSE
                    DO ibnd = 1, nbnd
                       dm1(nt,l)%O(m1,m2,current_spin,na1) = &
                       dm1(nt,l)%O(m1,m2,current_spin,na1) + &
                             num(ibnd)%O(ehub_l(m1,nt1),l,   &
                                      current_spin,nt1,nt) * &
                                               wg(ibnd,ik) * &
                           DBLE(proj%k(ofstv(na1)+m2,ibnd) * &
                          CONJG(proj%k(ofstv(na1)+m1,ibnd)))
                    ENDDO ! ibnd
                 ENDIF
                 !
              ENDDO ! m2
              ENDDO ! m1
              !
           ENDDO ! na1
           !
        ENDDO ! l
        !
     ENDDO ! nt
     !
     ! 2) P^IJ
     !
     DO na1 = 1, nat
        nt1 = ityp(na1)
        !
        IF ( ehub_lm(nt1) == 0 ) CYCLE
        !
     DO na2 = na1, nat
        nt2 = ityp(na2)
        !
        IF ( ehub_lm(nt2) == 0 ) CYCLE
        !
        IF ( ehub_nn_vect(ics,ics,ics,na1,na2) == 0 ) CYCLE
        !
        DO m1 = 1, ehub_lm(nt1)
           !
           l1 = ehub_l(m1,nt1)
           !
        DO m2 = 1, ehub_lm(nt2)
           !
           l2 = ehub_l(m2,nt2)
           !
           IF ( gamma_only ) THEN
              DO ibnd = 1, nbnd
                   p(1)%O(m1,m2,current_spin,na1,na2) = &
                   p(1)%O(m1,m2,current_spin,na1,na2) + &
                                   num(ibnd)%O(l1,l2,   &
                                current_spin,nt1,nt2) * &
                                          wg(ibnd,ik) * &
                           proj%r(ofstv(na2)+m2,ibnd) * &
                           proj%r(ofstv(na1)+m1,ibnd)
              ENDDO ! ibnd
           ELSE
              DO ibnd = 1, nbnd
                   p(1)%O(m1,m2,current_spin,na1,na2) = &
                   p(1)%O(m1,m2,current_spin,na1,na2) + &
                                   num(ibnd)%O(l1,l2,   &
                                current_spin,nt1,nt2) * &
                                          wg(ibnd,ik) * &
                      DBLE(proj%k(ofstv(na2)+m2,ibnd) * &
                     CONJG(proj%k(ofstv(na1)+m1,ibnd)))
              ENDDO ! ibnd
           ENDIF
           !
        ENDDO ! m2
        ENDDO ! m1
        !
     ENDDO ! na2
     ENDDO ! na1
     !
     DO na1 = 1, nat
        nt1 = ityp(na1)
        !
        IF ( ehub_lm(nt1) == 0 ) CYCLE
        !
     DO na2 = na1, nat
        nt2 = ityp(na2)
        !
        IF ( ehub_lm(nt2) == 0 ) CYCLE
        !
        IF ( ehub_nn_vect(ics,ics,ics,na1,na2) == 0 ) CYCLE
        !
        DO m1 = 1, ehub_lm(nt1)
        DO m2 = 1, ehub_lm(nt2)
           p(1)%O(m2,m1,current_spin,na2,na1) = p(1)%O(m1,m2,current_spin,na1,na2)
        ENDDO ! m2
        ENDDO ! m1
        !
     ENDDO ! na2
     ENDDO ! na1
     !
     nnc = 2
     !
     DO n1 = -1*ehub_nn_dim(1), ehub_nn_dim(1)
     DO n2 = -1*ehub_nn_dim(2), ehub_nn_dim(2)
     DO n3 = -1*ehub_nn_dim(3), ehub_nn_dim(3)
        !
        IF ( n1 == 0 .AND. n2 == 0 .AND. n3 == 0 ) CYCLE
        !
        arg = tpi * (                                              &
         xk(1,ik) * (n1 * at(1,1) + n2 * at(1,2) + n3 * at(1,3)) + &
         xk(2,ik) * (n1 * at(2,1) + n2 * at(2,2) + n3 * at(2,3)) + &
         xk(3,ik) * (n1 * at(3,1) + n2 * at(3,2) + n3 * at(3,3)))
        !
        kphase = CMPLX(COS(arg), SIN(arg), KIND=DP)
        !
        DO na1 = 1, nat
           nt1 = ityp(na1)
           !
           IF ( ehub_lm(nt1) == 0 ) CYCLE
           !
        DO na2 = 1, nat
           nt2 = ityp(na2)
           !
           IF ( ehub_lm(nt2) == 0 ) CYCLE
           !
           IF ( ehub_nn_vect(n1+ics,n2+ics,n3+ics,na1,na2) == 0 ) CYCLE
           !
           DO m1 = 1, ehub_lm(nt1)
              !
              l1 = ehub_l(m1,nt1)
              !
           DO m2 = 1, ehub_lm(nt2)
              !
              l2 = ehub_l(m2,nt2)
              !
              IF ( gamma_only ) THEN
                 DO ibnd = 1, nbnd
                    p(nnc)%O(m1,m2,current_spin,na1,na2) = &
                    p(nnc)%O(m1,m2,current_spin,na1,na2) + &
                                      num(ibnd)%O(l1,l2,   &
                                   current_spin,nt1,nt2) * &
                                             wg(ibnd,ik) * &
                              proj%r(ofstv(na2)+m2,ibnd) * &
                              proj%r(ofstv(na1)+m1,ibnd)
                 ENDDO ! ibnd
              ELSE
                 DO ibnd = 1, nbnd
                    p(nnc)%O(m1,m2,current_spin,na1,na2) = &
                    p(nnc)%O(m1,m2,current_spin,na1,na2) + &
                                      num(ibnd)%O(l1,l2,   &
                                   current_spin,nt1,nt2) * &
                                             wg(ibnd,ik) * &
                                           DBLE((kphase) * &
                              proj%k(ofstv(na2)+m2,ibnd) * &
                        CONJG(proj%k(ofstv(na1)+m1,ibnd)))
                 ENDDO ! ibnd
              ENDIF
              !
           ENDDO ! m2
           ENDDO ! m1
           !
        ENDDO ! na2
        ENDDO ! na1
        !
        IF ( MAXVAL(ehub_nn_vect(n1+ics,n2+ics,n3+ics,:,:)) == 1 ) nnc = nnc + 1
        !
     ENDDO ! n3
     ENDDO ! n2
     ENDDO ! n1
     !
     DO i = 1, nbnd
        DEALLOCATE ( num(i)%O )
     ENDDO

  ENDDO ! ik

  CALL deallocate_bec_type(proj)

  CALL mp_sum(dm0%O, inter_pool_comm)
  !
  DO nt = 1, ntyp
     DO l = 1, 4
        CALL mp_sum(dm1(nt,l)%O, inter_pool_comm)
     ENDDO
  ENDDO
  !
  DO i = 1, ehub_nnnc
     CALL mp_sum(n(i)%O, inter_pool_comm)
     CALL mp_sum(p(i)%O, inter_pool_comm)
  ENDDO

  DO i = 1, ehub_nnnc
     IF ( nspin == 1 ) n(i)%O = 0.5_DP * n(i)%O
  ENDDO
  !
  CALL hp_acbn0_symm_n5(n)
  !
  ns = 0.0_DP
  !
  DO i = 1, ehub_nnnc
     ns(:,:,:,:,:,i) = n(i)%O(:,:,:,:,:)
     DEALLOCATE ( n(i)%O )
  ENDDO
  !
  IF ( nspin == 1 ) dm0%O = 0.5_DP * dm0%O
  !
  CALL hp_acbn0_symm_n4_v(dm0)
  !
  DO nt = 1, ntyp
     DO l = 1, 4
        IF ( nspin == 1 ) dm1(nt,l)%O = 0.5_DP * dm1(nt,l)%O
     ENDDO
  ENDDO
  !
  CALL hp_acbn0_symm_n4m(dm1)
  !
  DO i = 1, ehub_nnnc
     IF ( nspin == 1 ) p(i)%O = 0.5_DP * p(i)%O
  ENDDO
  !
  CALL hp_acbn0_symm_n5(p)
  !
  ! on-site interaction: U_ij^II
  !
  E0(1)%V = 0.0_DP ; E0(1)%J = 0.0_DP
  !
  DO na = 1, nat
     nt = ityp(na)
     !
     IF ( ehub_lm(nt) == 0 ) CYCLE
     !
     l1 = 0
     DO m1 = 1, ehub_lm(nt)
        CALL hp_acbn0_orberi(ehub_l(m1,nt), l1)
        CALL pao_3g(upf(nt)%psd, ehub_l(m1,nt), c1)
        !
     l2 = 0
     DO m2 = 1, ehub_lm(nt)
        CALL hp_acbn0_orberi(ehub_l(m2,nt), l2)
        CALL pao_3g(upf(nt)%psd, ehub_l(m2,nt), c2)
        !
     l3 = 0
     DO m3 = 1, ehub_lm(nt)
        IF ( ehub_l(m3,nt) /= ehub_l(m1,nt) ) CYCLE
        CALL hp_acbn0_orberi(ehub_l(m3,nt), l3)
        CALL pao_3g(upf(nt)%psd, ehub_l(m3,nt), c3)
        !
     l4 = 0
     DO m4 = 1, ehub_lm(nt)
        IF ( ehub_l(m4,nt) /= ehub_l(m2,nt) ) CYCLE
        CALL hp_acbn0_orberi(ehub_l(m4,nt), l4)
        CALL pao_3g(upf(nt)%psd, ehub_l(m4,nt), c4)
        !
        IF ( ehub_l(m1,nt) == 1 .AND. ehub_l(m2,nt) == 1 ) THEN
           E0(1)%V(ehub_l(m1,nt),ehub_l(m2,nt),na,na)  = &
           E0(1)%V(ehub_l(m1,nt),ehub_l(m2,nt),na,na)  + &
                 (dm0%O(m3,m1,1,na)*dm0%O(m4,m2,2,na)  + &
                  dm0%O(m3,m1,2,na)*dm0%O(m4,m2,1,na)) * &
                             compute_eri(l3,l1,l4,l2,    &
                       tau(:,na)*alat,tau(:,na)*alat,    &
                       tau(:,na)*alat,tau(:,na)*alat,    &
                                         c3,c1,c4,c2)
        ELSE
           E0(1)%V(ehub_l(m1,nt),ehub_l(m2,nt),na,na)  = &
           E0(1)%V(ehub_l(m1,nt),ehub_l(m2,nt),na,na)  + &
                 (dm0%O(m3,m1,1,na)*dm0%O(m4,m2,1,na)  + &
                  dm0%O(m3,m1,2,na)*dm0%O(m4,m2,2,na)  + &
                  dm0%O(m3,m1,1,na)*dm0%O(m4,m2,2,na)  + &
                  dm0%O(m3,m1,2,na)*dm0%O(m4,m2,1,na)) * &
                             compute_eri(l3,l1,l4,l2,    &
                       tau(:,na)*alat,tau(:,na)*alat,    &
                       tau(:,na)*alat,tau(:,na)*alat,    &
                                         c3,c1,c4,c2)

           E0(1)%J(ehub_l(m1,nt),ehub_l(m2,nt),na,na)  = &
           E0(1)%J(ehub_l(m1,nt),ehub_l(m2,nt),na,na)  + &
                 (dm0%O(m3,m1,1,na)*dm0%O(m4,m2,1,na)  + &
                  dm0%O(m3,m1,2,na)*dm0%O(m4,m2,2,na)) * &
                             compute_eri(l3,l2,l4,l1,    &
                       tau(:,na)*alat,tau(:,na)*alat,    &
                       tau(:,na)*alat,tau(:,na)*alat,    &
                                         c3,c2,c4,c1)
        ENDIF
        !
     ENDDO ! m4
     ENDDO ! m3
     ENDDO ! m2
     ENDDO ! m1
     !
  ENDDO ! na
  !
  HF(1)%V = 0.0_DP ; HF(1)%J = 0.0_DP
  !
  DO na = 1, nat
     nt = ityp(na)
     !
     IF ( ehub_lm(nt) == 0 ) CYCLE
     !
     DO m1 = 1, ehub_lm(nt)
     DO m2 = 1, ehub_lm(nt)
        !
        IF ( m1 == m2 ) THEN
            HF(1)%V(ehub_l(m1,nt),ehub_l(m2,nt),na,na) = &
            HF(1)%V(ehub_l(m1,nt),ehub_l(m2,nt),na,na) + &
             ns(m1,m1,1,na,na,1) * ns(m2,m2,2,na,na,1) + &
             ns(m1,m1,2,na,na,1) * ns(m2,m2,1,na,na,1)
        ELSE
            HF(1)%V(ehub_l(m1,nt),ehub_l(m2,nt),na,na) = &
            HF(1)%V(ehub_l(m1,nt),ehub_l(m2,nt),na,na) + &
             ns(m1,m1,1,na,na,1) * ns(m2,m2,1,na,na,1) + &
             ns(m1,m1,2,na,na,1) * ns(m2,m2,2,na,na,1) + &
             ns(m1,m1,1,na,na,1) * ns(m2,m2,2,na,na,1) + &
             ns(m1,m1,2,na,na,1) * ns(m2,m2,1,na,na,1)

            HF(1)%J(ehub_l(m1,nt),ehub_l(m2,nt),na,na) = &
            HF(1)%J(ehub_l(m1,nt),ehub_l(m2,nt),na,na) + &
             ns(m1,m1,1,na,na,1) * ns(m2,m2,1,na,na,1) + &
             ns(m1,m1,2,na,na,1) * ns(m2,m2,2,na,na,1)
        ENDIF
        !
     ENDDO ! m2
     ENDDO ! m1
     !
  ENDDO ! na
  !
  ALLOCATE ( ehub_v_(nat,nat,ehub_lm_max,ehub_lm_max) ) ; ehub_v_ = 0.0_DP
  !
  DO na = 1, nat
     nt = ityp(na)
     !
     IF ( ehub_lm(nt) == 0 ) CYCLE
     !
     DO m1 = 1, ehub_lm(nt)
     DO m2 = 1, ehub_lm(nt)
        !
        IF ( ehub_l(m1,nt) == 1 .AND. ehub_l(m2,nt) == 1 ) THEN
           ehub_v_(na,na,m1,m2) =                           &
               E0(1)%V(ehub_l(m1,nt),ehub_l(m2,nt),na,na) / &
               HF(1)%V(ehub_l(m1,nt),ehub_l(m2,nt),na,na) * &
                          remove_ehub_u(nt,ehub_l(m1,nt)) * &
                          remove_ehub_u(nt,ehub_l(m2,nt))
        ELSE
           ehub_v_(na,na,m1,m2) =                            &
              (E0(1)%V(ehub_l(m1,nt),ehub_l(m2,nt),na,na)  / &
               HF(1)%V(ehub_l(m1,nt),ehub_l(m2,nt),na,na)  - &
               E0(1)%J(ehub_l(m1,nt),ehub_l(m2,nt),na,na)  / &
               HF(1)%J(ehub_l(m1,nt),ehub_l(m2,nt),na,na)) * &
                          remove_ehub_u(nt,ehub_l(m1,nt))  * &
                          remove_ehub_u(nt,ehub_l(m2,nt))
        ENDIF
        !
        IF ( stop_acbn0 ) ehub_v_diff(na,na,m1,m2,1) = ABS( ehub_v (na,na,m1,m2,1) &
                                                     -      ehub_v_(na,na,m1,m2  ) )
        !
        ehub_v(na,na,m1,m2,1)                                 &
            = (1.0_DP - ehub_mixing)*ehub_v (na,na,m1,m2,1) + &
              (         ehub_mixing)*ehub_v_(na,na,m1,m2)
        !
     ENDDO ! m2
     ENDDO ! m1
     !
  ENDDO ! na

  !
  ! inter-site interaction: U_ij^IJ (I /= J)
  !
  ! ... in the unit cell
  !
  E0(1)%V = 0.0_DP
  !
  DO na1 = 1, nat
     nt1 = ityp(na1)
     !
     IF ( ehub_lm(nt1) == 0 ) CYCLE
     !
  DO na2 = na1, nat
     nt2 = ityp(na2)
     !
     IF ( ehub_lm(nt2) == 0 ) CYCLE
     !
     IF ( ehub_nn_vect(ics,ics,ics,na1,na2) == 0 ) CYCLE
     !
     l1 = 0
     DO m1 = 1, ehub_lm(nt1)
        CALL hp_acbn0_orberi(ehub_l(m1,nt1), l1)
        CALL pao_3g(upf(nt1)%psd, ehub_l(m1,nt1), c1)
        !
     l2 = 0
     DO m2 = 1, ehub_lm(nt2)
        CALL hp_acbn0_orberi(ehub_l(m2,nt2), l2)
        CALL pao_3g(upf(nt2)%psd, ehub_l(m2,nt2), c2)
        !
     l3 = 0
     DO m3 = 1, ehub_lm(nt1)
        IF ( ehub_l(m3,nt1) /= ehub_l(m1,nt1) ) CYCLE
        CALL hp_acbn0_orberi(ehub_l(m3,nt1), l3)
        CALL pao_3g(upf(nt1)%psd, ehub_l(m3,nt1), c3)
        !
     l4 = 0
     DO m4 = 1, ehub_lm(nt2)
        IF ( ehub_l(m4,nt2) /= ehub_l(m2,nt2) ) CYCLE
        CALL hp_acbn0_orberi(ehub_l(m4,nt2), l4)
        CALL pao_3g(upf(nt2)%psd, ehub_l(m4,nt2), c4)
        !
        E0(1)%V(ehub_l(m1,nt1),ehub_l(m2,nt2),na1,na2)  = &
        E0(1)%V(ehub_l(m1,nt1),ehub_l(m2,nt2),na1,na2)  + &
               (dm1(nt2,ehub_l(m2,nt2))%O(m3,m1,1,na1)  * &
                dm1(nt1,ehub_l(m1,nt1))%O(m4,m2,1,na2)  + &
                dm1(nt2,ehub_l(m2,nt2))%O(m3,m1,2,na1)  * &
                dm1(nt1,ehub_l(m1,nt1))%O(m4,m2,2,na2)  + &
                dm1(nt2,ehub_l(m2,nt2))%O(m3,m1,1,na1)  * &
                dm1(nt1,ehub_l(m1,nt1))%O(m4,m2,2,na2)  + &
                dm1(nt2,ehub_l(m2,nt2))%O(m3,m1,2,na1)  * &
                dm1(nt1,ehub_l(m1,nt1))%O(m4,m2,1,na2)  - &
                               p(1)%O(m3,m2,1,na1,na2)  * &
                               p(1)%O(m4,m1,1,na2,na1)  - &
                               p(1)%O(m3,m2,2,na1,na2)  * &
                               p(1)%O(m4,m1,2,na2,na1)) * &
                              compute_eri(l3,l1,l4,l2,    &
                      tau(:,na1)*alat,tau(:,na1)*alat,    &
                      tau(:,na2)*alat,tau(:,na2)*alat,    &
                                          c3,c1,c4,c2)
        !
     ENDDO ! m4
     ENDDO ! m3
     ENDDO ! m2
     ENDDO ! m1
     !
  ENDDO ! na2
  ENDDO ! na1
  !
  DO na1 = 1, nat
     nt1 = ityp(na1)
     !
     IF ( ehub_lm(nt1) == 0 ) CYCLE
     !
  DO na2 = na1, nat
     nt2 = ityp(na2)
     !
     IF ( ehub_lm(nt2) == 0 ) CYCLE
     !
     IF ( ehub_nn_vect(ics,ics,ics,na1,na2) == 0 ) CYCLE
     !
     DO m1 = 1, ehub_lm(nt1)
     DO m2 = 1, ehub_lm(nt2)
        !
        E0(1)%V(ehub_l(m2,nt2),ehub_l(m1,nt1),na2,na1) = E0(1)%V(ehub_l(m1,nt1),ehub_l(m2,nt2),na1,na2)
        !
     ENDDO ! m2
     ENDDO ! m1
     !
  ENDDO ! na2
  ENDDO ! na1
  !
  HF(1)%V = 0.0_DP
  !
  DO na1 = 1, nat
     nt1 = ityp(na1)
     !
     IF ( ehub_lm(nt1) == 0 ) CYCLE
     !
  DO na2 = na1, nat
     nt2 = ityp(na2)
     !
     IF ( ehub_lm(nt2) == 0 ) CYCLE
     !
     IF ( ehub_nn_vect(ics,ics,ics,na1,na2) == 0) CYCLE
     !
     DO m1 = 1, ehub_lm(nt1)
     DO m2 = 1, ehub_lm(nt2)
        !
        HF(1)%V(ehub_l(m1,nt1),ehub_l(m2,nt2),na1,na2) = &
        HF(1)%V(ehub_l(m1,nt1),ehub_l(m2,nt2),na1,na2) + &
         ns(m1,m1,1,na1,na1,1) * ns(m2,m2,1,na2,na2,1) + &
         ns(m1,m1,2,na1,na1,1) * ns(m2,m2,2,na2,na2,1) + &
         ns(m1,m1,1,na1,na1,1) * ns(m2,m2,2,na2,na2,1) + &
         ns(m1,m1,2,na1,na1,1) * ns(m2,m2,1,na2,na2,1) - &
         ns(m1,m2,1,na1,na2,1) * ns(m2,m1,1,na2,na1,1) - &
         ns(m1,m2,2,na1,na2,1) * ns(m2,m1,2,na2,na1,1)
        !
     ENDDO ! m2
     ENDDO ! m1
     !
  ENDDO ! na2
  ENDDO ! na1
  !
  DO na1 = 1, nat
     nt1 = ityp(na1)
     !
     IF ( ehub_lm(nt1) == 0 ) CYCLE
     !
  DO na2 = na1, nat
     nt2 = ityp(na2)
     !
     IF ( ehub_lm(nt2) == 0 ) CYCLE
     !
     IF ( ehub_nn_vect(ics,ics,ics,na1,na2) == 0 ) CYCLE
     !
     DO m1 = 1, ehub_lm(nt1)
     DO m2 = 1, ehub_lm(nt2)
        HF(1)%V(ehub_l(m2,nt2),ehub_l(m1,nt1),na2,na1) = HF(1)%V(ehub_l(m1,nt1),ehub_l(m2,nt2),na1,na2)
     ENDDO ! m2
     ENDDO ! m1
     !
  ENDDO ! na2
  ENDDO ! na1
  !
  DO na1 = 1, nat
     nt1 = ityp(na1)
     !
     IF ( ehub_lm(nt1) == 0 ) CYCLE
     !
  DO na2 = 1, nat
     nt2 = ityp(na2)
     !
     IF ( ehub_lm(nt2) == 0 ) CYCLE
     !
     IF ( ehub_nn_vect(ics,ics,ics,na1,na2) == 0 ) CYCLE
     !
     DO m1 = 1, ehub_lm(nt1)
        !
        l1 = ehub_l(m1,nt1)
        !
     DO m2 = 1, ehub_lm(nt2)
        !
        l2 = ehub_l(m2,nt2)
        !
        ehub_v_(na1,na2,m1,m2) = &
               (E0(1)%V(l1,l2,na1,na2) / HF(1)%V(l1,l2,na1,na2)) / 2.0_DP
        !
        IF ( stop_acbn0 ) ehub_v_diff(na1,na2,m1,m2,1) = ABS( ehub_v (na1,na2,m1,m2,1) &
                                                       -      ehub_v_(na1,na2,m1,m2  ) )
        !
        ehub_v(na1,na2,m1,m2,1)                                 &
            = (1.0_DP - ehub_mixing)*ehub_v (na1,na2,m1,m2,1) + &
              (         ehub_mixing)*ehub_v_(na1,na2,m1,m2)
        !
     ENDDO ! m2
     ENDDO ! m1
     !
  ENDDO ! na2
  ENDDO ! na1
  !
  ! ... out of the unit cell
  !
  DO i = 2, ehub_nnnc
     E0(i)%V = 0.0_DP
  ENDDO
  !
  nnc = 2
  !
  DO n1 = -1*ehub_nn_dim(1), ehub_nn_dim(1)
  DO n2 = -1*ehub_nn_dim(2), ehub_nn_dim(2)
  DO n3 = -1*ehub_nn_dim(3), ehub_nn_dim(3)
     !
     IF ( n1 == 0 .AND. n2 == 0 .AND. n3 == 0 ) CYCLE
     !
     DO na1 = 1, nat
        nt1 = ityp(na1)
        !
        IF ( ehub_lm(nt1) == 0 ) CYCLE
        !
     DO na2 = 1, nat
        nt2 = ityp(na2)
        !
        IF ( ehub_lm(nt2) == 0 ) CYCLE
        !
        IF ( ehub_nn_vect(n1+ics,n2+ics,n3+ics,na1,na2) == 0 ) CYCLE
        !
        DO ix = 1, 3
           ntau(ix,na2) = n1 * at(ix,1) + n2 * at(ix,2) + n3 * at(ix,3) + tau(ix,na2)
        ENDDO
        !
        l1 = 0
        DO m1 = 1, ehub_lm(nt1)
           CALL hp_acbn0_orberi(ehub_l(m1,nt1), l1)
           CALL pao_3g(upf(nt1)%psd, ehub_l(m1,nt1), c1)
           !
        l2 = 0
        DO m2 = 1, ehub_lm(nt2)
           CALL hp_acbn0_orberi(ehub_l(m2,nt2), l2)
           CALL pao_3g(upf(nt2)%psd, ehub_l(m2,nt2), c2)
           !
        l3 = 0
        DO m3 = 1, ehub_lm(nt1)
           IF ( ehub_l(m3,nt1) /= ehub_l(m1,nt1) ) CYCLE
           CALL hp_acbn0_orberi(ehub_l(m3,nt1), l3)
           CALL pao_3g(upf(nt1)%psd, ehub_l(m3,nt1), c3)
           !
        l4 = 0
        DO m4 = 1, ehub_lm(nt2)
           IF ( ehub_l(m4,nt2) /= ehub_l(m2,nt2) ) CYCLE
           CALL hp_acbn0_orberi(ehub_l(m4,nt2), l4)
           CALL pao_3g(upf(nt2)%psd, ehub_l(m4,nt2), c4)
           !
           E0(nnc)%V(ehub_l(m1,nt1),ehub_l(m2,nt2),na1,na2)  = &
           E0(nnc)%V(ehub_l(m1,nt1),ehub_l(m2,nt2),na1,na2)  + &
                    (dm1(nt2,ehub_l(m2,nt2))%O(m3,m1,1,na1)  * &
                     dm1(nt1,ehub_l(m1,nt1))%O(m4,m2,1,na2)  + &
                     dm1(nt2,ehub_l(m2,nt2))%O(m3,m1,2,na1)  * &
                     dm1(nt1,ehub_l(m1,nt1))%O(m4,m2,2,na2)  + &
                     dm1(nt2,ehub_l(m2,nt2))%O(m3,m1,1,na1)  * &
                     dm1(nt1,ehub_l(m1,nt1))%O(m4,m2,2,na2)  + &
                     dm1(nt2,ehub_l(m2,nt2))%O(m3,m1,2,na1)  * &
                     dm1(nt1,ehub_l(m1,nt1))%O(m4,m2,1,na2)  - &
                                  p(nnc)%O(m3,m2,1,na1,na2)  * &
                                  p(nnc)%O(m1,m4,1,na1,na2)  - &
                                  p(nnc)%O(m3,m2,2,na1,na2)  * &
                                  p(nnc)%O(m1,m4,2,na1,na2)) * &
                                   compute_eri(l3,l1,l4,l2,    &
                          tau(:,na1)*alat, tau(:,na1)*alat,    &
                         ntau(:,na2)*alat,ntau(:,na2)*alat,    &
                                               c3,c1,c4,c2)
           !
        ENDDO ! m4
        ENDDO ! m3
        ENDDO ! m2
        ENDDO ! m1
        !
     ENDDO ! na2
     ENDDO ! na1
     !
     IF ( MAXVAL(ehub_nn_vect(n1+ics,n2+ics,n3+ics,:,:)) == 1 ) nnc = nnc + 1
     !
  ENDDO ! n3
  ENDDO ! n2
  ENDDO ! n1
  !
  DEALLOCATE ( dm0%O )
  !
  DO nt = 1, ntyp
     DO l = 1, 4
        DEALLOCATE ( dm1(nt,l)%O )
     ENDDO
  ENDDO
  !
  DO i = 2, ehub_nnnc
     HF(i)%V = 0.0_DP
  ENDDO
  !
  nnc = 2
  !
  DO n1 = -1*ehub_nn_dim(1), ehub_nn_dim(1)
  DO n2 = -1*ehub_nn_dim(2), ehub_nn_dim(2)
  DO n3 = -1*ehub_nn_dim(3), ehub_nn_dim(3)
     !
     IF ( n1 == 0 .AND. n2 == 0 .AND. n3 == 0 ) CYCLE
     !
     DO na1 = 1, nat
        nt1 = ityp(na1)
        !
        IF ( ehub_lm(nt1) == 0 ) CYCLE
        !
     DO na2 = 1, nat
        nt2 = ityp(na2)
        !
        IF ( ehub_lm(nt2) == 0 ) CYCLE
        !
        IF ( ehub_nn_vect(n1+ics,n2+ics,n3+ics,na1,na2) == 0 ) CYCLE
        !
        DO m1 = 1, ehub_lm(nt1)
           !
           l1 = ehub_l(m1,nt1)
           !
        DO m2 = 1, ehub_lm(nt2)
           !
           l2 = ehub_l(m2,nt2)
           !
           HF(nnc)%V(l1,l2,na1,na2) = HF(nnc)%V(l1,l2,na1,na2) + &
               ns(m1,m1,1,na1,na1,  1)*ns(m2,m2,1,na2,na2,  1) + &
               ns(m1,m1,2,na1,na1,  1)*ns(m2,m2,2,na2,na2,  1) + &
               ns(m1,m1,1,na1,na1,  1)*ns(m2,m2,2,na2,na2,  1) + &
               ns(m1,m1,2,na1,na1,  1)*ns(m2,m2,1,na2,na2,  1) - &
               ns(m1,m2,1,na1,na2,nnc)*ns(m1,m2,1,na1,na2,nnc) - &
               ns(m1,m2,2,na1,na2,nnc)*ns(m1,m2,2,na1,na2,nnc)
           !
        ENDDO ! m2
        ENDDO ! m1
        !
     ENDDO ! na2
     ENDDO ! na1
     !
     IF ( MAXVAL(ehub_nn_vect(n1+ics,n2+ics,n3+ics,:,:)) == 1 ) nnc = nnc + 1
     !
  ENDDO ! n3
  ENDDO ! n2
  ENDDO ! n1
  !
  nnc = 2
  !
  DO n1 = -1*ehub_nn_dim(1), ehub_nn_dim(1)
  DO n2 = -1*ehub_nn_dim(2), ehub_nn_dim(2)
  DO n3 = -1*ehub_nn_dim(3), ehub_nn_dim(3)
     !
     IF ( n1 == 0 .AND. n2 == 0 .AND. n3 == 0 ) CYCLE
     !
     DO na1 = 1, nat
        nt1 = ityp(na1)
        !
        IF ( ehub_lm(nt1) == 0 ) CYCLE
        !
     DO na2 = 1, nat
        nt2 = ityp(na2)
        !
        IF ( ehub_lm(nt2) == 0 ) CYCLE
        !
        IF ( ehub_nn_vect(n1+ics,n2+ics,n3+ics,na1,na2) == 0 ) CYCLE
        !
        DO m1 = 1, ehub_lm(nt1)
           !
           l1 = ehub_l(m1,nt1)
           !
        DO m2 = 1, ehub_lm(nt2)
           !
           l2 = ehub_l(m2,nt2)
           !
           ehub_v_(na1,na2,m1,m2) = &
                  (E0(nnc)%V(l1,l2,na1,na2) / HF(nnc)%V(l1,l2,na1,na2)) / 2.0_DP
           !
           IF ( stop_acbn0 ) ehub_v_diff(na1,na2,m1,m2,nnc) = ABS( ehub_v (na1,na2,m1,m2,nnc) &
                                                            -      ehub_v_(na1,na2,m1,m2    ) )
           !
           ehub_v(na1,na2,m1,m2,nnc) =                               &
                 (1.0_DP - ehub_mixing)*ehub_v (na1,na2,m1,m2,nnc) + &
                 (         ehub_mixing)*ehub_v_(na1,na2,m1,m2    )
           !
        ENDDO ! m2
        ENDDO ! m1
        !
     ENDDO ! na2
     ENDDO ! na1
     !
     IF ( MAXVAL(ehub_nn_vect(n1+ics,n2+ics,n3+ics,:,:)) == 1 ) nnc = nnc + 1
     !
  ENDDO ! n3
  ENDDO ! n2
  ENDDO ! n1
  !
  DEALLOCATE ( ehub_v_ )
  !
  DO i = 1, ehub_nnnc
     DEALLOCATE ( E0(i)%V, E0(i)%J )
     DEALLOCATE ( HF(i)%V, HF(i)%J )
  ENDDO
  !
  ! Hermiticity of Hubbard parameters U & V
  !
  DO na1 = 1, nat
     nt1 = ityp(na1)
     !
     IF ( ehub_lm(nt1) == 0 ) CYCLE
     !
  DO na2 = na1, nat
     nt2 = ityp(na2)
     !
     IF ( ehub_lm(nt2) == 0 ) CYCLE
     !
     DO m1 = 1, ehub_lm(nt1)
     DO m2 = 1, ehub_lm(nt2)
        ehub_v(na1,na2,m1,m2,1) = 0.5D0 * (ehub_v(na1,na2,m1,m2,1) + &
                                           ehub_v(na2,na1,m2,m1,1))
        !
        ehub_v(na2,na1,m2,m1,1) = ehub_v(na1,na2,m1,m2,1)
        !
     ENDDO ! m2
     ENDDO ! m1
     !
  ENDDO ! na2
  ENDDO ! na1
  !
  DO na1 = 1, nat
  DO na2 = 1, nat
     IF ( na1 /= na2 .AND. ehub_nn_vect(ics,ics,ics,na1,na2) == 0 ) &
        ehub_v(na1,na2,:,:,1) = 0.0_DP
  ENDDO ! na2
  ENDDO ! na1

1 CALL write_ehub_uv

  CALL stop_clock('acbn0_ns_e0_1')

  RETURN

END SUBROUTINE hp_acbn0_ns_e0_1



SUBROUTINE hp_acbn0_ns_v(ns)

  USE kinds,                ONLY : DP
  USE constants,            ONLY : tpi
  USE ions_base,            ONLY : nat, ityp, ntyp => nsp
  USE cell_base,            ONLY : at
  USE klist,                ONLY : nks, ngk, xk
  USE ldaV,                 ONLY : ehub_lm_max, ehub_lm, ehub_l, &
                                   ehub_nn_vect, ehub_nn_dim,    &
                                   ehub_nnnc, ehub_csize, wfcv,  &
                                   nwfcv, ofstv
  USE ldaU,                 ONLY : Hubbard_projectors
  USE lsda_mod,             ONLY : lsda, current_spin, nspin, isk
  USE wvfct,                ONLY : nbnd, npwx, wg
  USE control_flags,        ONLY : gamma_only
  USE io_global,            ONLY : stdout
  USE wavefunctions,        ONLY : evc
  USE io_files,             ONLY : nwordwfc, iunwfc, nwordwfcv, iunhubv
  USE buffers,              ONLY : get_buffer
  USE mp_pools,             ONLY : inter_pool_comm
  USE mp,                   ONLY : mp_sum
  USE becmod,               ONLY : bec_type, calbec,  &
                                   allocate_bec_type, &
                                   deallocate_bec_type
  USE uspp_param,           ONLY : upf

  IMPLICIT NONE

  REAL(DP), INTENT(OUT) :: ns(ehub_lm_max,ehub_lm_max,nspin,nat,nat,ehub_nnnc)

  TYPE occmat_5
     REAL(DP), ALLOCATABLE :: O(:,:,:,:,:)
     REAL(DP), ALLOCATABLE :: T(:,:,:,:,:)
  END TYPE occmat_5

  TYPE(bec_type)        :: proj

  COMPlEX(DP)           :: kphase

  REAL(DP)              :: arg

  TYPE(occmat_5)        :: n(ehub_nnnc)

  INTEGER               :: ik, ibnd, is, i, npw
  INTEGER               :: na1, na2, nt1, nt2
  INTEGER               :: m1, m2, m3, m4
  INTEGER               :: n1, n2, n3, nnc, ics

  CALL start_clock('acbn0_ns_v')
  !
  CALL allocate_bec_type(nwfcv, nbnd, proj)
  !
  DO i = 1, ehub_nnnc
     ALLOCATE ( n(i)%O(ehub_lm_max,ehub_lm_max,nspin,nat,nat) ) ; n(i)%O = 0.0_DP
  ENDDO
  !
  ics = ehub_csize + 1
  !
  DO ik = 1, nks
     !
     IF ( lsda ) current_spin = isk(ik)
     npw = ngk(ik)
     !
     ! projection < wfcv | evc >
     !
     IF ( nks > 1 ) CALL get_buffer(evc, nwordwfc, iunwfc, ik)     
     IF ( Hubbard_projectors == 'pseudo' ) THEN
        CALL errore('hp_acbn0_ns_v', 'Hubbard_projectors = pseudo is not supported', 1)
     ELSE
        IF ( nks > 1 ) CALL get_buffer(wfcv, nwordwfcv, iunhubv, ik)
        CALL calbec(npw, wfcv, evc, proj)
     ENDIF
     !
     ! calculate the occupation matrices n
     !
     DO na1 = 1, nat
        nt1 = ityp(na1)
        !
        IF ( ehub_lm(nt1) == 0 ) CYCLE
        !
     DO na2 = na1, nat
        nt2 = ityp(na2)
        !
        IF ( ehub_lm(nt2) == 0 ) CYCLE
        !
        IF ( na1 /= na2 .AND. ehub_nn_vect(ics,ics,ics,na1,na2) == 0 ) CYCLE
        !
        DO m1 = 1, ehub_lm(nt1)
        DO m2 = 1, ehub_lm(nt2)
           !
           IF ( gamma_only ) THEN
              DO ibnd = 1, nbnd
                 n(1)%O(m1,m2,current_spin,na1,na2) = &
                 n(1)%O(m1,m2,current_spin,na1,na2) + &
                                        wg(ibnd,ik) * &
                         proj%r(ofstv(na2)+m2,ibnd) * &
                         proj%r(ofstv(na1)+m1,ibnd)
              ENDDO
           ELSE
              DO ibnd = 1, nbnd
                 n(1)%O(m1,m2,current_spin,na1,na2) = &
                 n(1)%O(m1,m2,current_spin,na1,na2) + &
                                        wg(ibnd,ik) * &
                    DBLE(proj%k(ofstv(na2)+m2,ibnd) * &
                   CONJG(proj%k(ofstv(na1)+m1,ibnd)))
              ENDDO
           ENDIF
           !
        ENDDO ! m2
        ENDDO ! m1
        !
     ENDDO ! na2
     ENDDO ! na1
     !
     DO na1 = 1, nat
        nt1 = ityp(na1)
        !
        IF ( ehub_lm(nt1) == 0 ) CYCLE
        !
     DO na2 = na1, nat
        nt2 = ityp(na2)
        !
        IF ( ehub_lm(nt2) == 0 ) CYCLE
        !
        IF ( ehub_nn_vect(ics,ics,ics,na1,na2) == 0 ) CYCLE
        !
        DO m1 = 1, ehub_lm(nt1)
        DO m2 = 1, ehub_lm(nt2)
           n(1)%O(m2,m1,current_spin,na2,na1) = n(1)%O(m1,m2,current_spin,na1,na2)
        ENDDO ! m2
        ENDDO ! m1
        !
     ENDDO ! na2
     ENDDO ! na1
     !
     nnc = 2
     !
     DO n1 = -1*ehub_nn_dim(1), ehub_nn_dim(1)
     DO n2 = -1*ehub_nn_dim(2), ehub_nn_dim(2)
     DO n3 = -1*ehub_nn_dim(3), ehub_nn_dim(3)
        !
        IF ( n1 == 0 .AND. n2 == 0 .AND. n3 == 0 ) CYCLE
        !
        arg = tpi * (                                              &
         xk(1,ik) * (n1 * at(1,1) + n2 * at(1,2) + n3 * at(1,3)) + &
         xk(2,ik) * (n1 * at(2,1) + n2 * at(2,2) + n3 * at(2,3)) + &
         xk(3,ik) * (n1 * at(3,1) + n2 * at(3,2) + n3 * at(3,3)))
        !
        kphase = CMPLX(COS(arg), SIN(arg), KIND=DP)
        !
        DO na1 = 1, nat
           nt1 = ityp(na1)
           !
           IF ( ehub_lm(nt1) == 0 ) CYCLE
           !
        DO na2 = 1, nat
           nt2 = ityp(na2)
           !
           IF ( ehub_lm(nt2) == 0 ) CYCLE
           !
           IF ( ehub_nn_vect(n1+ics,n2+ics,n3+ics,na1,na2) == 0 ) CYCLE
           !
           DO m1 = 1, ehub_lm(nt1)
           DO m2 = 1, ehub_lm(nt2)
              !
              IF ( gamma_only ) THEN
                 DO ibnd = 1, nbnd
                    n(nnc)%O(m1,m2,current_spin,na1,na2) = &
                    n(nnc)%O(m1,m2,current_spin,na1,na2) + &
                                 DBLE(kphase*wg(ibnd,ik) * &
                              proj%r(ofstv(na2)+m2,ibnd) * &
                              proj%r(ofstv(na1)+m1,ibnd))
                 ENDDO ! ibnd
              ELSE
                 DO ibnd = 1, nbnd
                    n(nnc)%O(m1,m2,current_spin,na1,na2) = &
                    n(nnc)%O(m1,m2,current_spin,na1,na2) + &
                                 DBLE(kphase*wg(ibnd,ik) * &
                              proj%k(ofstv(na2)+m2,ibnd) * &
                        CONJG(proj%k(ofstv(na1)+m1,ibnd)))
                 ENDDO ! ibnd
              ENDIF
              !
           ENDDO ! m2
           ENDDO ! m1
           !
        ENDDO ! na2
        ENDDO ! na1
        !
        IF ( MAXVAL(ehub_nn_vect(n1+ics,n2+ics,n3+ics,:,:)) == 1 ) nnc = nnc + 1
        !
     ENDDO ! n3
     ENDDO ! n2
     ENDDO ! n1
     !
  ENDDO ! ik
  !
  CALL deallocate_bec_type(proj)
  !
  DO i = 1, ehub_nnnc
     CALL mp_sum(n(i)%O, inter_pool_comm)
  ENDDO
  !
  DO i = 1, ehub_nnnc
     IF ( nspin == 1 ) n(i)%O = 0.5_DP * n(i)%O
  ENDDO
  !
  CALL hp_acbn0_symm_n5(n)
  !
  ns = 0.0_DP
  !
  DO i = 1, ehub_nnnc
     ns(:,:,:,:,:,i) = n(i)%O(:,:,:,:,:)
     DEALLOCATE ( n(i)%O )
  ENDDO
  !
  CALL stop_clock('acbn0_ns_v')
  !
  RETURN
  !
END SUBROUTINE hp_acbn0_ns_v



SUBROUTINE hp_acbn0_symm_n4_v( n )

  USE kinds,                ONLY : DP
  USE ions_base,            ONLY : nat, ityp, ntyp => nsp
  USE ldaV,                 ONLY : ehub_lm, ehub_l, ehub_lm_max, &
                                   ehub_nn_vect, ehub_nn_dim,    &
                                   ehub_csize, ehub_nnnc
  USE lsda_mod,             ONLY : nspin
  USE symm_base,            ONLY : d1, d2, d3, nsym, irt

  IMPLICIT NONE

  TYPE occmat_4
     REAL(DP), ALLOCATABLE :: O(:,:,:,:)
     REAL(DP), ALLOCATABLE :: T(:,:,:,:)
  END TYPE occmat_4

  TYPE(occmat_4), INTENT(INOUT) :: n

  INTEGER                       :: is, isym, l, m, nt
  INTEGER                       :: na1, na2
  INTEGER                       :: nt1, nt2
  INTEGER                       :: m1, m2, m3, m4
  INTEGER                       :: m1_, m2_, m3_, m4_
  INTEGER                       :: temp, l_separation(5,ntyp)

  ALLOCATE (n%T(ehub_lm_max,ehub_lm_max,nspin,nat)) ; n%T = 0.0_DP

  DO nt = 1, ntyp
     !
     ! BUGFIX vs PW/src/new_ns_v.f90 (same defect in symmetrize_n4, _n4m and
     ! _n5).  Without this guard a type carrying no Hubbard manifold has
     ! ehub_l(1,nt) = 0, and the next line writes l_separation(0,nt) - one
     ! element BEFORE the array.  Dormant whenever every type is
     ! Hubbard-active, which is why it has never been hit; fires the moment a
     ! spectator species is added.
     !
     IF ( ehub_lm(nt) == 0 ) CYCLE
     !
     temp = ehub_l(1,nt)
     l_separation(ehub_l(1,nt),nt) = 1
     !
     DO m = 2, ehub_lm(nt)
        !
        IF ( ehub_l(m,nt) /= temp ) THEN
           temp = ehub_l(m,nt)
           l_separation(ehub_l(m,nt),nt) = m
        ENDIF
        !
     ENDDO
     !
  ENDDO
  !
  DO is = 1, nspin
     !
     DO na1 = 1, nat
        nt1 = ityp(na1)
        !
        IF ( ehub_lm(nt1) == 0 ) CYCLE
        !
        DO m1 = 1, ehub_lm(nt1)
           m1_ = m1 - l_separation(ehub_l(m1,nt1),nt1) + 1
           !
        DO m2 = 1, ehub_lm(nt1)
           m2_ = m2 - l_separation(ehub_l(m2,nt1),nt1) + 1
           !
           DO isym = 1, nsym
              !
              na2 = irt(isym, na1)
              !
              DO m3 = 1, ehub_lm(nt1)
                 IF ( ehub_l(m1,nt1) /= ehub_l(m3,nt1) ) CYCLE
                 m3_ = m3 - l_separation(ehub_l(m3,nt1),nt1) + 1
                 !
              DO m4 = 1, ehub_lm(nt1)
                 IF ( ehub_l(m2,nt1) /= ehub_l(m4,nt1) ) CYCLE
                 m4_ = m4 - l_separation(ehub_l(m4,nt1),nt1) + 1
                 !
                 IF ( ehub_l(m1,nt1) == 1 .AND. ehub_l(m2,nt1) == 1 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                        n%O(m3,m4,is,na2) / &
                                                   (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 1 .AND. ehub_l(m2,nt1) == 2 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                        n%O(m3,m4,is,na2) * &
                                         d1(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 1 .AND. ehub_l(m2,nt1) == 3 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                        n%O(m3,m4,is,na2) * &
                                         d2(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 1 .AND. ehub_l(m2,nt1) == 4 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                        n%O(m3,m4,is,na2) * &
                                         d3(m4_,m2_,isym) / &
                                                   (nsym)
  
                 ELSE IF ( ehub_l(m1,nt1) == 2 .AND. ehub_l(m2,nt1) == 1 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d1(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) / &
                                                   (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 2 .AND. ehub_l(m2,nt1) == 2 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d1(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d1(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 2 .AND. ehub_l(m2,nt1) == 3 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d1(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d2(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 2 .AND. ehub_l(m2,nt1) == 4 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d1(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d3(m4_,m2_,isym) / &
                                                   (nsym)

                 ELSE IF ( ehub_l(m1,nt1) == 3 .AND. ehub_l(m2,nt1) == 1 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d2(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) / &
                                                   (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 3 .AND. ehub_l(m2,nt1) == 2 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d2(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d1(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 3 .AND. ehub_l(m2,nt1) == 3 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d2(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d2(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 3 .AND. ehub_l(m2,nt1) == 4 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d2(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d3(m4_,m2_,isym) / &
                                                   (nsym)

                 ELSE IF ( ehub_l(m1,nt1) == 4 .AND. ehub_l(m2,nt1) == 1 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d3(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) / &
                                                   (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 4 .AND. ehub_l(m2,nt1) == 2 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d3(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d1(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 4 .AND. ehub_l(m2,nt1) == 3 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d3(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d2(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 4 .AND. ehub_l(m2,nt1) == 4 ) THEN
                    n%T(m1,m2,is,na1) = n%T(m1,m2,is,na1) + &
                                         d3(m3_,m1_,isym) * &
                                        n%O(m3,m4,is,na2) * &
                                         d3(m4_,m2_,isym) / &
                                                   (nsym)
                 ELSE
                    CALL errore('hp_acbn0_ns_v','angular momentum not implemented',1)
                 ENDIF
                 !
              ENDDO ! m4
              ENDDO ! m3
              !
           ENDDO ! isym
           !
        ENDDO ! m2
        ENDDO ! m1
        ! 
     ENDDO ! na1
     !
  ENDDO ! is
  !
  DO na1 = 1, nat
     nt1 = ityp(na1)
     !
     IF ( ehub_lm(nt1) == 0 ) CYCLE
     !
     DO is = 1, nspin
        !
        DO m1 = 1, ehub_lm(nt1)
        DO m2 = m1, ehub_lm(nt1)
           !
           n%T(m1,m2,is,na1) = 0.5D0 * (n%T(m1,m2,is,na1) + &
                                        n%T(m2,m1,is,na1))
           !
           n%T(m2,m1,is,na1) = n%T(m1,m2,is,na1)
           !
        ENDDO
        ENDDO
        !
     ENDDO
     !
  ENDDO
  !
  n%O = n%T
  DEALLOCATE (n%T)

END SUBROUTINE hp_acbn0_symm_n4_v

SUBROUTINE hp_acbn0_symm_n4m( n )

  USE kinds,                ONLY : DP
  USE ions_base,            ONLY : nat, ityp, ntyp => nsp
  USE ldaV,                 ONLY : ehub_lm, ehub_l, ehub_lm_max, &
                                   ehub_nn_vect, ehub_nn_dim,    &
                                   ehub_csize, ehub_nnnc
  USE lsda_mod,             ONLY : nspin
  USE symm_base,            ONLY : d1, d2, d3, nsym, irt

  IMPLICIT NONE

  TYPE occmat_4
     REAL(DP), ALLOCATABLE :: O(:,:,:,:)
     REAL(DP), ALLOCATABLE :: T(:,:,:,:)
  END TYPE occmat_4

  TYPE(occmat_4), INTENT(INOUT) :: n(ntyp,4)

  INTEGER                       :: is, isym, i, l, m, nt
  INTEGER                       :: na1, na2
  INTEGER                       :: nt1, nt2
  INTEGER                       :: m1, m2, m3, m4
  INTEGER                       :: m1_, m2_, m3_, m4_
  INTEGER                       :: temp, l_separation(5,ntyp)

  DO i = 1, ntyp
     DO l = 1, 4
        ALLOCATE (n(i,l)%T(ehub_lm_max,ehub_lm_max,nspin,nat)) ; n(i,l)%T = 0.0_DP
     ENDDO
  ENDDO
  !
  DO nt = 1, ntyp
     !
     ! BUGFIX vs PW/src/new_ns_v.f90 (same defect in symmetrize_n4, _n4m and
     ! _n5).  Without this guard a type carrying no Hubbard manifold has
     ! ehub_l(1,nt) = 0, and the next line writes l_separation(0,nt) - one
     ! element BEFORE the array.  Dormant whenever every type is
     ! Hubbard-active, which is why it has never been hit; fires the moment a
     ! spectator species is added.
     !
     IF ( ehub_lm(nt) == 0 ) CYCLE
     !
     temp = ehub_l(1,nt)
     l_separation(ehub_l(1,nt),nt) = 1
     !
     DO m = 2, ehub_lm(nt)
        !
        IF ( ehub_l(m,nt) /= temp ) THEN
           temp = ehub_l(m,nt)
           l_separation(ehub_l(m,nt),nt) = m
        ENDIF
        !
     ENDDO
     !
  ENDDO
  !
  DO nt = 1, ntyp
     !
     IF ( ehub_lm(nt) == 0 ) CYCLE
     !
     DO l = 1, 4
        !
        DO is = 1, nspin
           !
           DO na1 = 1, nat
              nt1 = ityp(na1)
              !
              IF ( ehub_lm(nt1) == 0 ) CYCLE
              !
              DO m1 = 1, ehub_lm(nt1)
                 m1_ = m1 - l_separation(ehub_l(m1,nt1),nt1) + 1
                 !
              DO m2 = 1, ehub_lm(nt1)
                 m2_ = m2 - l_separation(ehub_l(m2,nt1),nt1) + 1
                 !
                 DO isym = 1, nsym
                    !
                    na2 = irt(isym, na1)
                    !
                    DO m3 = 1, ehub_lm(nt1)
                       IF ( ehub_l(m1,nt1) /= ehub_l(m3,nt1) ) CYCLE
                       m3_ = m3 - l_separation(ehub_l(m3,nt1),nt1) + 1
                       !
                    DO m4 = 1, ehub_lm(nt1)
                       IF ( ehub_l(m2,nt1) /= ehub_l(m4,nt1) ) CYCLE
                       m4_ = m4 - l_separation(ehub_l(m4,nt1),nt1) + 1
                       !
                       IF ( ehub_l(m1,nt1) == 1 .AND. ehub_l(m2,nt1) == 1 ) THEN
                          n(nt,l)%T(m1,m2,is,na1) = n(nt,l)%T(m1,m2,is,na1) + &
                                                    n(nt,l)%O(m3,m4,is,na2) / &
                                                                     (nsym)
                       ELSE IF ( ehub_l(m1,nt1) == 1 .AND. ehub_l(m2,nt1) == 2 ) THEN
                          n(nt,l)%T(m1,m2,is,na1) = n(nt,l)%T(m1,m2,is,na1) + &
                                                    n(nt,l)%O(m3,m4,is,na2) * &
                                                           d1(m4_,m2_,isym) / &
                                                                     (nsym)
                       ELSE IF ( ehub_l(m1,nt1) == 1 .AND. ehub_l(m2,nt1) == 3 ) THEN
                          n(nt,l)%T(m1,m2,is,na1) = n(nt,l)%T(m1,m2,is,na1) + &
                                                    n(nt,l)%O(m3,m4,is,na2) * &
                                                           d2(m4_,m2_,isym) / &
                                                                     (nsym)
                       ELSE IF ( ehub_l(m1,nt1) == 1 .AND. ehub_l(m2,nt1) == 4 ) THEN
                          n(nt,l)%T(m1,m2,is,na1) = n(nt,l)%T(m1,m2,is,na1) + &
                                                    n(nt,l)%O(m3,m4,is,na2) * &
                                                           d3(m4_,m2_,isym) / &
                                                                     (nsym)
      
                       ELSE IF ( ehub_l(m1,nt1) == 2 .AND. ehub_l(m2,nt1) == 1 ) THEN
                          n(nt,l)%T(m1,m2,is,na1) = n(nt,l)%T(m1,m2,is,na1) + &
                                                           d1(m3_,m1_,isym) * &
                                                    n(nt,l)%O(m3,m4,is,na2) / &
                                                                     (nsym)
                       ELSE IF ( ehub_l(m1,nt1) == 2 .AND. ehub_l(m2,nt1) == 2 ) THEN
                          n(nt,l)%T(m1,m2,is,na1) = n(nt,l)%T(m1,m2,is,na1) + &
                                                           d1(m3_,m1_,isym) * &
                                                    n(nt,l)%O(m3,m4,is,na2) * &
                                                           d1(m4_,m2_,isym) / &
                                                                     (nsym)
                       ELSE IF ( ehub_l(m1,nt1) == 2 .AND. ehub_l(m2,nt1) == 3 ) THEN
                          n(nt,l)%T(m1,m2,is,na1) = n(nt,l)%T(m1,m2,is,na1) + &
                                                           d1(m3_,m1_,isym) * &
                                                    n(nt,l)%O(m3,m4,is,na2) * &
                                                           d2(m4_,m2_,isym) / &
                                                                     (nsym)
                       ELSE IF ( ehub_l(m1,nt1) == 2 .AND. ehub_l(m2,nt1) == 4 ) THEN
                          n(nt,l)%T(m1,m2,is,na1) = n(nt,l)%T(m1,m2,is,na1) + &
                                                           d1(m3_,m1_,isym) * &
                                                    n(nt,l)%O(m3,m4,is,na2) * &
                                                           d3(m4_,m2_,isym) / &
                                                                     (nsym)

                       ELSE IF ( ehub_l(m1,nt1) == 3 .AND. ehub_l(m2,nt1) == 1 ) THEN
                          n(nt,l)%T(m1,m2,is,na1) = n(nt,l)%T(m1,m2,is,na1) + &
                                                           d2(m3_,m1_,isym) * &
                                                    n(nt,l)%O(m3,m4,is,na2) / &
                                                                     (nsym)
                       ELSE IF ( ehub_l(m1,nt1) == 3 .AND. ehub_l(m2,nt1) == 2 ) THEN
                          n(nt,l)%T(m1,m2,is,na1) = n(nt,l)%T(m1,m2,is,na1) + &
                                                           d2(m3_,m1_,isym) * &
                                                    n(nt,l)%O(m3,m4,is,na2) * &
                                                           d1(m4_,m2_,isym) / &
                                                                     (nsym)
                       ELSE IF ( ehub_l(m1,nt1) == 3 .AND. ehub_l(m2,nt1) == 3 ) THEN
                          n(nt,l)%T(m1,m2,is,na1) = n(nt,l)%T(m1,m2,is,na1) + &
                                                           d2(m3_,m1_,isym) * &
                                                    n(nt,l)%O(m3,m4,is,na2) * &
                                                           d2(m4_,m2_,isym) / &
                                                                     (nsym)
                       ELSE IF ( ehub_l(m1,nt1) == 3 .AND. ehub_l(m2,nt1) == 4 ) THEN
                          n(nt,l)%T(m1,m2,is,na1) = n(nt,l)%T(m1,m2,is,na1) + &
                                                           d2(m3_,m1_,isym) * &
                                                    n(nt,l)%O(m3,m4,is,na2) * &
                                                           d3(m4_,m2_,isym) / &
                                                                     (nsym)

                       ELSE IF ( ehub_l(m1,nt1) == 4 .AND. ehub_l(m2,nt1) == 1 ) THEN
                          n(nt,l)%T(m1,m2,is,na1) = n(nt,l)%T(m1,m2,is,na1) + &
                                                           d3(m3_,m1_,isym) * &
                                                    n(nt,l)%O(m3,m4,is,na2) / &
                                                                             (nsym)
                       ELSE IF ( ehub_l(m1,nt1) == 4 .AND. ehub_l(m2,nt1) == 2 ) THEN
                          n(nt,l)%T(m1,m2,is,na1) = n(nt,l)%T(m1,m2,is,na1) + &
                                                           d3(m3_,m1_,isym) * &
                                                    n(nt,l)%O(m3,m4,is,na2) * &
                                                           d1(m4_,m2_,isym) / &
                                                                     (nsym)
                       ELSE IF ( ehub_l(m1,nt1) == 4 .AND. ehub_l(m2,nt1) == 3 ) THEN
                          n(nt,l)%T(m1,m2,is,na1) = n(nt,l)%T(m1,m2,is,na1) + &
                                                           d3(m3_,m1_,isym) * &
                                                    n(nt,l)%O(m3,m4,is,na2) * &
                                                           d2(m4_,m2_,isym) / &
                                                                     (nsym)
                       ELSE IF ( ehub_l(m1,nt1) == 4 .AND. ehub_l(m2,nt1) == 4 ) THEN
                          n(nt,l)%T(m1,m2,is,na1) = n(nt,l)%T(m1,m2,is,na1) + &
                                                           d3(m3_,m1_,isym) * &
                                                    n(nt,l)%O(m3,m4,is,na2) * &
                                                           d3(m4_,m2_,isym) / &
                                                                     (nsym)
                       ELSE
                          CALL errore('hp_acbn0_ns_v','angular momentum not implemented',1)
                       ENDIF
                       !
                    ENDDO ! m4
                    ENDDO ! m3
                    !
                 ENDDO ! isym
                 !
              ENDDO ! m2
              ENDDO ! m1
              ! 
           ENDDO ! na1
           !
        ENDDO ! is
        !
     ENDDO ! l
     !
  ENDDO ! nt
  !
  DO nt = 1, ntyp
     !
     IF ( ehub_lm(nt) == 0 ) CYCLE
     !
     DO l = 1, 4
        !
        DO na1 = 1, nat
           nt1 = ityp(na1)
           !
           IF ( ehub_lm(nt1) == 0 ) CYCLE
           !
           DO is = 1, nspin
              !
              DO m1 = 1, ehub_lm(nt1)
              DO m2 = m1, ehub_lm(nt1)
                 !
                 n(nt,l)%T(m1,m2,is,na1) = 0.5D0 * (n(nt,l)%T(m1,m2,is,na1) + &
                                                    n(nt,l)%T(m2,m1,is,na1))
                 !
                 n(nt,l)%T(m2,m1,is,na1) = n(nt,l)%T(m1,m2,is,na1)
                 !
              ENDDO
              ENDDO
              !
           ENDDO
           !
        ENDDO
        !
     ENDDO
     !
  ENDDO
  !
  DO nt = 1, ntyp
     DO l = 1, 4
        n(nt,l)%O = n(nt,l)%T
        DEALLOCATE (n(nt,l)%T)
     ENDDO
  ENDDO

END SUBROUTINE hp_acbn0_symm_n4m



SUBROUTINE hp_acbn0_symm_n5( n )

  USE kinds,                ONLY : DP
  USE ions_base,            ONLY : nat, ityp, ntyp => nsp
  USE ldaV,                 ONLY : ehub_lm, ehub_l, ehub_lm_max, &
                                   ehub_nn_vect, ehub_nn_dim,    &
                                   ehub_csize, ehub_nnnc
  USE lsda_mod,             ONLY : nspin
  USE symm_base,            ONLY : d1, d2, d3, nsym, irt

  IMPLICIT NONE

  TYPE occmat_5
     REAL(DP), ALLOCATABLE :: O(:,:,:,:,:)
     REAL(DP), ALLOCATABLE :: T(:,:,:,:,:)
  END TYPE occmat_5

  TYPE(occmat_5), INTENT(INOUT) :: n(ehub_nnnc)

  INTEGER                       :: is, isym, i, m, nt
  INTEGER                       :: na1, na2, na3, na4
  INTEGER                       :: nt1, nt2, nt3, nt4
  INTEGER                       :: m1, m2, m3, m4
  INTEGER                       :: m1_, m2_, m3_, m4_
  INTEGER                       :: n0(3), n1, n2, n3
  INTEGER                       :: nnc0, nnc, ics
  INTEGER                       :: temp, l_separation(5,ntyp)

  DO i = 1, ehub_nnnc
     ALLOCATE (n(i)%T(ehub_lm_max,ehub_lm_max,nspin,nat,nat)) ; n(i)%T = 0.0_DP
  ENDDO
  !
  DO nt = 1, ntyp
     !
     ! BUGFIX vs PW/src/new_ns_v.f90 (same defect in symmetrize_n4, _n4m and
     ! _n5).  Without this guard a type carrying no Hubbard manifold has
     ! ehub_l(1,nt) = 0, and the next line writes l_separation(0,nt) - one
     ! element BEFORE the array.  Dormant whenever every type is
     ! Hubbard-active, which is why it has never been hit; fires the moment a
     ! spectator species is added.
     !
     IF ( ehub_lm(nt) == 0 ) CYCLE
     !
     temp = ehub_l(1,nt)
     l_separation(ehub_l(1,nt),nt) = 1
     !
     DO m = 2, ehub_lm(nt)
        !
        IF ( ehub_l(m,nt) /= temp ) THEN
           temp = ehub_l(m,nt)
           l_separation(ehub_l(m,nt),nt) = m
        ENDIF
        !
     ENDDO
     !
  ENDDO
  !
  ics = ehub_csize + 1
  !
  DO is = 1, nspin
     !
     DO na1 = 1, nat
        nt1 = ityp(na1)
        !
        IF ( ehub_lm(nt1) == 0 ) CYCLE
        !
        DO m1 = 1, ehub_lm(nt1)
           m1_ = m1 - l_separation(ehub_l(m1,nt1),nt1) + 1
           !
        DO m2 = 1, ehub_lm(nt1)
           m2_ = m2 - l_separation(ehub_l(m2,nt1),nt1) + 1
           !
           DO isym = 1, nsym
              !
              na2 = irt(isym, na1)
              !
              DO m3 = 1, ehub_lm(nt1)
                 IF ( ehub_l(m1,nt1) /= ehub_l(m3,nt1) ) CYCLE
                 m3_ = m3 - l_separation(ehub_l(m3,nt1),nt1) + 1
                 !
              DO m4 = 1, ehub_lm(nt1)
                 IF ( ehub_l(m2,nt1) /= ehub_l(m4,nt1) ) CYCLE
                 m4_ = m4 - l_separation(ehub_l(m4,nt1),nt1) + 1
                 !
                 IF ( ehub_l(m1,nt1) == 1 .AND. ehub_l(m2,nt1) == 1 ) THEN
                    n(1)%T(m1,m2,is,na1,na1) = n(1)%T(m1,m2,is,na1,na1) + &
                                               n(1)%O(m3,m4,is,na2,na2) / &
                                                                 (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 1 .AND. ehub_l(m2,nt1) == 2 ) THEN
                    n(1)%T(m1,m2,is,na1,na1) = n(1)%T(m1,m2,is,na1,na1) + &
                                               n(1)%O(m3,m4,is,na2,na2) * &
                                                       d1(m4_,m2_,isym) / &
                                                                 (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 1 .AND. ehub_l(m2,nt1) == 3 ) THEN
                    n(1)%T(m1,m2,is,na1,na1) = n(1)%T(m1,m2,is,na1,na1) + &
                                               n(1)%O(m3,m4,is,na2,na2) * &
                                                       d2(m4_,m2_,isym) / &
                                                                 (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 1 .AND. ehub_l(m2,nt1) == 4 ) THEN
                    n(1)%T(m1,m2,is,na1,na1) = n(1)%T(m1,m2,is,na1,na1) + &
                                               n(1)%O(m3,m4,is,na2,na2) * &
                                                       d3(m4_,m2_,isym) / &
                                                                 (nsym)

                 ELSE IF ( ehub_l(m1,nt1) == 2 .AND. ehub_l(m2,nt1) == 1 ) THEN
                    n(1)%T(m1,m2,is,na1,na1) = n(1)%T(m1,m2,is,na1,na1) + &
                                                       d1(m3_,m1_,isym) * &
                                               n(1)%O(m3,m4,is,na2,na2) / &
                                                                 (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 2 .AND. ehub_l(m2,nt1) == 2 ) THEN
                    n(1)%T(m1,m2,is,na1,na1) = n(1)%T(m1,m2,is,na1,na1) + &
                                                       d1(m3_,m1_,isym) * &
                                               n(1)%O(m3,m4,is,na2,na2) * &
                                                       d1(m4_,m2_,isym) / &
                                                                 (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 2 .AND. ehub_l(m2,nt1) == 3 ) THEN
                    n(1)%T(m1,m2,is,na1,na1) = n(1)%T(m1,m2,is,na1,na1) + &
                                                       d1(m3_,m1_,isym) * &
                                               n(1)%O(m3,m4,is,na2,na2) * &
                                                       d2(m4_,m2_,isym) / &
                                                                 (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 2 .AND. ehub_l(m2,nt1) == 4 ) THEN
                    n(1)%T(m1,m2,is,na1,na1) = n(1)%T(m1,m2,is,na1,na1) + &
                                                       d1(m3_,m1_,isym) * &
                                               n(1)%O(m3,m4,is,na2,na2) * &
                                                       d3(m4_,m2_,isym) / &
                                                                 (nsym)

                 ELSE IF ( ehub_l(m1,nt1) == 3 .AND. ehub_l(m2,nt1) == 1 ) THEN
                    n(1)%T(m1,m2,is,na1,na1) = n(1)%T(m1,m2,is,na1,na1) + &
                                                       d2(m3_,m1_,isym) * &
                                               n(1)%O(m3,m4,is,na2,na2) / &
                                                                 (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 3 .AND. ehub_l(m2,nt1) == 2 ) THEN
                    n(1)%T(m1,m2,is,na1,na1) = n(1)%T(m1,m2,is,na1,na1) + &
                                                       d2(m3_,m1_,isym) * &
                                               n(1)%O(m3,m4,is,na2,na2) * &
                                                       d1(m4_,m2_,isym) / &
                                                                 (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 3 .AND. ehub_l(m2,nt1) == 3 ) THEN
                    n(1)%T(m1,m2,is,na1,na1) = n(1)%T(m1,m2,is,na1,na1) + &
                                                       d2(m3_,m1_,isym) * &
                                               n(1)%O(m3,m4,is,na2,na2) * &
                                                       d2(m4_,m2_,isym) / &
                                                                 (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 3 .AND. ehub_l(m2,nt1) == 4 ) THEN
                    n(1)%T(m1,m2,is,na1,na1) = n(1)%T(m1,m2,is,na1,na1) + &
                                                       d2(m3_,m1_,isym) * &
                                               n(1)%O(m3,m4,is,na2,na2) * &
                                                       d3(m4_,m2_,isym) / &
                                                                 (nsym)

                 ELSE IF ( ehub_l(m1,nt1) == 4 .AND. ehub_l(m2,nt1) == 1 ) THEN
                    n(1)%T(m1,m2,is,na1,na1) = n(1)%T(m1,m2,is,na1,na1) + &
                                                       d3(m3_,m1_,isym) * &
                                               n(1)%O(m3,m4,is,na2,na2) / &
                                                                 (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 4 .AND. ehub_l(m2,nt1) == 2 ) THEN
                    n(1)%T(m1,m2,is,na1,na1) = n(1)%T(m1,m2,is,na1,na1) + &
                                                       d3(m3_,m1_,isym) * &
                                               n(1)%O(m3,m4,is,na2,na2) * &
                                                       d1(m4_,m2_,isym) / &
                                                                 (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 4 .AND. ehub_l(m2,nt1) == 3 ) THEN
                    n(1)%T(m1,m2,is,na1,na1) = n(1)%T(m1,m2,is,na1,na1) + &
                                                       d3(m3_,m1_,isym) * &
                                               n(1)%O(m3,m4,is,na2,na2) * &
                                                       d2(m4_,m2_,isym) / &
                                                                 (nsym)
                 ELSE IF ( ehub_l(m1,nt1) == 4 .AND. ehub_l(m2,nt1) == 4 ) THEN
                    n(1)%T(m1,m2,is,na1,na1) = n(1)%T(m1,m2,is,na1,na1) + &
                                                       d3(m3_,m1_,isym) * &
                                               n(1)%O(m3,m4,is,na2,na2) * &
                                                       d3(m4_,m2_,isym) / &
                                                                 (nsym)
                 ELSE
                    CALL errore('hp_acbn0_ns_v','angular momentum not implemented',1)
                 ENDIF
                 !
              ENDDO ! m4
              ENDDO ! m3
              !
           ENDDO ! isym
           !
        ENDDO ! m2
        ENDDO ! m1
        ! 
     ENDDO ! na1
     !
  ENDDO ! is

  DO is = 1, nspin
     !
     DO na1 = 1, nat
        nt1 = ityp(na1)
        !
        IF ( ehub_lm(nt1) == 0 ) CYCLE
        !
        DO n1 = -1*ehub_nn_dim(1), ehub_nn_dim(1)
        DO n2 = -1*ehub_nn_dim(2), ehub_nn_dim(2)
        DO n3 = -1*ehub_nn_dim(3), ehub_nn_dim(3)
           !
           n0(1) = n1 ; n0(2) = n2 ; n0(3) = n3
           !
           CALL hubbard_get_nnc(n0,nnc0)
           !
           DO na2 = 1, nat
              nt2 = ityp(na2)
              !
              IF ( ehub_lm(nt2) == 0 ) CYCLE
              !
              IF ( ehub_nn_vect(n1+ics,n2+ics,n3+ics,na1,na2) == 0 ) CYCLE
              !
              DO m1 = 1, ehub_lm(nt1)
                 m1_ = m1 - l_separation(ehub_l(m1,nt1),nt1) + 1
                 !
              DO m2 = 1, ehub_lm(nt2)
                 m2_ = m2 - l_separation(ehub_l(m2,nt2),nt2) + 1
                 !
                 DO isym = 1, nsym
                    !
                    CALL hubbard_symmetry(na1,na2,na3,na4,n0,nnc,isym)
                    !
                    DO m3 = 1, ehub_lm(nt1)
                       IF ( ehub_l(m1,nt1) /= ehub_l(m3,nt1) ) CYCLE
                       m3_ = m3 - l_separation(ehub_l(m3,nt1),nt1) + 1
                       !
                    DO m4 = 1, ehub_lm(nt2)
                       IF ( ehub_l(m2,nt2) /= ehub_l(m4,nt2) ) CYCLE
                       m4_ = m4 - l_separation(ehub_l(m4,nt2),nt2) + 1
                       !
                       IF ( ehub_l(m1,nt1) == 1 .AND. ehub_l(m2,nt2) == 1 ) THEN
                          n(nnc0)%T(m1,m2,is,na1,na2) = n(nnc0)%T(m1,m2,is,na1,na2) + &
                                                        n(nnc )%O(m3,m4,is,na3,na4) / &
                                                                             (nsym)
                       ELSE IF ( ehub_l(m1,nt1) == 1 .AND. ehub_l(m2,nt2) == 2 ) THEN
                          n(nnc0)%T(m1,m2,is,na1,na2) = n(nnc0)%T(m1,m2,is,na1,na2) + &
                                                        n(nnc )%O(m3,m4,is,na3,na4) * &
                                                                   d1(m4_,m2_,isym) / &
                                                                             (nsym)
                       ELSE IF ( ehub_l(m1,nt1) == 1 .AND. ehub_l(m2,nt2) == 3 ) THEN
                          n(nnc0)%T(m1,m2,is,na1,na2) = n(nnc0)%T(m1,m2,is,na1,na2) + &
                                                        n(nnc )%O(m3,m4,is,na3,na4) * &
                                                                   d2(m4_,m2_,isym) / &
                                                                             (nsym)
                       ELSE IF ( ehub_l(m1,nt1) == 1 .AND. ehub_l(m2,nt2) == 4 ) THEN
                          n(nnc0)%T(m1,m2,is,na1,na2) = n(nnc0)%T(m1,m2,is,na1,na2) + &
                                                        n(nnc )%O(m3,m4,is,na3,na4) * &
                                                                   d3(m4_,m2_,isym) / &
                                                                             (nsym)

                       ELSE IF ( ehub_l(m1,nt1) == 2 .AND. ehub_l(m2,nt2) == 1 ) THEN
                          n(nnc0)%T(m1,m2,is,na1,na2) = n(nnc0)%T(m1,m2,is,na1,na2) + &
                                                                   d1(m3_,m1_,isym) * &
                                                        n(nnc )%O(m3,m4,is,na3,na4) / &
                                                                             (nsym)
                       ELSE IF ( ehub_l(m1,nt1) == 2 .AND. ehub_l(m2,nt2) == 2 ) THEN
                          n(nnc0)%T(m1,m2,is,na1,na2) = n(nnc0)%T(m1,m2,is,na1,na2) + &
                                                                   d1(m3_,m1_,isym) * &
                                                        n(nnc )%O(m3,m4,is,na3,na4) * &
                                                                   d1(m4_,m2_,isym) / &
                                                                             (nsym)
                       ELSE IF ( ehub_l(m1,nt1) == 2 .AND. ehub_l(m2,nt2) == 3 ) THEN
                          n(nnc0)%T(m1,m2,is,na1,na2) = n(nnc0)%T(m1,m2,is,na1,na2) + &
                                                                   d1(m3_,m1_,isym) * &
                                                        n(nnc )%O(m3,m4,is,na3,na4) * &
                                                                   d2(m4_,m2_,isym) / &
                                                                             (nsym)
                       ELSE IF ( ehub_l(m1,nt1) == 2 .AND. ehub_l(m2,nt2) == 4 ) THEN
                          n(nnc0)%T(m1,m2,is,na1,na2) = n(nnc0)%T(m1,m2,is,na1,na2) + &
                                                                   d1(m3_,m1_,isym) * &
                                                        n(nnc )%O(m3,m4,is,na3,na4) * &
                                                                   d3(m4_,m2_,isym) / &
                                                                             (nsym)

                       ELSE IF ( ehub_l(m1,nt1) == 3 .AND. ehub_l(m2,nt2) == 1 ) THEN
                          n(nnc0)%T(m1,m2,is,na1,na2) = n(nnc0)%T(m1,m2,is,na1,na2) + &
                                                                   d2(m3_,m1_,isym) * &
                                                        n(nnc )%O(m3,m4,is,na3,na4) / &
                                                                             (nsym)
                       ELSE IF ( ehub_l(m1,nt1) == 3 .AND. ehub_l(m2,nt2) == 2 ) THEN
                          n(nnc0)%T(m1,m2,is,na1,na2) = n(nnc0)%T(m1,m2,is,na1,na2) + &
                                                                   d2(m3_,m1_,isym) * &
                                                        n(nnc )%O(m3,m4,is,na3,na4) * &
                                                                   d1(m4_,m2_,isym) / &
                                                                            (nsym)
                       ELSE IF ( ehub_l(m1,nt1) == 3 .AND. ehub_l(m2,nt2) == 3 ) THEN
                          n(nnc0)%T(m1,m2,is,na1,na2) = n(nnc0)%T(m1,m2,is,na1,na2) + &
                                                                   d2(m3_,m1_,isym) * &
                                                        n(nnc )%O(m3,m4,is,na3,na4) * &
                                                                   d2(m4_,m2_,isym) / &
                                                                             (nsym)
                       ELSE IF ( ehub_l(m1,nt1) == 3 .AND. ehub_l(m2,nt2) == 4 ) THEN
                          n(nnc0)%T(m1,m2,is,na1,na2) = n(nnc0)%T(m1,m2,is,na1,na2) + &
                                                                   d2(m3_,m1_,isym) * &
                                                        n(nnc )%O(m3,m4,is,na3,na4) * &
                                                                   d3(m4_,m2_,isym) / &
                                                                             (nsym)

                       ELSE IF ( ehub_l(m1,nt1) == 4 .AND. ehub_l(m2,nt2) == 1 ) THEN
                          n(nnc0)%T(m1,m2,is,na1,na2) = n(nnc0)%T(m1,m2,is,na1,na2) + &
                                                                   d3(m3_,m1_,isym) * &
                                                        n(nnc )%O(m3,m4,is,na3,na4) / &
                                                                             (nsym)
                       ELSE IF ( ehub_l(m1,nt1) == 4 .AND. ehub_l(m2,nt2) == 2 ) THEN
                          n(nnc0)%T(m1,m2,is,na1,na2) = n(nnc0)%T(m1,m2,is,na1,na2) + &
                                                                   d3(m3_,m1_,isym) * &
                                                        n(nnc )%O(m3,m4,is,na3,na4) * &
                                                                   d1(m4_,m2_,isym) / &
                                                                             (nsym)
                       ELSE IF ( ehub_l(m1,nt1) == 4 .AND. ehub_l(m2,nt2) == 3 ) THEN
                          n(nnc0)%T(m1,m2,is,na1,na2) = n(nnc0)%T(m1,m2,is,na1,na2) + &
                                                                   d3(m3_,m1_,isym) * &
                                                        n(nnc )%O(m3,m4,is,na3,na4) * &
                                                                   d2(m4_,m2_,isym) / &
                                                                             (nsym)
                       ELSE IF ( ehub_l(m1,nt1) == 4 .AND. ehub_l(m2,nt2) == 4 ) THEN
                          n(nnc0)%T(m1,m2,is,na1,na2) = n(nnc0)%T(m1,m2,is,na1,na2) + &
                                                                   d3(m3_,m1_,isym) * &
                                                        n(nnc )%O(m3,m4,is,na3,na4) * &
                                                                   d3(m4_,m2_,isym) / &
                                                                             (nsym)
                       ELSE
                          CALL errore('hp_acbn0_ns_v','angular momentum not implemented',1)
                       ENDIF
                       !
                    ENDDO ! m4
                    ENDDO ! m3
                    !
                 ENDDO ! isym
                 !
              ENDDO ! m2
              ENDDO ! m1
              !
           ENDDO ! na2
           ! 
        ENDDO ! n3
        ENDDO ! n2
        ENDDO ! n1
        !
     ENDDO ! na1
     !
  ENDDO ! is
  !
  DO na1 = 1, nat
     nt1 = ityp(na1)
     !
     IF ( ehub_lm(nt1) == 0 ) CYCLE
     !
  DO na2 = na1, nat
     nt2 = ityp(na2)
     !
     IF ( ehub_lm(nt2) == 0 ) CYCLE
     !
     DO m1 = 1, ehub_lm(nt1)
     DO m2 = 1, ehub_lm(nt2)
        !
        DO is = 1, nspin
           n(1)%T(m1,m2,is,na1,na2) = 0.5D0 * (n(1)%T(m1,m2,is,na1,na2) + &
                                               n(1)%T(m2,m1,is,na2,na1))
           !
           n(1)%T(m2,m1,is,na2,na1) = n(1)%T(m1,m2,is,na1,na2)
        ENDDO
        !
     ENDDO
     ENDDO
     !
  ENDDO
  ENDDO
  !
  DO na1 = 1, nat
  DO na2 = 1, nat
     !
     DO is = 1, nspin
        IF ( na1 /= na2 .AND. ehub_nn_vect(ics,ics,ics,na1,na2) == 0 ) &
           n(1)%T(:,:,is,na1,na2) = 0.0_DP
     ENDDO
     !
  ENDDO
  ENDDO
  !
  DO i = 1, ehub_nnnc
     n(i)%O = n(i)%T
     DEALLOCATE (n(i)%T)
  ENDDO

END SUBROUTINE hp_acbn0_symm_n5


