 &control
   title='NiO'
   calculation  = 'scf',
   prefix       = 'NiO',
   pseudo_dir   = './psp'
   outdir       = './outdir',
   verbosity    = 'high'
   disk_io      = 'low',
   nstep = 999
 /
 &system
   ibrav = 0
!  nosym=.TRUE.
!  celldm(1) = 6.04148863, celldm(3) = 1.60590219
   nat = 4
   ntyp = 3
   nbnd = 32,
   ecutwfc = 80, 
   ecutrho = 780, 
   occupations = 'fixed',
!   occupations= 'smearing'
!   smearing='gaussian'
!   degauss=0.01
   nspin = 2,
   tot_magnetization = 0.0
   starting_magnetization(1) = 0.5, starting_magnetization(2) = -0.5
 /
 &electrons
   diagonalization = 'david',
!   diago_full_acc  = .true.,
   conv_thr        =  1.0D-10,
   mixing_beta     =  0.3,
   electron_maxstep = 500
 /

&IONS
!  upscale           = 100.D0,
!   ion_dynamics = 'damp'
/

&CELL
!  cell_dynamics     = 'bfgs'
!  press_conv_thr    = 0.5d0
/

ATOMIC_SPECIES
Ni1 58.69 Ni.upf
Ni2 58.69 Ni.upf
O   15.99 O.upf

CELL_PARAMETERS (angstrom)
        2.03538266         2.03538266       4.10397052
        2.03538266         4.10397052       2.03538266
        4.10397052         2.03538266       2.03538266

ATOMIC_POSITIONS (crystal)
Ni1      0.00000000     0.00000000     0.00000000
Ni2      0.50000000     0.50000000     0.50000000
O        0.25000000     0.25000000     0.25000000
O        0.75000000     0.75000000     0.75000000

K_POINTS (automatic)
   8  8  8  0  0  0

Hubbard (ortho-atomic)
U Ni1-3d 0.0001
U Ni2-3d 0.0001
U O-2p 0.0001
